load semantics-basics/smt-conversion.maude
load semantics-basics/semantics-basics-narrowing.maude

*** Test transformer with while language module
***load language-semantics/while-semantics-concrete.maude
***set trace on .

*** Create views for SMT types
view Integer from TRIV to REAL-INTEGER is
  sort Elt to Integer .
endv
view Real from TRIV to REAL-INTEGER is
  sort Elt to Real .
endv
view Boolean from TRIV to REAL-INTEGER is
  sort Elt to Boolean .
endv

fmod PAIRSVAR is
    sorts PairSVar PairSVarL NePairSVarL .
    subsort PairSVar < NePairSVarL < PairSVarL .

    *** Definition of a list of symbolic variable-value pairs
    op nil : -> PairSVarL [ctor] .
    op __ : PairSVarL PairSVarL -> PairSVarL [ctor assoc id: nil prec 25] .
endfm

fmod SMT-CONNECTION is
    pr SMT-CONVERSION .
    pr PAIRSVAR .

    *** Import stores as map structures that map variables to SMT types
    ***protecting MAP{Qid, Integer} * (sort Map{Qid, Integer} to IStoreS) * (op _|->_ to _|->Is_ ) .
    ***protecting MAP{Qid, Real}    * (sort Map{Qid, Real} to RStoreS)    * (op _|->_ to _|->Rs_ ) .
    ***protecting MAP{Qid, Boolean} * (sort Map{Qid, Boolean} to BStoreS) * (op _|->_ to _|->Bs_ ) .

    sort AssignmentSMT .

    *** Define an satisfying assignment returned by the SMT hook
    op _<--_ : Real Real                 -> AssignmentSMT [ctor] .
    op _<--_ : Integer Integer           -> AssignmentSMT [ctor] .
    op _<--_ : Boolean Boolean           -> AssignmentSMT [ctor] .
    op _,_ : AssignmentSMT AssignmentSMT -> AssignmentSMT .
    op failed :                          -> AssignmentSMT [ctor] .

    *** Operator defined in Python using a hook
    *** Given a Boolean constraint returns a satisfying assignment to the symbolic variables it may contain
    op get-SMTassignment : Boolean -> AssignmentSMT [special (id-hook SpecialHubSymbol)] .

    *** Symbolic variable initialization pair
    op _,_ : Qid Integer -> PairSVar [ctor] .
    op _,_ : Qid Real    -> PairSVar [ctor] .
    op _,_ : Qid Boolean -> PairSVar [ctor] .
endfm

fmod NARROWING-FMOD is
    pr NARROWING-CONVERSION .
    pr PAIRSVAR .
    *** Import stores as map structures that map variables to FVP types
    ***protecting MAP{Qid, IntFVP}  * (sort Map{Qid, IntFVP}  to IStoreN) * (op _|->_ to _|->In_ ) .
    ***protecting MAP{Qid, BoolFVP} * (sort Map{Qid, BoolFVP} to BStoreN) * (op _|->_ to _|->Bn_ ) .

    *** Narrowing variable initialization pair
    op _,_ : Qid IntFVP  -> PairSVar [ctor] .
    op _,_ : Qid BoolFVP -> PairSVar [ctor] .
endfm

fmod SMT-AND-NARROWING is
    pr SMT-CONNECTION .
    pr NARROWING-FMOD .
endfm


fmod SEM-TR is
    pr STRING-OPS .
    pr SMT-AND-NARROWING .

    ***
    ***pr WHILE-MAUDE .
    ***op _{_} : State Boolean -> SEState [ctor] .
    ***op val : Integer -> IVal [ctor] .

    sorts TrType NonNrw .
    subsort NonNrw < TrType .
    
    *** Define the transformation types
    ops symb conc maudeSE : -> NonNrw [ctor] . ***clconc
    op narrowing : -> TrType [ctor] .

    vars InstId StateOp PrOp OpId ModId Q ValOp X Y EvalQ : Qid .
    vars Trm T1 T1' T2 T2' Tcond Tmod TSTR TIL Texp Tstate TScond : Term .
    vars Cond Cond1 Cond2                                 : Condition .
    vars EqC EqC2                                         : EqCondition .
    var  AttrSet                                          : AttrSet .
    var  RlSet                                            : RuleSet .
    var  Rule                                             : Rule .
    var  ImportList                                       : ImportList .
    var  SortSet                                          : SortSet .
    var  OpDeclSet                                        : OpDeclSet .
    var  OpDecl                                           : OpDecl .
    var  EquationSet                                      : EquationSet .
    var  TrId                                             : TrType .
    var  NonNrwTrId                                       : NonNrw .
    var  Eq                                               : Equation .
    vars  M M'                                            : Module .
    var  FM                                               : FModule .
    var  TL                                               : TypeList .
    var  NeTypeL                                          : NeTypeList .
    vars  T T'                                            : Type .
    var  Import                                           : Import .
    var  TermL                                            : TermList .
    vars NeTL NeTL'                                       : NeTermList .
    var  MVar                                             : Variable .
    var  MConst                                           : Constant .
    var  N                                                : Nat .
    var  Str                                              : String .
    var C : Constant .
    var V : Variable .

    *** Program variable generic definition
    op prVar : Qid -> Variable .
    eq prVar(PrOp) = qid("Pr:" + string(PrOp)) .

    *** State error constant generation
    op stateErrConst : Qid -> Constant .
    eq stateErrConst(StateOp) = qid("errS." + string(StateOp)) .

    *** State variable generic definition
    op stateVar : Qid -> Variable .
    eq stateVar(StateOp) = qid("State:" + string(StateOp)) .
    op stateVar : Qid Nat -> Variable .
    eq stateVar(StateOp, N) = qid("State" + string(N, 10) + ":" + string(StateOp)) .
    op stateVar : Qid String -> Variable .
    eq stateVar(StateOp, Str) = qid("State" + Str + ":" + string(StateOp)) .

    *** Symbolic state generic definition
    op symbState : Qid -> Term .
    eq symbState(StateOp) = '_`{_`}[stateVar(StateOp), 'Constraints:Boolean] .
    op symbState : Qid Nat -> Term .
    eq symbState(StateOp, N) = '_`{_`}[stateVar(StateOp, N), 'Constraints:Boolean] .

    *** Concolic state generic definition
    op concolicState : Qid -> Term .
    eq concolicState(StateOp) = '`[_`]`[_`]`[_`][stateVar(StateOp, 0), symbState(StateOp, 1), stateVar(StateOp, "SInit")] .
    op concolicState : Qid Term -> Term .
    eq concolicState(StateOp, T1) = '`[_`]`[_`]`[_`][T1, symbState(StateOp, 1), stateVar(StateOp, "SInit")] .

    *** Construct a symbolic mirror of a given a term. Transform all its Maude variables to use SMT types and stores, and change their name
    op symbMirror : Term -> Term .
    eq symbMirror(T1) = modStructTRec(T1, symb) .
    
    *** Construct a symbolic mirror of a given a term. Transform all its Maude variables to use SMT types and stores, and change their name
    ***op symbMirror : Term Qid RlSide -> Term .
    ***eq symbMirror(T1, RlSide) = modVal(modStructTRec(T1, symb), RlSide) .
    ***op nrwMirror : Term Qid RlSide -> Term .
    ***eq nrwMirror(T1, RlSide) = modVal(modStructTRec(T1, narrowing), RlSide) .

    *** Transform teh rules for a pure symbolic analysis without MaudeSE. For now, rule conditions must be of the form: eval(B, STR) = true
    *** The function symbMirror creates a symbolic mirror of the concrete state
    *** Conditional rules accumulate the condition of the rule in the state Constraints
    *** Every time a conditional rule is to be executed, the satisfiability of the new accumulated Constraints is checked
    op rlToSymbolic : RuleSet ~> RuleSet .
    eq rlToSymbolic(none) = none .
    eq rlToSymbolic(rl T1 => T2 [label(InstId) AttrSet] . RlSet) = 
          rl '_`{_`}[symbMirror(T1), 'Constraints:Boolean]
            => '_`{_`}[symbMirror(T2), 'Constraints:Boolean] 
            [label(toSymb(InstId)) AttrSet] .
          rlToSymbolic(RlSet) .
    ceq rlToSymbolic(crl T1 => T2 if Cond [label(InstId) AttrSet] . RlSet) = 
          crl '_`{_`}[symbMirror(T1), 'Constraints:Boolean]
            => '_`{_`}[symbMirror(T2), 'Constraints':Boolean]
            if 'Constraints':Boolean := '_and_['Constraints:Boolean, Tcond]
            /\ 'metaCheck[upTerm(upModule('REAL-INTEGER, false)), 'upTerm['Constraints':Boolean]] = 'true.Bool 
            [label(toSymb(InstId)) AttrSet] .
          rlToSymbolic(RlSet)
      if (Tcond = 'true.Boolean) := modCondRl(Cond, symb)  .
    eq rlToSymbolic(crl T1 => T2 if Cond [label(InstId) AttrSet] . RlSet) = 
          crl '_`{_`}[symbMirror(T1), 'Constraints:Boolean]
            => '_`{_`}[symbMirror(T2), 'Constraints:Boolean]
            if Cond
            [label(toSymb(InstId)) AttrSet] .
          rlToSymbolic(RlSet) [owise] .

    *** Transform the rules for a concolic analysis. For now, rule conditions must be of the form: eval(B, STR) = true
    *** The symbolic state advances naturally following the concrete state, executing the same instructions.
    *** The function symbMirror ensures the symbolic state is of the same form as the concrete state at each step, but using symbolic functions and stores
    op rlToConcolic : RuleSet Qid -> RuleSet .
    eq rlToConcolic(none, StateOp) = none .
    *** Transform unconditional rules
    eq rlToConcolic(rl T1 => T2 [AttrSet] . RlSet, StateOp) =
          (rl '`[_`]`[_`]`[_`][T1, '_`{_`}[symbMirror(T1), 'Constraints:Boolean], stateVar(StateOp)]
            =>
            '`[_`]`[_`]`[_`][T2, '_`{_`}[symbMirror(T2), 'Constraints:Boolean], stateVar(StateOp)]
            [AttrSet] .)
          rlToConcolic(RlSet, StateOp) .
    *** Transform conditional rules to two concolic rules
    *** - Conditional rule 1: Advances the state with the concrete condition Cond and appends Cond to the accumulated Constraints
    *** - Conditional rule 2: Appends not(Cond) to the accumulated Constraints and, if Constraints is satisfiable, re-starts the execution with the new Constraints
    ***                       Re-executing requires re-initializing the concrete store with new satisfying values retrieved from the SMT hook, and resetting the symbolic store

    *** TODO: Generalize again the conditions to handle composite ones (merge eval(...) and (not eval(...)) condition transformations)
    ceq rlToConcolic(crl T1 => T2 if Cond [label(InstId) AttrSet] . RlSet, StateOp) =
          (crl '`[_`]`[_`]`[_`][T1, '_`{_`}[symbMirror(T1), 'Constraints:Boolean], stateVar(StateOp)]
            =>
            '`[_`]`[_`]`[_`][T2, '_`{_`}[symbMirror(T2), 'Constraints':Boolean], stateVar(StateOp)]
            if Cond
            /\ 'Constraints':Boolean := '_and_['Constraints:Boolean, TScond]
            [label(InstId) AttrSet] .)
          (crl '`[_`]`[_`]`[_`][T1, '_`{_`}[symbMirror(T1), 'Constraints:Boolean], stateVar(StateOp)]
            =>
            '`[_`]`[_`]`[_`]['init-CState['upTerm[stateVar(StateOp)], 'Constraints':Boolean],
                                '_`{_`}[stateVar(StateOp), 'Constraints':Boolean],
                                stateVar(StateOp)]
            if Cond
            /\ 'Constraints':Boolean := '_and_['Constraints:Boolean, 'not_[TScond]]
            /\ 'metaCheck[upTerm(upModule('REAL-INTEGER, false)), 'upTerm['Constraints':Boolean]] = 'true.Bool
            [label(qid(string(InstId) + "-bis")) AttrSet] .)
          rlToConcolic(RlSet, StateOp)
        if (Tcond = 'true.Bool) := Cond
        /\ hasEval(Tcond)
        *** TODO: Generalize again the conditions to handle composite ones
        /\ Q[Texp, Tstate] := Tcond
        /\ TScond := modSEOpIds(Q)[Texp, symbMirror(T1)] .
    ceq rlToConcolic(crl T1 => T2 if Cond [label(InstId) AttrSet] . RlSet, StateOp) =
          (crl '`[_`]`[_`]`[_`][T1, '_`{_`}[symbMirror(T1), 'Constraints:Boolean], stateVar(StateOp)]
            =>
            '`[_`]`[_`]`[_`][T2, '_`{_`}[symbMirror(T2), 'Constraints':Boolean], stateVar(StateOp)]
            if Cond
            /\ 'Constraints':Boolean := '_and_['Constraints:Boolean, TScond]
            [label(InstId) AttrSet] .)
          (crl '`[_`]`[_`]`[_`][T1, '_`{_`}[symbMirror(T1), 'Constraints:Boolean], stateVar(StateOp)]
            =>
            '`[_`]`[_`]`[_`]['init-CState['upTerm[stateVar(StateOp)], 'Constraints':Boolean],
                                '_`{_`}[stateVar(StateOp), 'Constraints':Boolean],
                                stateVar(StateOp)]
            if Cond
            /\ 'Constraints':Boolean := '_and_['Constraints:Boolean, 'not_[TScond]]
            /\ 'metaCheck[upTerm(upModule('REAL-INTEGER, false)), 'upTerm['Constraints':Boolean]] = 'true.Bool
            [label(qid(string(InstId) + "-bis")) AttrSet] .)
          rlToConcolic(RlSet, StateOp)
        if (Tcond = 'true.Bool) := Cond
        /\ hasEval(Tcond)
        *** TODO: Generalize again the conditions to handle composite ones
        /\ 'not_[Q[Texp, Tstate]] := Tcond
        /\ TScond := 'not_[modSEOpIds(Q)[Texp, symbMirror(T1)]] .
        ***if ('not_[Q[Texp, Tstate]] = 'true.Bool) := downTerm(getTerm(metaReduce(upModule('TRANSFORMED-MOD, true), upTerm(getEvalCond(Cond)))), nil)
        ***/\ hasEval(Tcond)
        *** TODO: Generalize again the conditions to handle composite ones
        ***/\ 'not_[Q[Texp, Tstate]] := Tcond
        ***/\ TScond := 'not_[modSEOpIds(Q)[Texp, symbMirror(T1)]] .
    
    eq rlToConcolic(crl T1 => T2 if Cond [AttrSet] . RlSet, StateOp) = 
          (crl '`[_`]`[_`]`[_`][T1, '_`{_`}[symbMirror(T1), 'Constraints:Boolean], stateVar(StateOp)]
            =>
            '`[_`]`[_`]`[_`][T2, '_`{_`}[symbMirror(T2), 'Constraints:Boolean], stateVar(StateOp)]
            if Cond
            [AttrSet] .)
          rlToConcolic(RlSet, StateOp) [owise] .
    ***eq rlToConcolic(Rule RlSet, StateOp) = Rule rlToConcolic(RlSet, StateOp) [owise] .

    *** Transform the rules for an analysis with MaudeSE or narrowing
    *** - Transform the terms and conditions to use symbolic/FVP eval functions and symbolic/FVP stores
    op rlToSE : RuleSet TrType -> RuleSet .
    eq rlToSE(none, TrId) = none .
    eq rlToSE(rl T1 => T2 [label(InstId) AttrSet] . RlSet, TrId) = (rl modStructTRec(T1, TrId) => modStructTRec(T2, TrId) 
                                                                      [label(toSymb(InstId)) AttrSet] .)
                                                                    rlToSE(RlSet, TrId) .
    eq rlToSE(crl T1 => T2 if Cond [label(InstId) AttrSet] . RlSet, TrId) = (crl modStructTRec(T1, TrId) => modStructTRec(T2, TrId) 
                                                                              if modCondRl(Cond, TrId) 
                                                                              [label(toSymb(InstId)) AttrSet] .)
                                                                            rlToSE(RlSet, TrId) .
    eq rlToSE(Rule RlSet, TrId) = Rule rlToSE(RlSet, TrId) [owise] .

    *** FIXME: Is it enough with rule ordering to match first 'not_[Trm], than just Trm
    *** TODO: Recover and FIX this. It generalizes conditions. The problem is it generates two first-step matching rules, it should only generate ONE 1 with eval extension
    *** op rlToNarrowing : RuleSet Qid -> RuleSet .
    *** eq rlToNarrowing(none) = none .
    *** eq rlToNarrowing(rl T1 => T2 [AttrSet] . RlSet) = rlToSE(rl T1 => T2 [AttrSet narrowing] ., narrowing) rlToNarrowing(RlSet) .
    *** *** Case not eval ... = true
    *** ceq rlToNarrowing(crl T1 => T2 if Cond [label(InstId) AttrSet] . RlSet) =
    ***                   (rl modStructTRec(T1, narrowing) => extNrwSt(modStructTRec(T1, narrowing), 'not_[Tcond]) [narrowing AttrSet] .)
    ***                   (rl extNrwSt(modStructTRec(T1, narrowing), trBool('false.Bool)) => modStructTRec(T2, narrowing) [label(toSymb(InstId)) narrowing AttrSet] .)
    ***                 rlToNarrowing(RlSet)
    ***   if ('not_[Trm] = 'true.Bool) := getEvalCond(Cond)
    ***   /\ (Cond1 /\ ('not_[Tcond] = 'tt.BoolFVP) /\ Cond2) := modCondRl(Cond, narrowing) .
    *** *** Case eval ... = true
    *** ceq rlToNarrowing(crl T1 => T2 if Cond [label(InstId) AttrSet] . RlSet) =
    ***                   (rl modStructTRec(T1, narrowing) => extNrwSt(modStructTRec(T1, narrowing), Tcond) [narrowing AttrSet] .)
    ***                   (rl extNrwSt(modStructTRec(T1, narrowing), trBool('true.Bool)) => modStructTRec(T2, narrowing) [label(toSymb(InstId)) narrowing AttrSet] .)
    ***                 rlToNarrowing(RlSet)
    ***   if (Trm = 'true.Bool) := getEvalCond(Cond)
    *** *** TODO: We cannot have conditional narrowing rules!!!! Even matching rules are prohibited!!
    ***   /\ (Cond1 /\ (Tcond = 'tt.BoolFVP) /\ Cond2) := modCondRl(Cond, narrowing) .
    *** ***eq rlToNarrowing(crl T1 => T2 if 'not_['cbeval[NeTL:NeTermList]] = 'true.Bool [AttrSet] . RlSet) = rlToNarrowing(crl T1 => T2 if ('cbeval[NeTL:NeTermList] = 'false.Bool) [AttrSet] . RlSet) .
    *** eq rlToNarrowing(Rule RlSet) = Rule rlToNarrowing(RlSet) [owise] .

    *** Rules are divided into 2 phases: 1. extend the state with evaluation, 2. execute rule with result of evaluation
    *** Conditional rules which do not have an eval function, are also transformed to be considered on narrowing executions.
    *** This approach leads to unnecesary paths, where rules that should not be executable, can have their first part executed because the condition is delayed to the second phase.
    op rlToNarrowing : RuleSet -> RuleSet .
    eq rlToNarrowing(none) = none .
    eq rlToNarrowing(rl T1 => T2 [AttrSet] . RlSet) = rlToSE(rl T1 => T2 [AttrSet narrowing] ., narrowing) rlToNarrowing(RlSet) .
    eq rlToNarrowing(crl T1 => T2 if ('cbeval[NeTL:NeTermList] = 'true.Bool) [label(InstId) AttrSet] . RlSet) =
                      (rl modStructTRec(T1, narrowing) => extNrwSt(modStructTRec(T1, narrowing), modStructTRec('cbeval[NeTL:NeTermList], narrowing)) [narrowing AttrSet] .)
                      (rl extNrwSt(modStructTRec(T1, narrowing), trBool('true.Bool)) => modStructTRec(T2, narrowing) [label(toSymb(InstId)) narrowing AttrSet] .)
                    rlToNarrowing(RlSet) .
    eq rlToNarrowing(crl T1 => T2 if ('cbeval[NeTL:NeTermList] = 'false.Bool) [label(InstId) AttrSet] . RlSet) =
                      (rl modStructTRec(T1, narrowing) => extNrwSt(modStructTRec(T1, narrowing), modStructTRec('cbeval[NeTL:NeTermList], narrowing)) [narrowing AttrSet] .)
                      (rl extNrwSt(modStructTRec(T1, narrowing), trBool('false.Bool)) => modStructTRec(T2, narrowing) [label(toSymb(InstId)) narrowing AttrSet] .)
                    rlToNarrowing(RlSet) .
    eq rlToNarrowing(crl T1 => T2 if 'not_['cbeval[NeTL:NeTermList]] = 'true.Bool [AttrSet] . RlSet) = rlToNarrowing(crl T1 => T2 if ('cbeval[NeTL:NeTermList] = 'false.Bool) [AttrSet] . RlSet) .
    *** Use non eval conditions in narrowing???
    ceq rlToNarrowing(crl T1 => T2 if (Tcond = 'true.Bool) [label(InstId) AttrSet] . RlSet) =
                      (rl modStructTRec(T1, narrowing) => extNrwSt(modStructTRec(T1, narrowing), Tcond) [narrowing AttrSet] .)
                      (rl extNrwSt(modStructTRec(T1, narrowing), 'true.Bool) => modStructTRec(T2, narrowing) [label(toSymb(InstId)) narrowing AttrSet] .)
                    rlToNarrowing(RlSet)
      if not hasEval(Tcond) .
    eq rlToNarrowing(Rule RlSet) = Rule rlToNarrowing(RlSet) [owise] .

    op getEvalCond : EqCondition -> Condition .
    eq getEvalCond(nil) = nil .
    ceq getEvalCond(T1 = T2) = T1 = T2 if hasEval(T1) or hasEval(T2) .
    eq getEvalCond(T1 := T2) = nil .
    ceq getEvalCond(T1 = T2 /\ Cond2) = getEvalCond(T1 = T2) /\ getEvalCond(Cond2)
      if not isNil?(Cond2) [owise] .
    ceq getEvalCond(T1 := T2 /\ Cond2) = getEvalCond(T1 := T2) /\ getEvalCond(Cond2)
      if not isNil?(Cond2) [owise] .
    eq getEvalCond(T1 = T2) = nil [owise] .

    op isNil? : EqCondition -> Bool .
    eq isNil?(nil) = true .
    eq isNil?(T1 = T2) = false .
    eq isNil?(T1 := T2) = false .
    eq isNil?(Cond1 /\ Cond2) = false [owise] .

    ***op rlToClConcolic : RuleSet Qid -> RuleSet .
    ***eq rlToClConcolic(none, StateOp) = none .
    ***eq rlToClConcolic(rl T1 => T2 [AttrSet] . RlSet, StateOp) = rlToConcolic(rl T1 => T2 [AttrSet] . RlSet, StateOp)
    ***                                                               rlToClConcolic(RlSet, StateOp) .
    ***ceq rlToClConcolic(crl T1 => T2 if Cond [label(InstId) AttrSet] . RlSet, StateOp) = (crl '`[_`]`[_`]`[_`]`[_`][T1, '_`{_`}[stateVar(StateOp), 'Constraints:Boolean], 'STRInit:Stores]
    ***                                                                                      =>
    ***                                                                                      '`[_`]`[_`]`[_`]`[_`][T2, '_`{_`}[stateVar(StateOp), 'Constraints':Boolean], 'STRInit:Stores]
    ***                                                                                      if 'Constraints':Boolean := '_and_['Constraints:Boolean, subT(Tcond, 'STR:Stores, 'getStore[stateVar(StateOp)])]
    ***                                                                                      /\ 'metaCheck[upTerm(upModule('REAL-INTEGER, false)), 'upTerm[Tcond]] = 'true.Bool
    ***                                                                                      [label(InstId) AttrSet] .)
    ***                                                                                      rlToConcolic(RlSet, StateOp)
    ***    if (Tcond = 'true.Boolean) := Cond .
    
    ***op inclClConcCrl : Qid -> RuleSet .
    ***eq inclClConcCrl(StateOp) = (crl '`[_`]`[_`]`[_`]`[_`][T1, '_`{_`}[stateVar(StateOp), 'Constraints:Boolean], 'STRInit:Stores]
    ***                                =>
    ***                                '`[_`]`[_`]`[_`]`[_`][subT('updateProgram[T2, 'getProgram[stateVar(StateOp)]], 'STR:Stores, 'init-CStore['STRInit:Stores, 'Constraints':Boolean]),
    ***                                                            '_`{_`}['updateStore[stateVar(StateOp), 'STRInit:Stores], 'Constraints':Boolean], '_+_['N:Nat, 's_['0.Nat]], 'STRInit:Stores]
    ***                                if 'metaCheck[upTerm(upModule('REAL-INTEGER, false)), 'upTerm['Constraints:Boolean]] = 'true.Bool
    ***                                [label(qid("re-exec")) AttrSet] .)

    ***op modSEImports : ImportList -> ImportList .
    ***eq modSEImports(ImportList) = ImportList .
    ***eq modSEImports(nil) = nil .
    ***eq modSEImports((protecting 'MAP{X, Y} .) ImportList) = (protecting 'MAP{X, Y} .) 
    ***                                                        (protecting 'MAP{X, toSMTSorts(Y)} .) 
    ***                                                        modSEImports(ImportList) .
    ***eq modSEImports(Import ImportList) = Import modSEImports(ImportList) [owise] .

    ***op inclSEImports : ImportList -> ImportList .
    ***eq inclSEImports(ImportList) = ImportList . ***modSEImports(ImportList)
                                   ***(protecting 'MAP{'Var, 'Integer} * (sort 'Map`{'Var`,'Integer`} to 'IStoreS) * (op '_|->_ to '_|->Is_ [ctor]) .)
                                   ***(protecting 'MAP{'Var, 'Real} * (sort 'Map`{'Var`,'Real`} to 'RStoreS) * (op '_|->_ to '_|->Rs_ [ctor]) .)
                                   ***(protecting 'MAP{'Var, 'Boolean} * (sort 'Map`{'Var`,'Boolean`} to 'BStoreS) * (op '_|->_ to '_|->Bs_ [ctor]) .)
                                   ***(protecting 'REAL-INTEGER .)
                                   ***(protecting 'META-LEVEL .)
                                   ***(protecting 'SMT-CONNECTION .)
                                   ***(protecting 'SE-LOCS-MOD .)
                                   ***(protecting 'LIST{'Location} * (sort 'List`{Location`} to 'Path) .)
                                   ***(protecting 'LIST{'PairVarValue} .)
                                   ***(protecting 'LIST{'Inst} * (sort 'List`{Inst`} to 'Program) .)

    *** Include new sorts for symbolic/concolic execution states
    op inclSESorts : SortSet -> SortSet .
    eq inclSESorts(SortSet) = SortSet ; 'SEState ; 'ConstrainedStart ; 'ConcolicState .

    op trSorts : TypeList TrType -> TypeList .
    eq trSorts(TL, narrowing) = toNRWSorts(TL) .
    eq trSorts(TL, TrId) = toSMTSorts(TL) [owise] .

    *** Transform a list of Maude types to their symbolic representation
    op toSMTSorts : TypeList -> TypeList .
    eq toSMTSorts(nil)        = nil .
    eq toSMTSorts('Bool TL)   = 'Boolean toSMTSorts(TL) .
    eq toSMTSorts('Int TL)    = 'Integer toSMTSorts(TL) .
    eq toSMTSorts('Rat TL)    = 'Real toSMTSorts(TL) .
    eq toSMTSorts('Zero TL)   = 'Integer toSMTSorts(TL) .
    ***eq toSMTSorts('IStore TL) = 'IStoreS toSMTSorts(TL) .
    ***eq toSMTSorts('RStore TL) = 'RStoreS toSMTSorts(TL) .
    ***eq toSMTSorts('BStore TL) = 'BStoreS toSMTSorts(TL) .
    eq toSMTSorts(T TL) = T toSMTSorts(TL) [owise] .

    *** TODO: Maybe fuse with toSMTSorts and dissambiguate with TypeTr annotation at the level
    *** Transform a list of Maude types to their narrowing representation
    op toNRWSorts : TypeList -> TypeList .
    eq toNRWSorts(nil)        = nil .
    --- eq toNRWSorts('Bool TL)   = 'BoolFVP toNRWSorts(TL) .
    --- eq toNRWSorts('Int TL)    = 'IntFVP toNRWSorts(TL) .
    --- eq toNRWSorts('Zero TL)   = 'IntFVP toNRWSorts(TL) .
    *** TODO: Remove
    ***eq toNRWSorts('BitV TL)   = 'BitVFVP toNRWSorts(TL) .
    ***eq toNRWSorts('IStore TL) = 'IStoreN toNRWSorts(TL) .
    ***eq toNRWSorts('BStore TL) = 'BStoreN toNRWSorts(TL) .
    eq toNRWSorts(T TL) = T toNRWSorts(TL) [owise] .

    *** Append an "S" to an input Qid to represent its symbolic representation
    op toSymb : Qid -> Qid .
    eq toSymb(OpId) = qid(string(OpId) + "S") .

    op toNrw : Qid -> Qid .
    eq toNrw(Q) = qid(string(Q) + "FVP") .

    *** Extend states using the modified state constructor for narrowing.
    *** If the term is a constant or a variable, leave it as is
    op extNrwSt : Qid -> Qid .
    op extNrwSt : Term Term -> Term .
    eq extNrwSt(Q) = qid(string(Q) + "[_]") .
    eq extNrwSt(OpId[NeTL], T2) = extNrwSt(OpId)[NeTL, T2] .
    eq extNrwSt(T1, T2) = T1 [owise] .

    *** Transform an operator signature to use SMT types
    op trOps : OpDecl TrType -> OpDecl .
    eq trOps((op Q : TL -> T [AttrSet] .), TrId) = (op Q : trSorts(TL, TrId) -> trSorts(T, TrId) [AttrSet] .) .

    *** The transformation for symbolic execution transforms the eval functions and the semantic value wrapper to use SMT types and changes the function names
    op modOpSigSE : OpDeclSet Qid TrType -> OpDeclSet .
    eq modOpSigSE(none, StateOp, TrId) = none .
    *** NOTE: ValOp represents a wrapper for a semantically-relevant value, not syntax 'val
    eq modOpSigSE((op Q : NeTypeL -> StateOp [ctor AttrSet] .) OpDeclSet, StateOp, narrowing) = (op Q : NeTypeL -> StateOp [ctor AttrSet] .)
                                                                                                        (op extNrwSt(Q) : NeTypeL 'BoolFVP -> StateOp [ctor AttrSet] .)
                                                                                                        (op extNrwSt(Q) : NeTypeL 'Bool -> StateOp [ctor AttrSet] .)
                                                                                                        modOpSigSE(OpDeclSet, StateOp, narrowing) . 
    ***eq modOpSigSE((op ValOp : TL -> T [AttrSet] .) OpDeclSet, StateOp, TrId)   = trOps(op ValOp : TL -> T [AttrSet] ., TrId)
    ***                                                                            modOpSigSE(OpDeclSet, StateOp, TrId) . 
    eq modOpSigSE((op 'val : T -> T' [ctor AttrSet] .) OpDeclSet, StateOp, TrId) = (op 'val : trSorts(T, TrId) -> T' [ctor AttrSet] .)
                                                                                              ***(op extNrwSt(Q) : NeTypeL 'BoolFVP -> StateOp [ctor AttrSet] .)
                                                                                              modOpSigSE(OpDeclSet, StateOp, TrId) . 
    ***eq modOpSigSE((op 'eval : TL -> T [AttrSet] .) OpDeclSet, StateOp, TrId)   = trOps(op toSymb('eval) : TL -> T [AttrSet] ., TrId)
    ***                                                                            modOpSigSE(OpDeclSet, StateOp, TrId) . 
    eq modOpSigSE((op Q : TL -> T [metadata("evalF") AttrSet] .) OpDeclSet, StateOp, TrId)  = trOps(op modSEOpIds(Q) : TL -> T [metadata("evalF") AttrSet] ., TrId)
                                                                                modOpSigSE(OpDeclSet, StateOp, TrId) . 
    ***eq modOpSigSE((op 'creval : TL -> T [AttrSet] .) OpDeclSet, StateOp, TrId)  = trOps(op modSEOpIds('creval) : TL -> T [AttrSet] ., TrId)
    ***                                                                            modOpSigSE(OpDeclSet, StateOp, TrId) . 
    ***eq modOpSigSE((op 'cbeval : TL -> T [AttrSet] .) OpDeclSet, StateOp, TrId)  = trOps(op modSEOpIds('cbeval) : TL -> T [AttrSet] ., TrId)
    ***                                                                            modOpSigSE(OpDeclSet, StateOp, TrId) .
    eq modOpSigSE(OpDecl OpDeclSet, StateOp, TrId) = OpDecl modOpSigSE(OpDeclSet, StateOp, TrId) [owise] .

    *** The transformation for concolic execution duplicates the operator declarations and 
    *** transforms one of the copies to use symbolic evaluation functions and symbolic semantic value wrapper (using the symbolic execution transformation)
    op modOpSigConc : OpDeclSet Qid TrType -> OpDeclSet .
    eq modOpSigConc(OpDeclSet, StateOp, TrId) = OpDeclSet modOpSigSE(OpDeclSet, StateOp, TrId) .

    *** Include constructors symbolic/concolic state constructors depending on original state and functional operators
    op inclSEOps : Qid -> OpDeclSet .
    eq inclSEOps(StateOp) = *** Constructor for symbolic state, appends the accumulated constraints to the original state 
                            (op '_`{_`} : StateOp 'Boolean -> 'SEState [ctor] .)
                            *** Define state with initial constraints
                            (op '_where_ : StateOp 'Boolean -> 'ConstrainedStart [ctor] .)
                            *** Define the concolic dual state core constructor and its extension to keep track of initial programs
                            (op '`[_`]`[_`]`[_`] : StateOp 'SEState StateOp -> 'ConcolicState [ctor] .)
                            *** TODO: This should not "contain" a State, it should "extend" it (at the same term level)
                            ***   - Do it at modOp level
                            *** (op '_`[_`] : StateOp 'BoolFVP -> StateOp [ctor] .)                            
                            *** Construct the symbolic Stores structure with the three symbolic stores
                            ***(op '_|_|_ : 'IStoreS 'RStoreS 'BStoreS -> 'Stores [ctor] .)
                            ***(op '_|_ : 'IStoreS 'BStoreS -> 'Stores [ctor] .)
                            *** Construct the FVP-typed store Stores structure for narrowing
                            ***(op '_|_ : 'IStoreN 'BStoreN -> 'Stores [ctor] .)
                            *** Initialize the input concrete stores with the symbolic stores and
                            *** values satisfying Boolean constrains retrieved from the SMT hook 
                            (op 'init-CState : 'Term 'Boolean -> StateOp [none] .)
                            ***(op 'init-CState : Term Term 'Boolean -> StateOp [none] .)
                            *** Only insert if var is not already assigned
                            ***(op 'insertFirst : 'Qid 'Int  'IStore -> 'IStore [none] .)
                            ***(op 'insertFirst : 'Qid 'Rat  'RStore -> 'RStore [none] .)
                            ***(op 'insertFirst : 'Qid 'Bool 'BStore -> 'BStore [none] .)
                            *** Apply a symbolic assignment retrieved from the SMT hook to a concrete store.
                            *** The symbolic store is used to match the assigned variable. 
                            (op '$apply-SMTassignment : 'Term 'AssignmentSMT -> 'Term [none] .)
                            ***(op '$apply-SMTassignment : Term Term 'AssignmentSMT -> StateOp [none] .)
                            *** Initialize a concrete store with default values from a symbolic store
                            (op 'initialize-def : 'Term -> 'Term [none] .)
                            (op 'initialize-def : 'TermList -> 'TermList [none] .)
                            (op 'get-def : 'Variable 'Sort -> 'Constant [none] .)
                            *** Substitute a term t2 by t1 in t0
                            (op 'subT : 'TermList 'Term 'Term -> 'Term [none] .)
                            (op 'errS : nil -> StateOp [ctor] .)
                            ***(op 'size : 'Boolean -> 'Nat [none] .)
                            *** Create a concolic dual state with the concrete and symbolic state objects, and the symbolic variable-value pairs
                            (op 'startC : StateOp 'PairSVarL -> 'ConcolicState [none] .)
                            *** Create a concolic dual state with initial constraints
                            (op 'startC : 'ConstrainedStart 'PairSVarL -> 'ConcolicState [none] .)
                            *** Initialize the concolic state
                            (op '$startC : StateOp 'PairSVarL 'Stores 'Boolean -> 'ConcolicState [none] .)
                            *** Create a symbolic state for MaudeSE or narrowing execution
                            (op 'startSE : StateOp 'PairSVarL 'Stores -> StateOp [none] .)
                            *** Direct symbolic transformation state
                            (op 'startSED : StateOp 'PairSVarL 'Stores 'Boolean -> 'SEState [none] .) .

    *** Transform operator declarations depending on the transformation type
    op modSEOps : OpDeclSet Qid TrType -> OpDeclSet .
    eq modSEOps(OpDeclSet, StateOp, conc) = modOpSigConc(OpDeclSet, StateOp, conc)
                                                   inclSEOps(StateOp) .
    *** NOTE: modified to keep concrete definitions when added narrowing to maintain old unchanged definitions
    eq modSEOps(OpDeclSet, StateOp, TrId) = modOpSigConc(OpDeclSet, StateOp, TrId)
                                                   inclSEOps(StateOp) [owise] .

    *** Transform operator ids to their symbolic representation
    op modSEOpIds : Qid -> Qid .
    eq modSEOpIds('_==_)  = '_===_ .
    eq modSEOpIds('_=/=_) = '_=/==_ . 
    eq modSEOpIds('_quo_) = '_div_ . 
    eq modSEOpIds('rat)   = 'toReal . 
    ***eq modSEOpIds('eval)  = toSymb('eval) .
    --- eq modSEOpIds('cieval) = 'sieval .
    --- eq modSEOpIds('creval) = 'sreval .
    --- eq modSEOpIds('cbeval) = 'sbeval .
    eq modSEOpIds(Q) = Q [owise] .

    *** Transform a variable to use SMT type and use a new symbolic name
    op subSEVarSorts : Variable Qid TrType -> Variable .
    --- eq subSEVarSorts(V, 'Int, TrId) = qid(string(getName(V)) + ":" + string(trSorts('Int, TrId))) .
    --- eq subSEVarSorts(V, 'Zero, TrId) = qid(string(getName(V)) + ":" + string(trSorts('Int, TrId))) .
    eq subSEVarSorts(V, 'Rat, TrId) = qid(string(getName(V)) + ":" + string(trSorts('Rat, TrId))) .
    --- eq subSEVarSorts(V, 'Bool, TrId) = qid(string(getName(V)) + ":" + string(trSorts('Bool, TrId))) .
    eq subSEVarSorts(V, Q, TrId) = V [owise] .

    *** Transform a constant's type to SMT
    op subSEConstSortsT : Constant Type TrType -> Constant .
    --- eq subSEConstSortsT(C, 'Int, TrId) = qid(string(getName(C)) + "." + string(trSorts('Int, TrId))) .
    --- eq subSEConstSortsT(C, 'Zero, TrId) = qid(string(getName(C)) + "." + string(trSorts('Int, TrId))) .
    eq subSEConstSortsT(C, 'Rat, TrId) = qid(string(getName(C)) + "." + string(trSorts('Rat, TrId))) .
    eq subSEConstSortsT(C, 'Bool, NonNrwTrId) = qid(string(getName(C)) + "." + string(trSorts('Bool, NonNrwTrId))) .
    eq subSEConstSortsT(C, 'Bool, narrowing) = trBool(C) .
    eq subSEConstSortsT(C, Q, TrId) = C [owise] .

    *** Substitute all variables and constants in a TermList with the corresponding term with SMT types
    op trVal : TermList TrType -> TermList .
    eq trVal(empty, TrId)           = empty .
    eq trVal(MConst, TrId)          = subSEConstSortsT(MConst, getType(MConst), TrId) .
    eq trVal(MVar, TrId)            = subSEVarSorts(MVar, getType(MVar), TrId) .
    ***eq trVal('val[T1], TrId)        = 'val[T1] .
    --- eq trVal('val['I:Int], TrId)    = 'val[convert('I:Int, 'Int, TrId)] .
    --- eq trVal('val['R:Rat], TrId)    = 'val[convert('R:Rat, 'Rat, TrId)] .
    ***eq trVal('val['_/_[T, T']], TrId)    = 'val[convert('_/_[T, T'])] .
    --- eq trVal('val['B:Bool], TrId)   = 'val[convert('B:Bool, 'Bool, TrId)] .
    eq trVal('s_['0.Zero], NonNrwTrId)    = '1.Integer .
    eq trVal('s_['0.Zero], narrowing)    = '1.IntFVP .
    ceq trVal(Q['0.Zero], TrId)     = qid(string(rat(substr(Str, 3, sd(length(Str), 3)), 10), 10) + ".Integer")
      if Str := string(Q)
      /\ substr(Str, 0, 3) = "s_^" .
    eq trVal('_*_[NeTL], narrowing) = '_*_[NeTL] .
    eq trVal('_/_[NeTL], narrowing) = '_/_[NeTL] .
    eq trVal(OpId[NeTL], TrId)      = modSEOpIds(OpId)[trVal(NeTL, TrId)] [owise] .
    eq trVal((T1, NeTL), TrId)      = trVal(T1, TrId), trVal(NeTL, TrId) .

    op convert : Constant Type TrType -> Constant .
    eq convert(MConst, T, narrowing) = convertNarrowing(MConst, T) .
    eq convert(MConst, T, TrId) = convertSMT(MConst, T) [owise] .

    op convert : Variable Type TrType -> Variable .
    eq convert(MVar, T, narrowing) = convertNarrowing(MVar, T) .
    eq convert(MVar, T, TrId) = convertSMT(MVar, T) [owise] .

    *** Convert constant with Maude type to the corresponding SMT type
    op convertSMT : Constant Type -> Constant .
    eq convertSMT(MConst, 'Zero)  = 'toInteger[MConst] .
    eq convertSMT(MConst, 'Int)  = 'toInteger[MConst] .
    eq convertSMT(MConst, 'Rat)  = 'toReal[MConst] .
    eq convertSMT(MConst, 'Bool) = 'toBoolean[MConst] .
    eq convertSMT(MConst, T) = MConst [owise] .
    
    *** Convert variable with Maude type to the corresponding SMT type
    op convertSMT : Variable Type -> Variable .
    eq convertSMT(MVar, 'Zero)  = 'toInteger[MVar] .
    eq convertSMT(MVar, 'Int)  = 'toInteger[MVar] .
    eq convertSMT(MVar, 'Rat)  = 'toReal[MVar] .
    eq convertSMT(MVar, 'Bool) = 'toBoolean[MVar] .
    eq convertSMT(MVar, T) = MVar [owise] .

    op convertNarrowing : Constant Type -> Constant .
    --- eq convertNarrowing(MConst, 'Zero)  = 'toIntFVP[MConst] .
    --- eq convertNarrowing(MConst, 'Int)  = 'toIntFVP[MConst] .
    --- eq convertNarrowing(MConst, 'Bool) = 'toBoolFVP[MConst] .
    eq convertNarrowing(MConst, T) = MConst [owise] .

    op convertNarrowing : Variable Type -> Variable .
    --- eq convertNarrowing(MVar, 'Zero)  = 'toIntFVP[MVar] .
    --- eq convertNarrowing(MVar, 'Int)  = 'toIntFVP[MVar] .
    --- eq convertNarrowing(MVar, 'Bool) = 'toBoolFVP[MVar] .
    eq convertNarrowing(MVar, T) = MVar [owise] .

    op trInsideVal : TermList TrType -> TermList .
    eq trInsideVal(empty, TrId)           = empty .
    eq trInsideVal(MConst, TrId)          = subSEConstSortsT(MConst, getType(MConst), TrId) .
    eq trInsideVal(MVar, TrId)            = subSEVarSorts(MVar, getType(MVar), TrId) .
    ***eq trVal('val[T1], TrId)        = 'val[T1] .
    eq trInsideVal('val[NeTL], TrId)      = 'val[trVal(NeTL, TrId)] .
    eq trInsideVal(OpId[NeTL], TrId)      = OpId[trInsideVal(NeTL, TrId)] [owise] .
    eq trInsideVal((T1, NeTL), TrId)      = trInsideVal(T1, TrId), trInsideVal(NeTL, TrId) .

    *** Recursively transform terms to use symbolic stores and convert constants to SMT values
    ***op subSETermSTR : Term TrType -> Term .
    ***eq subSETermSTR(MConst, TrId)          = convert(MConst, getType(MConst), TrId) .
    ***eq subSETermSTR(MVar, TrId)            = subSEVarSorts(MVar, getType(MVar), TrId) .
    ***eq subSETermSTR('val[T1], TrId)        = 'val[T1] .
    ***eq subSETermSTR('s_['0.Zero], TrId)    = '1.Integer .
    ***ceq subSETermSTR(Q['0.Zero], TrId)     = qid(string(rat(substr(Str, 3, sd(length(Str), 3)), 10), 10) + ".Integer")
    ***  if Str := string(Q)
    ***  /\ substr(Str, 0, 3) = "s_^" .
    ***eq subSETermSTR('_*_[NeTL], narrowing) = '_*_[NeTL] .
    ***eq subSETermSTR(OpId[NeTL], TrId)      = modSEOpIds(OpId)[modStructTRec(NeTL, TrId)] [owise] .

    ***op modStoreT : Constant Type Qid TrType -> Term .
    ***op modStoreT : Variable Type Qid TrType -> Term .
    op modStructT : Term Qid TrType -> Term .
    op modStructT : Term TrType -> Term .
    ***eq modStoreT(MConst, 'Stores, TrId) = subSEConstSortsT(MConst, 'Stores, TrId) .
    ***eq modStoreT(MConst, 'IStore, TrId) = subSEConstSortsT(MConst, 'IStore, TrId) .
    ***eq modStoreT(MConst, 'RStore, TrId) = subSEConstSortsT(MConst, 'RStore, TrId) .
    ***eq modStoreT(MConst, 'BStore, TrId) = subSEConstSortsT(MConst, 'BStore, TrId) .
    ***eq modStoreT(MConst, T, TrId) = MConst [owise] .
    ***eq modStoreT(MVar, 'Stores, TrId)   = subSEVarSorts(MVar, 'Stores, TrId) .
    ***eq modStoreT(MVar, 'IStore, TrId)   = subSEVarSorts(MVar, 'IStore, TrId) .
    ***eq modStoreT(MVar, 'RStore, TrId)   = subSEVarSorts(MVar, 'RStore, TrId) .
    ***eq modStoreT(MVar, 'BStore, TrId)   = subSEVarSorts(MVar, 'BStore, TrId) .
    ***eq modStoreT(MVar, T, TrId) = MVar [owise] .
    ***eq modStoreT(MConst, TrId)                = modStoreT(MConst, getType(MConst), TrId) .
    ***eq modStoreT(MVar, TrId)                  = modStoreT(MVar, getType(MVar), TrId) .
    ***eq modStoreT('_|->I_[T1, T2], TrId)       = toSymb('_|->I_)[T1, trVal(T2, TrId)] .
    ***eq modStoreT('_|->R_[T1, T2], TrId)       = toSymb('_|->R_)[T1, trVal(T2, TrId)] .
    ***eq modStoreT('_|->B_[T1, T2], TrId)       = toSymb('_|->B_)[T1, trVal(T2, TrId)] .
    ***eq modStoreT('_`,_[T1, T2], TrId)         = '_`,_[modStoreT(T1, TrId), modStoreT(T2, TrId)] .
    ***eq modStoreT('insert[T1, MConst, TSTR], TrId)     = 'insert[T1, convert(MConst, getType(MConst), TrId), modStoreT(TSTR, TrId)] .
    ***eq modStoreT('insert[T1, MVar, TSTR], TrId)       = 'insert[T1, convert(MVar, getType(MVar), TrId), modStoreT(TSTR, TrId)] .
    *** TODO: getType(...) should be of T1?, reconsider whether this eqs are needed
    ***eq modStoreT('_==_[T1, MConst], TrId)             = modSEOpIds('_==_)[modStructT(T1, getType(MConst), TrId), trVal(MConst, TrId)] .
    ***eq modStoreT('_==_[T1, MVar], TrId)               = modSEOpIds('_==_)[modStructT(T1, getType(MVar), TrId), trVal(MVar, TrId)] .
    ***eq modStoreT('_=/=_[T1, MConst], TrId)            = modSEOpIds('_=/=_)[modStructT(T1, getType(MConst), TrId), trVal(MConst, TrId)] .
    ***eq modStoreT('_=/=_[T1, MVar], TrId)              = modSEOpIds('_=/=_)[modStructT(T1, getType(MVar), TrId), trVal(MVar, TrId)] .
    eq modStructT('_==_[T1, MConst], TrId)               = modSEOpIds('_==_)[modStructT(T1, getType(MConst), TrId), trVal(MConst, TrId)] .
    eq modStructT('_==_[T1, MVar], TrId)                 = modSEOpIds('_==_)[modStructT(T1, getType(MVar), TrId), trVal(MVar, TrId)] .
    eq modStructT('_=/=_[T1, MConst], TrId)              = modSEOpIds('_=/=_)[modStructT(T1, getType(MConst), TrId), trVal(MConst, TrId)] .
    eq modStructT('_=/=_[T1, MVar], TrId)                = modSEOpIds('_=/=_)[modStructT(T1, getType(MVar), TrId), trVal(MVar, TrId)] .
    *** FIXME: This should be changed (it is temporary). Find a way of keeping _==_
    eq modStructT('_==_[T1, T2], TrId)                   = '_==_[modStructT(T1, TrId), modStructT(T2, TrId)] [owise] .
    eq modStructT('_=/=_[T1, T2], TrId)                  = '_==_[modStructT(T1, TrId), modStructT(T2, TrId)] [owise] .
    *** TODO: Check how to handle this (the user may want to evaluate it concretely or symbolically? Only concretely?)
    ***eq modStructT('if_then_else_fi[Trm, T1, T2], TrId)   = 'if_then_else_fi['metaCheck[upTerm(upModule('REAL-INTEGER, false)), modStructT(Trm, TrId)], modStructT(T1, TrId), modStructT(T2, TrId)] .
    eq modStructT('if_then_else_fi[Trm, T1, T2], TrId)   = 'if_then_else_fi[Trm, modStructT(T1, TrId), modStructT(T2, TrId)] .
    ***eq modStoreT(ValOp[T1], Q, TrId)                     = ValOp[trVal(T1, TrId)] .
    ***eq modStoreT(ValOp[MConst], Q, TrId)                 = ValOp[convert(MConst, getType(MConst), TrId)] .
    ***eq modStoreT(ValOp[MVar], Q, TrId)                   = ValOp[convert(MVar, getType(MVar), TrId)] .
    ***eq modStoreT(OpId[NeTL], Q, TrId)                    = modSEOpIds(OpId)[modStructTRec(NeTL, Q, TrId)] [owise] .
    eq modStructT(OpId[NeTL], TrId)                      = modSEOpIds(OpId)[modStructTRec(NeTL, TrId)] [owise] .
    eq modStructT(V:Variable, Q, TrId)                   = V:Variable [owise] .
    eq modStructT(C:Constant, Q, TrId)                   = C:Constant [owise] .


    *** Transform terms in a list to use symbolic stores
    op modStructTRec : TermList TrType -> TermList .
    eq modStructTRec(empty, TrId)           = empty .
    eq modStructTRec((T1, TermL), TrId)     = modStructT(T1, TrId), modStructTRec(TermL, TrId) .

    op hasEval : TermList -> Bool .
    eq hasEval(empty)        = false .
    eq hasEval(MConst)       = false .
    eq hasEval(MVar)         = false .
    ***eq hasEval('eval[NeTL])  = true .
    eq hasEval('cieval[NeTL]) = true .
    eq hasEval('creval[NeTL]) = true .
    eq hasEval('cbeval[NeTL]) = true .
    eq hasEval(OpId[NeTL])   = hasEval(NeTL) [owise] .
    eq hasEval((T1, NeTL))  = (hasEval(T1) or hasEval(NeTL)) .

    *** Transform variables and constants within conditions to use SMT types
    op modCond : Condition TrType -> Condition .
    op modCond : Condition TrType Term -> Condition .
    eq modCond(nil, TrId) = nil .
    eq modCond(T1 = T2, TrId)        = (modStructTRec(T1, TrId) = trVal(T2, TrId)) .
    --- eq modCond('val['I:Int] := 'iresolve[NeTL], TrId)       = ('val[trVal('I:Int, TrId)] := 'iresolve[modStructTRec(NeTL, TrId)]) .
    --- eq modCond('val['R:Rat] := 'rresolve[NeTL], TrId)       = ('val[trVal('R:Rat, TrId)] := 'rresolve[modStructTRec(NeTL, TrId)]) .
    --- eq modCond('val['B:Bool] := 'bresolve[NeTL], TrId)       = ('val[trVal('B:Bool, TrId)] := 'bresolve[modStructTRec(NeTL, TrId)]) .
    eq modCond(T1 := T2, TrId)       = (T1 := T2) [owise] .
    ***eq modCond(T1 => T2)       = (T1 => T2) .
    ceq modCond((T1 = T2) /\ Cond2, TrId)    = modCond((T1 = T2), TrId) /\ modCond(Cond2, TrId)
      if not isNil?(Cond2) .
    ceq modCond((T1 := T2) /\ Cond2, TrId)    = modCond((T1 := T2), TrId) /\ modCond(Cond2, TrId)
      if not isNil?(Cond2) .
    ***eq modCond((T1 := T2) /\ (T1' = T2'), TrId)    = modCond((T1 := T2), TrId) /\ modCond(T1' = T2', TrId) .
    ***eq modCond((T1 := T2) /\ (T1' := T2'), TrId)    = modCond((T1 := T2), TrId) /\ modCond(T1' := T2', TrId) .
    eq modCond(Cond, TrId) = Cond [owise] .


    ***op modCond : Condition Qid TrType -> Condition .
    ******eq modCond(EqC /\ EqC2, TrId)    = modCond(EqC, TrId) /\ modCond(EqC2, TrId) .
    ***eq modCond(nil, TrId) = nil .
    ***eq modCond(T1 = T2, TrId) = modEqCond(T1 = T2, TrId) .
    ***eq modCond(Cond, TrId) = Cond [owise] .

    op modCondRl : Condition TrType -> Condition .
    eq modCondRl(nil, TrId)            = nil .
    eq modCondRl(T1 = C, TrId)    = if not hasEval(T1) then
                                                (convert(T1, 'Bool, TrId) = trVal(C, TrId))
                                              else
                                                (modStructTRec(T1, TrId) = trVal(C, TrId))
                                              fi .
    eq modCondRl(T1 = V, TrId)      = if not hasEval(T1) then
                                                (convert(T1, 'Bool, TrId) = trVal(V, TrId))
                                              else
                                                (modStructTRec(T1, TrId) = trVal(V, TrId))
                                              fi .
    eq modCondRl(T1 = Q[NeTL], TrId)        = if not hasEval(T1) then
                                                (convert(T1, 'Bool, TrId) = modStructTRec(Q[NeTL], TrId))
                                              else
                                                (modStructTRec(T1, TrId) = modStructTRec(Q[NeTL], TrId))
                                              fi .
    ***eq modCondRl(T1 = T2, TrId)        = (modStructTRec(T1, TrId) = trVal(T2, TrId)) [owise] .
    eq modCondRl(T1 := T2, TrId)       = (T1 := T2) .
    ***eq modCondRl(T1 => T2)       = (T1 => T2) .
    ***eq modCondRl(EqC /\ EqC2, TrId)    = modCondRl(EqC, TrId) /\ modCondRl(EqC2, TrId) .
    ceq modCondRl((T1 = T2) /\ Cond2, TrId) = modCondRl((T1 = T2), TrId) /\ modCondRl(Cond2, TrId)
      if not isNil?(Cond2) .
    ceq modCondRl((T1 := T2) /\ Cond2, TrId) = modCondRl((T1 := T2), TrId) /\ modCondRl(Cond2, TrId)
      if not isNil?(Cond2) .
    eq modCondRl(Cond, TrId) = Cond [owise] .

    *** TODO: Include extra eqs for custom datatype evals
    *** Patch eval function definition to use symbolic stores and convert values
    op patchEvalSESTR : Equation TrType -> Equation .
    --- eq patchEvalSESTR(eq 'cbeval[NeTL]   = T2 [AttrSet] ., TrId)        = (eq modSEOpIds('cbeval)[modStructTRec(NeTL, TrId)] = modStructTRec(T2, TrId) [AttrSet] .) .
    --- eq patchEvalSESTR(eq 'cieval[NeTL]  = T2 [AttrSet] ., TrId)        = (eq modSEOpIds('cieval)[modStructTRec(NeTL, TrId)] = modStructTRec(T2, TrId) [AttrSet] .) .
    --- eq patchEvalSESTR(eq 'creval[NeTL]  = T2 [AttrSet] ., TrId)        = (eq modSEOpIds('creval)[modStructTRec(NeTL, TrId)] = modStructTRec(T2, TrId) [AttrSet] .) .
    ***eq patchEvalSESTR(eq 'cbeval[NeTL]  = T2 [AttrSet] .)        = (eq modSEOpIds('cbeval)[modStructTRec(NeTL)] = modStructTRec(T2) [AttrSet] .) .
    --- eq patchEvalSESTR(ceq 'cbeval[NeTL]  = T2 if EqC [AttrSet] ., TrId) = (ceq modSEOpIds('cbeval)[modStructTRec(NeTL, TrId)] = modStructTRec(T2, TrId) if modCond(EqC, TrId) [AttrSet] .) .
    --- eq patchEvalSESTR(ceq 'cieval[NeTL] = T2 if EqC [AttrSet] ., TrId) = (ceq modSEOpIds('cieval)[modStructTRec(NeTL, TrId)] = modStructTRec(T2, TrId) if modCond(EqC, TrId) [AttrSet] .) .
    --- eq patchEvalSESTR(ceq 'creval[NeTL] = T2 if EqC [AttrSet] ., TrId) = (ceq modSEOpIds('creval)[modStructTRec(NeTL, TrId)] = modStructTRec(T2, TrId) if modCond(EqC, TrId) [AttrSet] .) .
    ***eq patchEvalSESTR(ceq 'cbeval[NeTL] = T2 if EqC [AttrSet] .) = (ceq modSEOpIds('cbeval)[modStructTRec(NeTL)] = modStructTRec(T2) if modCond(EqC) [AttrSet] .) .
    eq patchEvalSESTR(Eq, TrId) = Eq [owise] .
  
    *** TODO: Include extra eqs for custom datatype evals
    *** Transform the eval functions definition to convert values to SMT types and patch the stores to the symbolic definition
    *** These are special cases for evals with struct refs. 
    op modSEEqs : EquationSet TrType -> EquationSet .
    eq modSEEqs(none, TrId) = none .
    ---eq modSEEqs(eq 'cieval[T1, NeTL] = MVar [AttrSet] . EquationSet, TrId)  = (eq modSEOpIds('cieval)[modStructTRec((T1, NeTL), TrId)] = convert(MVar, getType(MVar), TrId) [AttrSet] .)
    ---                                                                                          modSEEqs(EquationSet, TrId) .
    ---eq modSEEqs(ceq 'cieval[T1, NeTL] = MVar if EqC [AttrSet] . EquationSet, TrId)  = (ceq modSEOpIds('cieval)[modStructTRec((T1, NeTL), TrId)] = trVal(MVar, TrId) if modCond(EqC, TrId) [AttrSet] .)
    ---                                                                                          modSEEqs(EquationSet, TrId) .
    ---eq modSEEqs(eq 'creval[T1, NeTL] = MVar [AttrSet] . EquationSet, TrId)  = (eq modSEOpIds('creval)[modStructTRec((T1, NeTL), TrId)] = convert(MVar, getType(MVar), TrId) [AttrSet] .)
    ---                                                                                          modSEEqs(EquationSet, TrId) .
    ---eq modSEEqs(ceq 'creval[T1, NeTL] = MVar if EqC [AttrSet] . EquationSet, TrId)  = (ceq modSEOpIds('creval)[modStructTRec((T1, NeTL), TrId)] = trVal(MVar, TrId) if modCond(EqC, TrId) [AttrSet] .)
    ---                                                                                          modSEEqs(EquationSet, TrId) .
    ---eq modSEEqs(eq 'cbeval[T1, NeTL] = MVar [AttrSet] . EquationSet, TrId)  = (eq modSEOpIds('cbeval)[modStructTRec((T1, NeTL), TrId)] = convert(MVar, getType(MVar), TrId) [AttrSet] .)
    ---                                                                                          modSEEqs(EquationSet, TrId) .
    ---eq modSEEqs(ceq 'cbeval[T1, NeTL] = MVar if EqC [AttrSet] . EquationSet, TrId)  = (ceq modSEOpIds('cbeval)[modStructTRec((T1, NeTL), TrId)] = trVal(MVar, TrId) if modCond(EqC, TrId) [AttrSet] .)
    ---                                                                                          modSEEqs(EquationSet, TrId) .
    ***eq modSEEqs(eq 'creval['val['R:Rat], NeTL] = MVar [AttrSet] . EquationSet, TrId)  = (eq modSEOpIds('creval)[modStructTRec(('val['R:Rat], NeTL), TrId)] = convert(MVar, getType(MVar), TrId) [AttrSet] .)
    ***                                                                                          modSEEqs(EquationSet, TrId) .
    ***eq modSEEqs(eq 'cbeval['val['B:Bool], NeTL] = MVar [AttrSet] . EquationSet, TrId) = (eq modSEOpIds('cbeval)[modStructTRec(('val['B:Bool], NeTL), TrId)] = convert(MVar, getType(MVar), TrId) [AttrSet] .)
    ***                                                                                          modSEEqs(EquationSet, TrId) .
    ***eq modSEEqs(eq 'cieval[ValOp['I:Int], NeTL] = MVar [AttrSet] . EquationSet, TrId) = (eq modSEOpIds('cieval)[(ValOp['I:Int], modStructTRec(NeTL, TrId))] = convert(MVar, getType(MVar), TrId) [AttrSet] .)
    ***                                                                                          (eq modSEOpIds('cieval)[(ValOp['I:Integer], modStructTRec(NeTL, TrId))] = trVal(MVar, TrId) [AttrSet] .)
    ***                                                                                          modSEEqs(EquationSet, TrId) .
    ***eq modSEEqs(eq 'creval[ValOp['R:Rat], NeTL] = MVar [AttrSet] . EquationSet, TrId) = (eq modSEOpIds('creval)[(ValOp['R:Rat],modStructTRec(NeTL, TrId))] = convert(MVar, getType(MVar), TrId) [AttrSet] .)
    ***                                                                                          (eq modSEOpIds('creval)[(ValOp['R:Real],modStructTRec(NeTL, TrId))] = trVal(MVar, TrId) [AttrSet] .)
    ***                                                                                          modSEEqs(EquationSet, TrId) .
    ***eq modSEEqs(eq 'cbeval[ValOp['B:Bool], NeTL] = MVar [AttrSet] . EquationSet, TrId) = (eq modSEOpIds('cbeval)[(ValOp['B:Bool], modStructTRec(NeTL, TrId))] = convert(MVar, getType(MVar), TrId) [AttrSet] .)
    ***                                                                                          (eq modSEOpIds('cbeval)[(ValOp['B:Boolean], modStructTRec(NeTL, TrId))] = trVal(MVar, TrId) [AttrSet] .)
    ***                                                                                          modSEEqs(EquationSet, TrId) .
    eq modSEEqs(Eq EquationSet, TrId) = patchEvalSESTR(Eq, TrId) modSEEqs(EquationSet, TrId) [owise] .
    
    *** Transformation for concolic execution duplicates the equation set and transforms one of the copies with the symbolic execution transformation
    op modConcEqs : EquationSet TrType -> EquationSet .
    eq modConcEqs(EquationSet, TrId) = EquationSet modSEEqs(EquationSet, TrId) .

    *** Transform equations according to transformation type
    op modEqs : EquationSet TrType -> EquationSet .
    eq modEqs(EquationSet, conc) = modConcEqs(EquationSet, conc) .
    eq modEqs(EquationSet, TrId) = modSEEqs(EquationSet, TrId) [owise] .

    *** Include equational definitions for injected operators 
    op inclSEEqs : Qid -> EquationSet .
    eq inclSEEqs(StateOp) = *** Initialize symbolic variables in a concrete store with concrete values satisfying the accumulated Constraints (concrete store might be pre-initialized)
                            (eq 'init-CState['T1:Term, 'Constraints:Boolean] = 'downTerm['$apply-SMTassignment['T1:Term, 'get-SMTassignment['Constraints:Boolean]], stateErrConst(StateOp)] [none] .)
                            ***(eq 'init-CState[stateVar(StateOp, 0), stateVar(StateOp, 1), 'Constraints:Boolean] = '$apply-SMTassignment[stateVar(StateOp, 0), stateVar(StateOp, 1), 'get-SMTassignment['Constraints:Boolean]] [none] .)
                            *** Fill the gaps in a given concrete store with values satisfying the accumulated constraints. An initial store can only be provided at the beginning, new iterations use empty stores.
                            *** TODO: Maybe simplfiy with term to term Maude-native assignments (probably change in Python too)
                            
                            (eq '$apply-SMTassignment['T1:Term, '_<--_['R:Real, 'Rconc:Real]]       = 'initialize-def['subT['T1:Term, 'upTerm['R:Real], 'upTerm['toRat['Rconc:Real]]]] [none] .)
                            (eq '$apply-SMTassignment['T1:Term, '_<--_['I:Integer, 'Iconc:Integer]] = 'initialize-def['subT['T1:Term, 'upTerm['I:Integer], 'upTerm['toInt['Iconc:Integer]]]] [none] .)
                            (eq '$apply-SMTassignment['T1:Term, '_<--_['B:Boolean, 'Bconc:Boolean]] = 'initialize-def['subT['T1:Term, 'upTerm['B:Boolean], 'upTerm['toBool['Bconc:Boolean]]]] [none] .)
                            (eq '$apply-SMTassignment['T1:Term, '_`,_['_<--_['R:Real, 'Rconc:Real], 'AssignmentSMT:AssignmentSMT]]       = '$apply-SMTassignment['subT['T1:Term, 'upTerm['R:Real], 'upTerm['toRat['Rconc:Real]]], 'AssignmentSMT:AssignmentSMT] [none] .)
                            (eq '$apply-SMTassignment['T1:Term, '_`,_['_<--_['I:Integer, 'Iconc:Integer], 'AssignmentSMT:AssignmentSMT]] = '$apply-SMTassignment['subT['T1:Term, 'upTerm['I:Integer], 'upTerm['toInt['Iconc:Integer]]], 'AssignmentSMT:AssignmentSMT] [none] .)
                            (eq '$apply-SMTassignment['T1:Term, '_`,_['_<--_['B:Boolean, 'Bconc:Boolean], 'AssignmentSMT:AssignmentSMT]] = '$apply-SMTassignment['subT['T1:Term, 'upTerm['B:Boolean], 'upTerm['toBool['Bconc:Boolean]]], 'AssignmentSMT:AssignmentSMT] [none] .)
                            (eq '$apply-SMTassignment['T1:Term, 'failed.AssignmentSMT] = 'T1:Term [none] .)
                            (eq '$apply-SMTassignment['T1:Term, '_<--_['true.Boolean, 'true.Boolean]] = 'initialize-def['T1:Term] [none] .)
                            

                            (eq 'subT['empty.TermList, 'C:Constant, 'Sub:Term] = 'empty.TermList [none] .)
                            (eq 'subT['empty.EmptyCommaList, 'C:Constant, 'Sub:Term] = 'empty.TermList [none] .)
                            (eq 'subT['C:Constant, 'C:Constant, 'Sub:Term] = 'Sub:Term [none] .)
                            (eq 'subT['V:Variable, 'V:Variable, 'Sub:Term] = 'Sub:Term [none] .)
                            (eq 'subT['_`[_`]['Q:Sort, 'NeTL:NeTermList], 'T1:Term, 'Sub:Term] = '_`[_`]['Q:Sort, 'subT['NeTL:NeTermList, 'T1:Term, 'Sub:Term]] [none] .)
                            (eq 'subT['_`,_['T:Term, 'NeTL:NeTermList], 'T1:Term, 'Sub:Term] = '_`,_['subT['T:Term, 'T1:Term, 'Sub:Term], 'subT['NeTL:NeTermList, 'T1:Term, 'Sub:Term]] [none] .)
                            (eq 'subT['T:Term, 'T1:Term, 'T2:Term] = 'T:Term [owise] .)
                            
                            *** Recursively initialize symbolic variables with default values. Yields a concrete state 
                            (eq 'initialize-def['empty.EmptyCommaList] = 'empty.TermList [none] .)
                            (eq 'initialize-def['V:Variable] = 'get-def['V:Variable, 'getType['V:Variable]] [none] .)
                            (eq 'initialize-def['_`[_`]['Q:Sort, 'NeTL:NeTermList]] = '_`[_`]['Q:Sort, 'initialize-def['NeTL:NeTermList]] [none] .)
                            (eq 'initialize-def['_`[_`]['Q:Variable, 'NeTL:NeTermList]] = '_`[_`]['Q:Variable, 'initialize-def['NeTL:NeTermList]] [none] .)
                            (eq 'initialize-def['_`,_['T:Term, 'NeTL:NeTermList]] = '_`,_['initialize-def['T:Term], 'initialize-def['NeTL:NeTermList]] [none] .)
                            (eq 'initialize-def['C:Constant] = 'C:Constant [owise] .)

                            (eq 'get-def['V:Variable, ''Integer.Qid] = ''0.Zero.Constant [none] .)
                            (eq 'get-def['V:Variable, ''Real.Qid] = ''0.Zero.Constant [none] .)
                            (eq 'get-def['V:Variable, ''Boolean.Sort] = ''true.Bool.Constant [none] .)
                            
                            *** Boolean simplification
                            (eq 'not_['not_['B:Boolean]] = 'B:Boolean [none] .)

                            *** Insert only if variable has not been already assigned
                            ***(eq 'insertFirst['Var:Qid, 'I:Int,  'ISTR:IStore] = 'if_then_else_fi['_==_['_`[_`]['ISTR:IStore, 'Var:Qid], 'undefined.Rat], 'insert['Var:Qid, 'I:Int, 'ISTR:IStore], 'ISTR:IStore] [none] .)
                            ***(eq 'insertFirst['Var:Qid, 'R:Rat,  'RSTR:RStore] = 'if_then_else_fi['_==_['_`[_`]['RSTR:RStore, 'Var:Qid], 'undefined.Rat], 'insert['Var:Qid, 'R:Rat, 'RSTR:RStore], 'RSTR:RStore] [none] .)
                            ***(eq 'insertFirst['Var:Qid, 'B:Bool, 'BSTR:BStore] = 'if_then_else_fi['_==_['_`[_`]['BSTR:BStore, 'Var:Qid], 'undefined.Bool], 'insert['Var:Qid, 'B:Bool, 'BSTR:BStore], 'BSTR:BStore] [none] .)
                            
                            ***(eq 'size['C1:Boolean] = ''s_['0.Nat] [none] .)
                            ***(eq 'size['_and_['C1:Boolean, 'Constraints:Boolean]] = ''s_['0.Nat] + 'size['Constraints:Boolean] [none] .)
                            
                            ***(eq 'startC[stateVar(StateOp), 'SVDeclL:PairSVarL]                       = '$startC[stateVar(StateOp), 'SVDeclL:PairSVarL, '_|_|_['empty.IStoreS, 'empty.RStoreS, 'empty.BStoreS], 'true.Boolean] [none] .)
                            ***(eq 'startC['_where_[stateVar(StateOp), 'B:Boolean], 'SVDeclL:PairSVarL] = '$startC[stateVar(StateOp), 'SVDeclL:PairSVarL, '_|_|_['empty.IStoreS, 'empty.RStoreS, 'empty.BStoreS], 'B:Boolean] [none] .)
                            
                            ***(eq '$startC[stateVar(StateOp), 'nil.PairSVarL, 'STR:Stores, 'B:Boolean] = '`[_`]`[_`]`[_`]['updateStore[stateVar(StateOp), 'init-CStore['getStore[stateVar(StateOp)], 'STR:Stores, 'B:Boolean]], '_`{_`}['updateStore[stateVar(StateOp), 'STR:Stores], 'B:Boolean], 'updateStore[stateVar(StateOp), 'STR:Stores]] [none] .)
                            ***(eq '$startC[stateVar(StateOp), '__['_`,_['Var:Qid, 'I1:Integer], 'SVDeclL:PairSVarL], '_|_|_['ISTRS:IStoreS, 'RSTRS:RStoreS, 'BSTRS:BStoreS], 'B:Boolean] = '$startC[stateVar(StateOp), 'SVDeclL:PairSVarL, '_|_|_['insert['Var:Qid, 'I1:Integer, 'ISTRS:IStoreS], 'RSTRS:RStoreS, 'BSTRS:BStoreS], 'B:Boolean] [none] .)
                            ***(eq '$startC[stateVar(StateOp), '__['_`,_['Var:Qid, 'R1:Real],    'SVDeclL:PairSVarL], '_|_|_['ISTRS:IStoreS, 'RSTRS:RStoreS, 'BSTRS:BStoreS], 'B:Boolean] = '$startC[stateVar(StateOp), 'SVDeclL:PairSVarL, '_|_|_['ISTRS:IStoreS, 'insert['Var:Qid, 'R1:Real, 'RSTRS:RStoreS], 'BSTRS:BStoreS], 'B:Boolean] [none] .)
                            ***(eq '$startC[stateVar(StateOp), '__['_`,_['Var:Qid, 'B1:Boolean], 'SVDeclL:PairSVarL], '_|_|_['ISTRS:IStoreS, 'RSTRS:RStoreS, 'BSTRS:BStoreS], 'B:Boolean] = '$startC[stateVar(StateOp), 'SVDeclL:PairSVarL, '_|_|_['ISTRS:IStoreS, 'RSTRS:RStoreS, 'insert['Var:Qid, 'B1:Boolean, 'BSTRS:BStoreS]], 'B:Boolean] [none] .)
                            
                            ***(eq 'startSE[stateVar(StateOp), 'nil.PairSVarL, 'STR:Stores] = 'updateStore[stateVar(StateOp), 'STR:Stores] [none] .)
                            ***(eq 'startSE[stateVar(StateOp), '__['_`,_['Var:Qid, 'I1:Integer], 'SVDeclL:PairSVarL], '_|_|_['ISTRS:IStoreS, 'RSTRS:RStoreS, 'BSTRS:BStoreS]] = 'startSE[stateVar(StateOp), 'SVDeclL:PairSVarL, '_|_|_['insert['Var:Qid, 'I1:Integer, 'ISTRS:IStoreS], 'RSTRS:RStoreS, 'BSTRS:BStoreS]] [none] .)
                            ***(eq 'startSE[stateVar(StateOp), '__['_`,_['Var:Qid, 'R1:Real],    'SVDeclL:PairSVarL], '_|_|_['ISTRS:IStoreS, 'RSTRS:RStoreS, 'BSTRS:BStoreS]] = 'startSE[stateVar(StateOp), 'SVDeclL:PairSVarL, '_|_|_['ISTRS:IStoreS, 'insert['Var:Qid, 'R1:Real, 'RSTRS:RStoreS], 'BSTRS:BStoreS]] [none] .)
                            ***(eq 'startSE[stateVar(StateOp), '__['_`,_['Var:Qid, 'B1:Boolean], 'SVDeclL:PairSVarL], '_|_|_['ISTRS:IStoreS, 'RSTRS:RStoreS, 'BSTRS:BStoreS]] = 'startSE[stateVar(StateOp), 'SVDeclL:PairSVarL, '_|_|_['ISTRS:IStoreS, 'RSTRS:RStoreS, 'insert['Var:Qid, 'B1:Boolean, 'BSTRS:BStoreS]]] [none] .)
                            ****** Similar definition for starting narrowing execution
                            ***(eq 'startSE[stateVar(StateOp), '__['_`,_['Var:Qid, 'I1:IntFVP], 'SVDeclL:PairSVarL], '_|_['ISTRN:IStoreN, 'BSTRN:BStoreN]] = 'startSE[stateVar(StateOp), 'SVDeclL:PairSVarL, '_|_['insert['Var:Qid, 'I1:IntFVP, 'ISTRN:IStoreN], 'BSTRN:BStoreN]] [none] .)
                            ***(eq 'startSE[stateVar(StateOp), '__['_`,_['Var:Qid, 'B1:BoolFVP], 'SVDeclL:PairSVarL], '_|_['ISTRN:IStoreN, 'BSTRN:BStoreN]] = 'startSE[stateVar(StateOp), 'SVDeclL:PairSVarL, '_|_['ISTRN:IStoreN, 'insert['Var:Qid, 'B1:BoolFVP, 'BSTRN:BStoreN]]] [none] .)
                            
                            (ceq 'startSED[stateVar(StateOp), 'SVDeclL:PairSVarL, 'STR:Stores, 'B:Boolean] = '_`{_`}['startSE[stateVar(StateOp), 'SVDeclL:PairSVarL, 'STR:Stores], 'B:Boolean]
                              if 'metaCheck[upTerm(['REAL-INTEGER]), upTerm('B:Boolean)] = 'true.Bool [none] .) .



    *** Transform rules depending on transformation type
    op modRl : RuleSet Qid TrType -> RuleSet .
    eq modRl(RlSet, StateOp, symb) = rlToSymbolic(RlSet) .
    eq modRl(RlSet, StateOp, conc) = rlToConcolic(RlSet, StateOp) .
    eq modRl(RlSet, StateOp, maudeSE) = rlToSE(RlSet, maudeSE) .
    eq modRl(RlSet, StateOp, narrowing) = rlToNarrowing(RlSet) .
    ***eq modRl(RlSet, clconc) = rlToClConcolic(RlSet, StateOp) inclClConcCrl(StateOp) .

    *** Include extra imports from transformed transformation
    op inclImports : -> ImportList .
    eq inclImports = nil [owise] .

    *** NOTE: MaudeSE does not work with smod
    *** Transform a module M considering the original State sort, an auxiliary value operator, and the transfotmation id (symb, conc, maudeSE)
    *** The transformation modifies operators, equations and rewrite rules, and it is specific for the target transformation type
    op trMod : Module Qid TrType -> Module .
    eq trMod(M, StateOp, TrId) = mod 'TRANSFORMED-MOD is
                                          inclImports getImports(M)
                                          sorts inclSESorts(getSorts(M)) .
                                          getSubsorts(M)
                                          modSEOps(getOps(M), StateOp, TrId)
                                          getMbs(M)
                                          modEqs(getEqs(M), TrId) inclSEEqs(StateOp)
                                          modRl(getRls(M), StateOp, TrId)
                                          ***getStrats(M)
                                          ***getSds(M)
                                        endm .

    *** Fuses a module and a functional module into one
    op fuseMods : Module Module -> Module .
    eq fuseMods(M, M') = mod getName(M) is
                            getImports(M) getImports(M')
                            sorts getSorts(M) ; getSorts(M') .
                            getSubsorts(M) getSubsorts(M')
                            getOps(M) getOps(M')
                            getMbs(M) getMbs(M')
                            getEqs(M) getEqs(M')
                            getRls(M) getRls(M')
                            ***getStrats(M) getStrats(FM)
                            ***getSds(M) getSds(FM)
                          endm .

    *** Transform a module to include the symbolic/concolic execution requirements.
    *** TODO: Evaluate whether fusing with full SEM-TR instead
    op transformModSymb : Qid Qid TrType -> Module .
    eq transformModSymb(ModId, StateOp, TrId) = transformModSymb(upModule(ModId, true), StateOp, TrId) .
    op transformModSymb : Module Qid TrType -> Module .
    eq transformModSymb(M, StateOp, TrId) = transformModSymb(M, StateOp, TrId) .
    op transformModSymb : Module Qid TrType -> Module .
    eq transformModSymb(M, StateOp, TrId) = fuseMods(trMod(M, StateOp, TrId), upModule('SMT-AND-NARROWING, true)) .
    
    *** Transform module to concolic
    op concTr : Module Qid -> Module .
    eq concTr(M, StateOp) = transformModSymb(M, StateOp, conc) .

    op narrowingTr : Module Qid -> Module .
    eq narrowingTr(M, StateOp) = transformModSymb(M, StateOp, narrowing) .

endfm

fmod STRUCT-TR is
    protecting META-LEVEL .

    *** Definition of tuple that relates the custom datatype sort with its eval and conversion functions
    sorts DataFTup DataFTupL .
    subsort DataFTup < DataFTupL .
    op emptyDataFTup : -> DataFTupL [ctor] .
    op (_|_|_|_) : SortSet QidList Qid Qid -> DataFTup [ctor] .
    op _;_ : DataFTupL DataFTupL -> DataFTupL [ctor assoc id: emptyDataFTup] .

    vars Q OpQ NrwConvMQid EvQid CnvQid RsvQid : Qid .
    var EvQidL : QidList .
    var T : Term .
    var TL : TermList .
    vars NeTL NeTLasTV : NeTermList .
    var S : Sort .
    vars SortS SortS' : SortSet .
    var V : Variable .
    var DataFTupL : DataFTupL .

    *** Generate modification eqs for operators that yield struct types (consts and vars)
    op genEqsConsVar : Qid -> EquationSet .
    eq genEqsConsVar(Q) = (eq 'modStructT['C:Constant, Q, 'TrId:TrType] = 'subSEConstSortsT['C:Constant, Q, 'TrId:TrType] [none] .)
                          (eq 'modStructT['V:Variable, Q, 'TrId:TrType] = 'subSEVarSorts['V:Variable, Q, 'TrId:TrType] [none] .)
                          (eq 'modStructT['C:Constant, 'TrId:TrType] = 'modStructT['C:Constant, 'getType['C:Constant], 'TrId:TrType] [none] .)
                          (eq 'modStructT['V:Variable, 'TrId:TrType] = 'modStructT['V:Variable, 'getType['V:Variable], 'TrId:TrType] [none] .)
                          .

    *** Convert object variable to term variable
    op toTVar : TermList ~> TermList .
    eq toTVar(empty) = empty .
    eq toTVar((V, TL)) = qid(string(getName(V)) + ":Term"), toTVar(TL) .
    eq toTVar((T, TL)) = T, toTVar(TL) [owise] .
    
    *** Generate modification eqs for operators that yield struct types (composite terms)
    op genEqsCompTerm : Qid TermList -> EquationSet .
    eq genEqsCompTerm(Q, empty) = none .
    ceq genEqsCompTerm(Q, (OpQ[T] , TL)) =
        ***       We are using another meta-level (that is why we use upTerm here)
        (eq 'modStructT['_`[_`][upTerm(OpQ), NeTLasTV]] = '_`[_`][upTerm(OpQ), 'trVal[NeTLasTV]] [owise] .)
        (eq 'subSEVarSorts['V:Variable, Q] = 'qid['_+_['_+_['string['getName['V:Variable]], '"S:".String], 'string['trSorts[Q]]]] [owise] .)
        genEqsCompTerm(Q, TL)
      if NeTLasTV := toTVar(T) [owise] .
    ceq genEqsCompTerm(Q, (OpQ[T, NeTL] , TL)) =
        (eq 'modStructT['_`[_`][upTerm(OpQ), '_`,_[NeTLasTV]], 'TrId:TrType] = '_`[_`][upTerm(OpQ), 'trVal['_`,_[NeTLasTV], 'TrId:TrType]] [owise] .)
        (eq 'subSEVarSorts['V:Variable, Q, 'TrId:TrType] = 'qid['_+_['_+_['string['getName['V:Variable]], '"S:".String], 'string['trSorts[Q, 'TrId:TrType]]]] [owise] .)
        genEqsCompTerm(Q, TL)
      if NeTLasTV := toTVar((T, NeTL)) [owise] .
    eq genEqsCompTerm(Q, ('_`,_[NeTL] , TL)) = genEqsCompTerm(Q, TL) .

    *** Generate modification eqs for operators that yield struct types
    op generateEqs : Qid TermList -> EquationSet .
    eq generateEqs(Q, TL) = genEqsConsVar(Q)
                            genEqsCompTerm(Q, TL) .
    
    *** Generate modification eqs for every struct sort
    op generateEqsFromSortSet : SortSet TermList -> EquationSet .
    eq generateEqsFromSortSet(none, TL) = none .
    eq generateEqsFromSortSet(S ; SortS, TL) = generateEqs(upTerm(S), TL) generateEqsFromSortSet(SortS, TL) .

    op genVWithS : Sort -> Term .
    eq genVWithS(Q) = qid("'VT:" + string(Q) + ".Variable") .

    op inclEvModEqs : QidList -> EquationSet .
    eq inclEvModEqs(nil) = none .
    eq inclEvModEqs(EvQid EvQidL) = *** Include eval function op Qid modification. Same for every symbolic analysis (narrowing or SMT)
                                    (eq 'modSEOpIds[upTerm(EvQid)] = 'toSymb[upTerm(EvQid)] [none] .)
                                    *** Include eq modifications
                                    *** Constant result
                                    (eq 'modSEEqs['__['eq_=_`[_`].['_`[_`][upTerm(EvQid), '_`,_['T1:Term, 'NeTL:NeTermList]], 
                                                                  'C:Constant, 'AttrSet:AttrSet], 
                                                      'EquationSet:EquationSet], 'TrId:TrType]  
                                                  = '__['eq_=_`[_`].['_`[_`]['modSEOpIds[upTerm(EvQid)], 'modStructTRec['_`,_['T1:Term, 'NeTL:NeTermList], 'TrId:TrType]], 
                                                                  'convert['C:Constant, 'getType['C:Constant], 'TrId:TrType], 'AttrSet:AttrSet],
                                                        *** Include symbolic eval to unwrap symbolic semantic values
                                                        ---'eq_=_`[_`].['_`[_`]['modSEOpIds[upTerm(EvQid)], 'modStructTRec['_`,_['_`[_`][''val.Sort, 'subSEConstSortsT['C:Constant, 'getType['C:Constant], 'TrId:TrType]], 'NeTL:NeTermList], 'TrId:TrType]], 
                                                        ---          'subSEConstSortsT['C:Constant, 'getType['C:Constant], 'TrId:TrType], 'AttrSet:AttrSet],
                                                      'modSEEqs['EquationSet:EquationSet, 'TrId:TrType]] [none] .)
                                    (eq 'modSEEqs['__['ceq_=_if_`[_`].['_`[_`][upTerm(EvQid), '_`,_['T1:Term, 'NeTL:NeTermList]], 
                                                                  'C:Constant, 'EqC:EqCondition, 'AttrSet:AttrSet], 
                                                      'EquationSet:EquationSet], 'TrId:TrType]  
                                                  = '__['ceq_=_if_`[_`].['_`[_`]['modSEOpIds[upTerm(EvQid)], 'modStructTRec['_`,_['T1:Term, 'NeTL:NeTermList], 'TrId:TrType]], 
                                                                  'trVal['C:Constant, 'TrId:TrType], 'modCond['EqC:EqCondition, 'TrId:TrType, 'C:Constant], 'AttrSet:AttrSet], 
                                                      'modSEEqs['EquationSet:EquationSet, 'TrId:TrType]] [none] .)
                                    *** Variable result
                                    (eq 'modSEEqs['__['eq_=_`[_`].['_`[_`][upTerm(EvQid), '_`,_['T1:Term, 'NeTL:NeTermList]], 
                                                                  'V:Variable, 'AttrSet:AttrSet], 
                                                      'EquationSet:EquationSet], 'TrId:TrType]  
                                                  = '__['eq_=_`[_`].['_`[_`]['modSEOpIds[upTerm(EvQid)], 'modStructTRec['_`,_['T1:Term, 'NeTL:NeTermList], 'TrId:TrType]], 
                                                                  'convert['V:Variable, 'getType['V:Variable], 'TrId:TrType], 'AttrSet:AttrSet],
                                                        *** Include symbolic eval to unwrap symbolic semantic values
                                                        'eq_=_`[_`].['_`[_`]['modSEOpIds[upTerm(EvQid)], 'trInsideVal['modStructTRec['_`,_['T1:Term, 'NeTL:NeTermList], 'TrId:TrType], 'TrId:TrType]], 
                                                                  'subSEVarSorts['V:Variable, 'getType['V:Variable], 'TrId:TrType], 'AttrSet:AttrSet],
                                                      'modSEEqs['EquationSet:EquationSet, 'TrId:TrType]] [none] .)
                                    (eq 'modSEEqs['__['ceq_=_if_`[_`].['_`[_`][upTerm(EvQid), '_`,_['T1:Term, 'NeTL:NeTermList]], 
                                                                  'V:Variable, 'EqC:EqCondition, 'AttrSet:AttrSet], 
                                                      'EquationSet:EquationSet], 'TrId:TrType]  
                                                  = '__['ceq_=_if_`[_`].['_`[_`]['modSEOpIds[upTerm(EvQid)], 'modStructTRec['_`,_['T1:Term, 'NeTL:NeTermList], 'TrId:TrType]], 
                                                                  'trVal['V:Variable, 'TrId:TrType], 'modCond['EqC:EqCondition, 'TrId:TrType, 'V:Variable], 'AttrSet:AttrSet], 
                                                        'ceq_=_if_`[_`].['_`[_`]['modSEOpIds[upTerm(EvQid)], 'modStructTRec['_`,_['T1:Term, 'NeTL:NeTermList], 'TrId:TrType]], 
                                                                  'convert['V:Variable, 'getType['V:Variable], 'TrId:TrType], 'EqC:EqCondition, 'AttrSet:AttrSet], 
                                                      'modSEEqs['EquationSet:EquationSet, 'TrId:TrType]] [none] .)
                                    *** Duplicate for symbolic semantic values 
                                    (eq 'patchEvalSESTR['eq_=_`[_`].['_`[_`][upTerm(EvQid), '_`,_['T1:Term, 'NeTL:NeTermList]], 
                                                                    'T2:Term, 'AttrSet:AttrSet],
                                                        'TrId:TrType]
                                                        = '__['eq_=_`[_`].['_`[_`]['modSEOpIds[upTerm(EvQid)], 'modStructTRec['_`,_['T1:Term, 'NeTL:NeTermList], 'TrId:TrType]], 
                                                                    'modStructTRec['T2:Term, 'TrId:TrType], 'AttrSet:AttrSet],
                                                              'eq_=_`[_`].['_`[_`]['modSEOpIds[upTerm(EvQid)], 'trInsideVal['modStructTRec['_`,_['T1:Term, 'NeTL:NeTermList], 'TrId:TrType], 'TrId:TrType]], 
                                                                    'trInsideVal['modStructTRec['T2:Term, 'TrId:TrType], 'TrId:TrType], 'AttrSet:AttrSet]] [none] .)
                                    (eq 'patchEvalSESTR['ceq_=_if_`[_`].['_`[_`][upTerm(EvQid), '_`,_['T1:Term, 'NeTL:NeTermList]], 
                                                                    'T2:Term, 'EqC:EqCondition, 'AttrSet:AttrSet],
                                                        'TrId:TrType]
                                                        = '__['ceq_=_if_`[_`].['_`[_`]['modSEOpIds[upTerm(EvQid)], 'modStructTRec['_`,_['T1:Term, 'NeTL:NeTermList], 'TrId:TrType]], 
                                                                    'modStructTRec['T2:Term, 'TrId:TrType], 'modCond['EqC:EqCondition, 'TrId:TrType], 'AttrSet:AttrSet],
                                                              'ceq_=_if_`[_`].['_`[_`]['modSEOpIds[upTerm(EvQid)], 'trInsideVal['modStructTRec['_`,_['T1:Term, 'NeTL:NeTermList], 'TrId:TrType], 'TrId:TrType]], 
                                                                    'trInsideVal['modStructTRec['T2:Term, 'TrId:TrType], 'TrId:TrType], 'modCond['EqC:EqCondition, 'TrId:TrType], 'AttrSet:AttrSet]] [none] .)
                                    inclEvModEqs(EvQidL) .

    op inclSortModEqs : SortSet Qid -> EquationSet .
    eq inclSortModEqs(none, CnvQid) = none .
    eq inclSortModEqs(S ; SortS', CnvQid) = (eq 'toNRWSorts['__[upTerm(S), 'TL:TypeList]] = '__['toNrw[upTerm(S)], 'toNRWSorts['TL:TypeList]] [owise] .)
                                            *** Include conversion eqs
                                            (eq 'convertNarrowing['C:Constant, upTerm(S)] = '_`[_`][upTerm(CnvQid), 'C:Constant] [none] .)
                                            (eq 'convertNarrowing['V:Variable, upTerm(S)] = '_`[_`][upTerm(CnvQid), 'V:Variable] [none] .)
                                            *** Include constant type translation for custom datatype
                                            (eq 'subSEConstSortsT['C:Constant, upTerm(S), 'TrId:TrType] = 'qid['_+_['_+_['string['getName['C:Constant]], '".".Char], 'string['trSorts[upTerm(S), 'TrId:TrType]]]] [owise] .) 
                                            *** Include var type translation for custom datatype
                                            (eq 'subSEVarSorts['V:Variable, upTerm(S), 'TrId:TrType] = 'qid['_+_['_+_['string['getName['V:Variable]], '":".Char], 'string['trSorts[upTerm(S), 'TrId:TrType]]]] [owise] .) 
                                            *** Include trVal for custom datatype val structs
                                            (eq 'trVal['_`[_`][''val.Sort, genVWithS(S)], 'TrId:TrType] = '_`[_`][''val.Sort, 'convert[genVWithS(S), upTerm(S), 'TrId:TrType]] [none] .)
                                            inclSortModEqs(SortS', CnvQid) .

    *** Include eqs related to custom datatype for narrowing
    op genDataTEqs : SortSet Qid DataFTupL -> EquationSet .
    op genDataTEqs : SortSet DataFTupL -> EquationSet .
    *** Include the narrowing theory module for the datatype (should include conversion functions)
    eq genDataTEqs(none, NrwConvMQid, DataFTupL) = (eq 'inclImports.ImportList = 'protecting_.[upTerm(NrwConvMQid)] [none] .) .
    eq genDataTEqs(S ; SortS, NrwConvMQid, (((S ; SortS') | EvQidL | CnvQid | RsvQid) ; DataFTupL)) = 
                                                *** Include sort name translation (i.e. Bool to BoolFVP)
                                                inclEvModEqs(EvQidL)
                                                inclSortModEqs((S ; SortS'), CnvQid)
                                                *** Include condition eval transformation. Use extra 'T:Term to get the name of the internal value Maude variable with modSEEqs from the original ceq 
                                                *** TODO: Include modCondRl
                                                (eq 'modCond['_:=_['_`[_`][''val.Sort, 'T:Term], ***genVWithS(S)
                                                                  '_`[_`][upTerm(RsvQid), 'NeTL:NeTermList]], 
                                                            'TrId:TrType, 'T:Term]
                                                            = '_:=_['_`[_`][''val.Sort, 'trVal['T:Term, 'TrId:TrType]], 
                                                                    '_`[_`][upTerm(RsvQid), 'modStructTRec['NeTL:NeTermList, 'TrId:TrType]]] [none] .)
                                                ***(eq '_`[_`][upTerm(CnvQid), 'C:Constant] = '_`[_`][upTerm(CnvQid), 'C:Constant] [none] .)
                                                ***(eq '_`[_`][upTerm(CnvQid), 'V:Variable] = '_`[_`][upTerm(CnvQid), 'V:Variable] [none] .)
                                                genDataTEqs(SortS, NrwConvMQid, DataFTupL) .
    eq genDataTEqs(none, DataFTupL) = none .
    eq genDataTEqs(S ; SortS, (((S ; SortS') | EvQidL | CnvQid | RsvQid) ; DataFTupL)) = 
                                                *** Include sort name translation (i.e. Bool to BoolFVP)
                                                inclEvModEqs(EvQidL)
                                                inclSortModEqs((S ; SortS'), CnvQid)
                                                *** Include condition eval transformation. Use extra 'T:Term to get the name of the internal value Maude variable with modSEEqs from the original ceq 
                                                *** TODO: Include modCondRl
                                                (eq 'modCond['_:=_['_`[_`][''val.Sort, 'T:Term], ***genVWithS(S)
                                                                  '_`[_`][upTerm(RsvQid), 'NeTL:NeTermList]], 
                                                            'TrId:TrType, 'T:Term]
                                                            = '_:=_['_`[_`][''val.Sort, 'trVal['T:Term, 'TrId:TrType]], 
                                                                    '_`[_`][upTerm(RsvQid), 'modStructTRec['NeTL:NeTermList, 'TrId:TrType]]] [none] .)
                                                ***(eq '_`[_`][upTerm(CnvQid), 'C:Constant] = '_`[_`][upTerm(CnvQid), 'C:Constant] [none] .)
                                                ***(eq '_`[_`][upTerm(CnvQid), 'V:Variable] = '_`[_`][upTerm(CnvQid), 'V:Variable] [none] .)
                                                genDataTEqs(SortS, DataFTupL) .
endfm

mod META-STRUCT-TR is
    protecting CONVERSION .

    protecting STRUCT-TR .
    protecting SEM-TR .

    vars M M' : Module .
    ***var NRWConvM : FModule .
    var C : Constant .
    vars SortS NrwDataTSortS DataTSortS : SortSet .
    vars S S' SVal : Sort .
    vars structOpTL TL TL' : TermList .
    var evalDataOpQL : QidList .
    vars Q NrwConvMQid CnvQid RsvQid : Qid .
    var TyL : TypeList .
    vars NeTyL NeTyL' : NeTypeList .
    var Ty : Type .
    var OpDecl : OpDecl .
    vars OpDeclSet OpDeclSet' : OpDeclSet .
    var N : Nat .
    var AttrSet : AttrSet .
    var SubSSet : SubsortDeclSet .
    var SubS : SubsortDecl .
    var T : Term .
    var DataFTupL : DataFTupL .

    *** Generate TermList with sequentially numbered terms of specified types
    op genTLStr : TypeList Nat -> TermList .
    eq genTLStr(nil, N) = empty .
    eq genTLStr(Ty TyL, N) = qid("T" + string(N + 1, 10) + ":" + string(Ty)), genTLStr(TyL, N + 1) .

    *** Generate TermList with sequentially numbered terms of specified types
    op genCompT : Qid TypeList Nat -> Term .
    eq genCompT(Q, nil, N) = Q .
    eq genCompT(Q, Ty TyL, N) = Q[qid("T" + string(N, 10) + ":" + string(Ty)), genTLStr(TyL, N)] .

    ***op genSymbOp : Qid TypeList Sort AttrSet -> OpDecl .
    ***eq genSymbOp('_`,_, TyL, S, AttrSet) = (op '_`,_ : TyL -> S [AttrSet] .) .
    ***eq genSymbOp(Q, TyL, S, AttrSet) = (op toSymb(Q) : TyL -> S [AttrSet] .) [owise] .

    *** Generate matching (left-hand side) terms corresponding to operators that yield structs
    *** TODO: Revise if NeTyL is correct (included because it was taking constants like EmptyStack, though not empty, and it should take none)
    op genStructOpTL : OpDeclSet SortSet Nat -> TermList .
    eq genStructOpTL(none, SortS, N) = empty .
    eq genStructOpTL(OpDeclSet, none, N) = empty .
    eq genStructOpTL((op Q : NeTyL -> S [AttrSet] .) OpDeclSet, S ; SortS, N) = genCompT(Q, NeTyL, N) , genStructOpTL(OpDeclSet, SortS, N) . 
    eq genStructOpTL(OpDecl OpDeclSet, SortS, N) = genStructOpTL(OpDeclSet, SortS, N) [owise] .
    
    *** Generate a sort name corresponding to the val representation of input sort name S
    op genValSName : Sort -> Sort .
    eq genValSName('Bool) = 'BVal .
    eq genValSName('Zero) = 'IVal .
    eq genValSName('Int) = 'IVal .
    eq genValSName(S) = qid(string(S) + "Val") [owise] .

    op getRsvFQid : OpDeclSet Sort -> Qid .
    eq getRsvFQid((op RsvQid : NeTyL' -> SVal [metadata("rsvF") AttrSet] .) OpDeclSet, SVal) = RsvQid .

    op getRestEvQidL : OpDeclSet Sort -> QidList .
    eq getRestEvQidL(none, S) = nil .
    eq getRestEvQidL((op Q : NeTyL -> S [metadata("evalF") AttrSet] .) OpDeclSet, S) = Q getRestEvQidL(OpDeclSet, S) .
    eq getRestEvQidL(OpDecl OpDeclSet, S) = getRestEvQidL(OpDeclSet, S) [owise] .

    *** Get custom datatype information:
    ***   Subsorts, eval functions op qids, conversion op qid, resolve function op qid
    op getDataFTup : OpDeclSet SortSet SubsortDeclSet -> DataFTupL .
    eq getDataFTup(none, SortS, SubSSet) = emptyDataFTup .
    eq getDataFTup(OpDeclSet, none, SubSSet) = emptyDataFTup .
    eq getDataFTup((op Q : NeTyL -> S [metadata("evalF") AttrSet] .) 
                  (op CnvQid : S -> S' [metadata("convF") AttrSet] .) OpDeclSet, S ; SortS, SubSSet) = ((S ; subOfS(SubSSet, S)) | Q getRestEvQidL(OpDeclSet, S) | CnvQid | getRsvFQid(OpDeclSet, genValSName(S))) ; getDataFTup(OpDeclSet, SortS, SubSSet) .
    eq getDataFTup(OpDecl OpDeclSet, SortS, SubSSet) = getDataFTup(OpDeclSet, SortS, SubSSet) [owise] .

    *** Get the immidiate subsorts of sorts in a set (in this case, declared structs)
    op subOfS : SubsortDeclSet SortSet -> SortSet .
    eq subOfS(none, SortS) = none .
    eq subOfS(subsort S' < S . SubSSet, S ; SortS) = S' ; subOfS(SubSSet, S ; SortS) .
    eq subOfS(subsort S' < S . SubSSet, SortS) = subOfS(SubSSet, SortS) [owise] .

    *** TODO: Reorganize this
    *** Transform a transformation module with eqs modifying structs and/or custom datatypes
    op tr : Module SortSet -> Module .
    op tr : Module SortSet SortSet Qid DataFTupL -> Module .
    op tr : Module SortSet SortSet DataFTupL -> Module .
    ceq tr(M, SortS) = mod getName(M) is
                getImports(M) (protecting 'META-STRUCT-TR .)
                sorts getSorts(M) .
                getSubsorts(M)
                getOps(M) ***OpDeclSet
                getMbs(M)
                getEqs(M) generateEqsFromSortSet(SortS, structOpTL)
                getRls(M)
                ***getStrats(M) getStrats(FM)
                ***getSds(M) getSds(FM)
                endm
        ***if (OpDeclSet | structOpTL) := genStructOpTL(getOps(M), subOfS(getSubsorts(M), SortS) ; SortS, 0)
        if structOpTL := genStructOpTL(getOps(M), subOfS(getSubsorts(M), SortS) ; SortS, 0) .
    eq tr(M, SortS, NrwDataTSortS, NrwConvMQid, DataFTupL) = tr(mod getName(M) is
                                                                getImports(M) (protecting 'META-STRUCT-TR .) (protecting NrwConvMQid .)
                                                                sorts getSorts(M) .
                                                                getSubsorts(M)
                                                                getOps(M) ***OpDeclSet
                                                                getMbs(M)
                                                                genDataTEqs(NrwDataTSortS, NrwConvMQid, DataFTupL) getEqs(M)
                                                                getRls(M)
                                                                ***getStrats(M) getStrats(FM)
                                                                ***getSds(M) getSds(FM)
                                                                endm, SortS) .
    *** Transformation for non-narrowing analysis
    eq tr(M, SortS, NrwDataTSortS, DataFTupL) = tr(mod getName(M) is
                                                    getImports(M) (protecting 'META-STRUCT-TR .)
                                                    sorts getSorts(M) .
                                                    getSubsorts(M)
                                                    getOps(M) ***OpDeclSet
                                                    getMbs(M)
                                                    genDataTEqs(NrwDataTSortS, DataFTupL) getEqs(M)
                                                    getRls(M)
                                                    ***getStrats(M) getStrats(FM)
                                                    ***getSds(M) getSds(FM)
                                                    endm, SortS) .

    *** Get declared structs
    op getStructS : OpDeclSet -> SortSet .
    eq getStructS(none) = none .
    eq getStructS((op 'struct : S -> 'Struct [ ctor metadata("vstruct") AttrSet] .) OpDeclSet) = S ; getStructS(OpDeclSet) . 
    eq getStructS(OpDecl OpDeclSet) = getStructS(OpDeclSet) [owise] .

    *** Get declared custom datatypes
    op getDataTS : OpDeclSet -> SortSet .
    eq getDataTS(none) = none .
    eq getDataTS((op 'datatype : S -> 'DataType [ ctor metadata("datatype") AttrSet] .) OpDeclSet) = S ; getDataTS(OpDeclSet) . 
    eq getDataTS(OpDecl OpDeclSet) = getDataTS(OpDeclSet) [owise] .
    
    ***op trNrwCustomDataT : Module SortSet -> Module .
    ***eq trNrwCustomDataT(M, none) = M .
    ***eq trNrwCustomDataT(M, S ; SortS) = mod getName(M) is
    ***                                  getImports(M) (protecting 'META-STRUCT-TR .)
    ***                                  sorts getSorts(M) .
    ***                                  getSubsorts(M)
    ***                                  getOps(M)
    ***                                  getMbs(M)
    ***                                  getEqs(M) genDataTEqs(S ; SortS)
    ***                                  getRls(M)
    ***                                  ***getStrats(M) getStrats(FM)
    ***                                  ***getSds(M) getSds(FM)
    ***                                endm .


    *** [Deprecated] Function to invoke tr with the SortSet of marked Structs
    ***op trWithStructs : Module -> Module .
    ***ceq trWithStructs(M) = tr(M, SortS)
    ***  if SortS := getStructS(getOps(M)) .
    *** Function to invoke tr with the SortSet of marked Structs and automatically fuses semantics with trasformer
    op trWithStructsPrM : Module Qid -> Module .
    ***ceq trWithStructsPrM(M, Q) = tr(trNrwCustomDataT(M', getDataTS(getOps(M'))), SortS)
    ceq trWithStructsPrM(M, Q) = tr(M', SortS)
      if M' := fuseMods(upModule(Q, true), M)
      /\ SortS := getStructS(getOps(M')) .
    
    *** Transform with structs and custom datatypes for narrowing
    *** NrwConvMQid is the Qid refferring to the module containing the datatype narrowing theory spec (with conversion definition from concrete to FVP types) 
    op trWithStructsDataTPrM : Module Qid Qid -> Module .
    op trWithStructsDataTPrM : Module Qid -> Module .
    ceq trWithStructsDataTPrM(M, Q, NrwConvMQid) = tr(M', SortS, NrwDataTSortS, NrwConvMQid, DataFTupL)
      if M' := fuseMods(upModule(Q, true), fuseMods(M, upModule(NrwConvMQid, true)))
      /\ SortS := getStructS(getOps(M'))
      /\ NrwDataTSortS := getDataTS(getOps(M'))
      /\ DataFTupL := getDataFTup(getOps(M'), NrwDataTSortS, getSubsorts(M')) .
    ceq trWithStructsDataTPrM(M, Q) = tr(M', SortS, DataTSortS, DataFTupL)
      if M' := fuseMods(upModule(Q, true), M)
      /\ SortS := getStructS(getOps(M'))
      /\ DataTSortS := getDataTS(getOps(M'))
      /\ DataFTupL := getDataFTup(getOps(M'), DataTSortS, getSubsorts(M')) .
    
    op metaReduceMetaMod : Module Qid Qid Term -> ResultPair? .
    ceq metaReduceMetaMod(M, Q, NrwConvMQid, T) = metaReduce(M', T)
      if M' := trWithStructsDataTPrM(M, Q, NrwConvMQid) .
    
    op metaReduceMetaMod : Module Qid Term -> ResultPair? .
    ceq metaReduceMetaMod(M, Q, T) = metaReduce(M', T)
      if M' := trWithStructsDataTPrM(M, Q) .
endm

mod VERIFICATION-COMMANDS is

    ***pr SEM-TR .
    pr  META-STRUCT-TR .
    pr LEXICAL .

    vars ModId StateOp PrOp SearchType ValOp TargetSt FoldQ : Qid .
    var  TrId                                               : TrType .
    var  PatternSEState                                     : Term .
    var  InitSEState                                        : String . 
    var  SearchCond                                         : Condition .
    var  Bound                                              : Bound .
    var  SolN                                               : Nat .
    var  NeModIdList                                        : NeQidList .
    var  M                                                  : Module .
    var  SVDeclL                                            : PairSVarL .
    var  SymbCond                                           : Boolean .
    var  VariantOpSet                                       : VariantOptionSet .

    op searchTr : Module Qid TrType Qid String Term Condition Qid Bound Nat PairSVarL Boolean -> ResultTriple .
    eq searchTr(M, StateOp, TrId, TargetSt,
                  InitSEState,
                  PatternSEState,
                  SearchCond,
                  SearchType,
                  Bound,
                  SolN,
                  SVDeclL,
                  SymbCond)
                  =
                  metaSearch(transformModSymb(M, StateOp, TrId),
                             'startC['_where_[getTerm(metaParse(M,
                                                                 tokenize(InitSEState),
                                                                 StateOp)),
                                              trVal(upTerm(SymbCond), TrId)],
                                     trVal(upTerm(SVDeclL), TrId)],
                             PatternSEState,
                             SearchCond,
                             SearchType,
                             Bound,
                             SolN) .
    
    op searchPathTr : Module Qid TrType Qid String Term Condition Qid Bound Nat PairSVarL Boolean -> Trace? .
    eq searchPathTr(M, StateOp, TrId, TargetSt,
                    InitSEState,
                    PatternSEState,
                    SearchCond,
                    SearchType,
                    Bound,
                    SolN,
                    SVDeclL,
                    SymbCond)
                    =
                    metaSearchPath(transformModSymb(M, StateOp, TrId),
                                   'startC['_where_[getTerm(metaParse(M,
                                                                       tokenize(InitSEState),
                                                                       StateOp)),
                                                    trVal(upTerm(SymbCond), TrId)],
                                           trVal(upTerm(SVDeclL), TrId)],
                                   PatternSEState,
                                   SearchCond,
                                   SearchType,
                                   Bound,
                                   SolN) .
    
    op searchSymb : Module Qid String Term Condition Qid Bound Nat PairSVarL Boolean -> ResultTriple .
    eq searchSymb(M, StateOp,
                  InitSEState,
                  PatternSEState,
                  SearchCond,
                  SearchType,
                  Bound,
                  SolN,
                  SVDeclL,
                  SymbCond)
                  = searchTr(M, StateOp, symb, 'SEState,
                             InitSEState,
                             PatternSEState,
                             SearchCond,
                             SearchType,
                             Bound,
                             SolN,
                             SVDeclL,
                             SymbCond) .

    op searchConcolic : Module Qid String Term Condition Qid Bound Nat PairSVarL Boolean -> ResultTriple .
    eq searchConcolic(M, StateOp,
                      InitSEState,
                      PatternSEState,
                      SearchCond,
                      SearchType,
                      Bound,
                      SolN,
                      SVDeclL,
                      SymbCond)
                      = searchTr(M, StateOp, conc, 'ConcolicState,
                                 InitSEState,
                                 PatternSEState,
                                 SearchCond,
                                 SearchType,
                                 Bound,
                                 SolN,
                                 SVDeclL,
                                 SymbCond) .

    op searchPathConcolic : Module Qid String Term Condition Qid Bound Nat PairSVarL Boolean -> Trace? .
    eq searchPathConcolic(M, StateOp,
                          InitSEState,
                          PatternSEState,
                          SearchCond,
                          SearchType,
                          Bound,
                          SolN,
                          SVDeclL,
                          SymbCond)
                          = searchPathTr(M, StateOp, conc, 'ConcolicState,
                                         InitSEState,
                                         PatternSEState,
                                         SearchCond,
                                         SearchType,
                                         Bound,
                                         SolN,
                                         SVDeclL,
                                         SymbCond) .

    op searchNarrowing : Module Qid String Term Qid Bound Qid VariantOptionSet Nat PairSVarL -> NarrowingSearchResult? .
    eq searchNarrowing(M, StateOp,
                        InitSEState,
                        PatternSEState,
                        SearchType,
                        Bound,
                        FoldQ,
                        VariantOpSet,
                        SolN,
                        SVDeclL)
                        = metaNarrowingSearch(transformModSymb(M, StateOp, narrowing),
                                              'startSE[getTerm(metaParse(M,
                                                                        tokenize(InitSEState),
                                                                        StateOp)),
                                                      trVal(upTerm(SVDeclL), narrowing),
                                                      '_|_['empty.IStoreN, 'empty.BStoreN]],
                                              PatternSEState,
                                              SearchType,
                                              Bound,
                                              FoldQ,
                                              VariantOpSet,
                                              SolN) .

    op searchPathNarrowing : Module Qid String Term Qid Bound Qid VariantOptionSet Nat PairSVarL -> NarrowingSearchPathResult? .
    eq searchPathNarrowing(M, StateOp,
                            InitSEState,
                            PatternSEState,
                            SearchType,
                            Bound,
                            FoldQ,
                            VariantOpSet,
                            SolN,
                            SVDeclL)
                            = metaNarrowingSearchPath(transformModSymb(M, StateOp, narrowing),
                                                      'startSE[getTerm(metaParse(M,
                                                                                tokenize(InitSEState),
                                                                                StateOp)),
                                                              trVal(upTerm(SVDeclL), narrowing),
                                                              '_|_['empty.IStoreN, 'empty.BStoreN]],
                                                      PatternSEState,
                                                      SearchType,
                                                      Bound,
                                                      FoldQ,
                                                      VariantOpSet,
                                                      SolN) .
endm

mod MAUDE-SE-EXT is

    pr VERIFICATION-COMMANDS .
    pr META-SMT-SEARCH . 

    vars StateOp PrOp ValOp TrId SearchType Logic Q : Qid .
    var  PatternSEState                           : Term .
    var  InitSEState                              : String . 
    var  SearchCond                               : Condition .
    var  Bound                                    : Bound .
    var  SolN                                     : Nat .
    var  NeModIdList                              : NeQidList .
    var  Fold                                     : Bool .
    vars  M SM                                        : Module .
    var  SVDeclL                                  : PairSVarL .

    op searchMaudeSE : Module Qid String Term Condition Qid Bound Nat Qid Bool PairSVarL -> SmtResult2? .
  ***  eq searchMaudeSE(M, StateOp,
  ***                   InitSEState,
  ***                   PatternSEState,
  ***                   SearchCond,
  ***                   SearchType,
  ***                   Bound,
  ***                   SolN,
  ***                   Logic, Fold,
  ***                   SVDeclL)
  ***                   = metaSmtSearch(downTerm(getTerm(metaReduce(
  ***                                                      trWithStructsPrM(upModule('SEM-TR, true), 'WHILE-MAUDE), 
  ***                                                      upTerm(transformModSymb(upModule('WHILE-MAUDE, true), 'State, 'placeholderVal, symb))
  ***                                                    )
  ***                                            ), 
  ***                                            err:Module) ***transformModSymb(M, StateOp, maudeSE),
  ***                                  'startSE[getTerm(metaParse(transformModSymb(M, StateOp, maudeSE),
  ***                                                                              tokenize(InitSEState),
  ***                                                                              StateOp)),
  ***                                                              trVal(upTerm(SVDeclL), maudeSE), 
  ***                                                              '_|_|_['empty.IStoreS, 'empty.RStoreS, 'empty.BStoreS]],
  ***                                   PatternSEState,
  ***                                   modCond(SearchCond, maudeSE),
  ***                                   SearchType,
  ***                                   Bound,
  ***                                   SolN,
  ***                                   Logic, Fold) .
    
    op searchMaudeSESimple : Qid Qid String Term Condition Qid Bound Nat Qid Bool -> SmtResult2? .
    ceq searchMaudeSESimple(Q, StateOp,
                            InitSEState,
                            PatternSEState,
                            SearchCond,
                            SearchType,
                            Bound,
                            SolN,
                            Logic, Fold)
                            = metaSmtSearch(SM,
                                            getTerm(metaParse(SM, 
                                                              tokenize(InitSEState), 
                                                              'State)),
                                            PatternSEState,
                                            *** Conditions must be on SMT form
                                            SearchCond,
                                            SearchType,
                                            Bound,
                                            SolN,
                                            Logic, Fold)
    if SM := downTerm(getTerm(metaReduceMetaMod(upModule('SEM-TR, true), Q, 
                                                'transformModSymb['upModule[upTerm(Q), 'true.Bool], upTerm(StateOp), 'maudeSE.TrType]
                                              )
                              ), 
                      errM) .

    op searchMaudeSESimplePath : Qid Qid String Term Condition Qid Bound Nat Qid Bool -> Trace2Result? .
    ceq searchMaudeSESimplePath(Q, StateOp,
                            InitSEState,
                            PatternSEState,
                            SearchCond,
                            SearchType,
                            Bound,
                            SolN,
                            Logic, Fold)
                            = metaSmtSearchPath(SM,
                                            getTerm(metaParse(SM, 
                                                              tokenize(InitSEState), 
                                                              'State)),
                                            PatternSEState,
                                            *** Conditions must be on SMT form
                                            SearchCond,
                                            SearchType,
                                            Bound,
                                            SolN,
                                            Logic, Fold)
    if SM := downTerm(getTerm(metaReduceMetaMod(upModule('SEM-TR, true), Q, 
                                                'transformModSymb['upModule[upTerm(Q), 'true.Bool], upTerm(StateOp), 'maudeSE.TrType]
                                              )
                              ), 
                      errM) .
    
    op errM : -> Module [ctor] .
    op errC : -> Condition [ctor] .

    op searchPathMaudeSE : Module Qid String Term Condition Qid Bound Nat Qid Bool PairSVarL -> Trace2Result? .
    ***eq searchPathMaudeSE(M, StateOp,
    ***                     InitSEState,
    ***                     PatternSEState,
    ***                     SearchCond,
    ***                     SearchType,
    ***                     Bound,
    ***                     SolN,
    ***                     Logic, Fold,
    ***                     SVDeclL)
    ***                     = metaSmtSearchPath(transformModSymb(M, StateOp, maudeSE),
    ***                                         'startSE[getTerm(metaParse(transformModSymb(M, StateOp, maudeSE),
    ***                                                                              tokenize(InitSEState),
    ***                                                                              StateOp)),
    ***                                                            trVal(upTerm(SVDeclL), maudeSE), 
    ***                                                            '_|_|_['empty.IStoreS, 'empty.RStoreS, 'empty.BStoreS]],
    ***                                         PatternSEState,
    ***                                         modCond(SearchCond, maudeSE),
    ***                                         SearchType,
    ***                                         Bound,
    ***                                         SolN,
    ***                                         Logic, Fold) .
endm
