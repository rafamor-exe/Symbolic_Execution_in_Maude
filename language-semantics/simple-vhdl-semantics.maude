  *** isStable prototype as an eval funtion
  op isStable : Time Time StdlSignalName StdlVal List{Transaction<=} VHDLCompleteSim -> Bool [metadata "evalF"] .
  eq isStable(T, 0 ns, Stdlsg, StdlVal, EventSchSList, VHDLCompleteSim) = true .
  eq isStable(T, NzTDelay, Stdlsg, StdlVal, nil, VHDLCompleteSim) = true .
  *** Same sg same val
  eq isStable(T, NzTDelay, Stdlsg, StdlVal, ({scheduledEvent: time T', args {sgName Stdlsg, value StdlVal}} EventSchSList), VHDLCompleteSim) = 
    isStable(T, NzTDelay, Stdlsg, StdlVal, EventSchSList, VHDLCompleteSim) .
  *** Different sg whatever val
  ***ceq isStable(T, NzTDelay, Stdlsg, StdlVal, ({scheduledEvent: time T', args {sgName Stdlsg2, value StdlVal2}} EventSchSList), VHDLCompleteSim) = 
  ***  isStable(T, NzTDelay, Stdlsg, StdlVal, EventSchSList, VHDLCompleteSim) if Stdlsg =/= Stdlsg2 .
  *** NOTE: Changed Stdlsg2 to Stdlsg, because we are only interested in same-signal changes...
  eq isStable(T, NzTDelay, Stdlsg, StdlVal, ({scheduledEvent: time T', args {sgName Stdlsg, value StdlVal2}} EventSchSList), VHDLCompleteSim) = 
    if (timeVal(T) < timeVal(T')) == val(true) and (timeVal(T') <= (timeVal(T) + timeVal(NzTDelay))) == val(true) then
      *** NOTE: Instead of directly false, we delegate on cbeval (and sbeval), the last word depends on whether the value is the same
      ***       If any value in the range is different, then it would be false
      cbeval(StdlVal = StdlVal2, VHDLCompleteSim) and isStable(T, NzTDelay, Stdlsg, StdlVal, EventSchSList, VHDLCompleteSim) *** false
    else
      isStable(T, NzTDelay, Stdlsg, StdlVal, EventSchSList, VHDLCompleteSim)
    fi .
  eq isStable(T, NzTDelay, Stdlsg, StdlVal, ({scheduledEvent: time T', args {sgName Stdlsg2, value StdlVal2}} EventSchSList), VHDLCompleteSim) = 
        isStable(T, NzTDelay, Stdlsg, StdlVal, EventSchSList, VHDLCompleteSim) [owise] .

  *** ------------
  *** lookup: auxiliar op to lookup values from signal store
  ***op lookup : Map{String, Value} String -> Value .
  *** lookup-sg must be an eq to be able to evaluate it everywhere
  *** lookup signal from signal store
  op lookup-sg : BitTStore StdlSgTimeTuple -> BitVal .
  eq lookup-sg(BitSgSTR, StdlSgTimeTuple) = BitSgSTR[StdlSgTimeTuple] .
  op lookup-sg : ITStore ISgTimeTuple -> IVal .
  eq lookup-sg(ISgSTR, ISgTimeTuple) = ISgSTR[ISgTimeTuple] .
  op lookup-sg : StdlTStore StdlSgTimeTuple -> StdlVal .
  eq lookup-sg(StdlSgSTR, StdlSgTimeTuple) = StdlSgSTR[StdlSgTimeTuple] .
  op lookup-sg : BTStore BSgTimeTuple -> BVal .
  eq lookup-sg(BSgSTR, BSgTimeTuple) = BSgSTR[BSgTimeTuple] .

  op lookup-sg : Stores StdlSgTimeTuple -> BitVal .
  eq lookup-sg((BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), StdlSgTimeTuple) = BitSgSTR[StdlSgTimeTuple] .
  op lookup-sg : Stores ISgTimeTuple -> IVal .
  eq lookup-sg((BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), ISgTimeTuple) = ISgSTR[ISgTimeTuple] .
  op lookup-sg : Stores StdlSgTimeTuple -> StdlVal .
  eq lookup-sg((BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), StdlSgTimeTuple) = StdlSgSTR[StdlSgTimeTuple] .
  op lookup-sg : Stores BSgTimeTuple -> BVal .
  eq lookup-sg((BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), BSgTimeTuple) = BSgSTR[BSgTimeTuple] .
  
  op insert : ISgTimeTuple IVal Stores -> Stores .
  eq insert({sgName Isg, time T}, IVal, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = (BitSgSTR | insert({sgName Isg, time T}, IVal, ISgSTR) | StdlSgSTR | BSgSTR) .
  op insert : StdlSgTimeTuple BitVal Stores -> Stores .
  eq insert({sgName Bitsg, time T}, BitVal, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = (insert({sgName Bitsg, time T}, BitVal, BitSgSTR) | ISgSTR | StdlSgSTR | BSgSTR) .
  op insert : StdlSgTimeTuple StdlVal Stores -> Stores .
  eq insert({sgName Stdlsg, time T}, StdlVal, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = (BitSgSTR | ISgSTR | insert({sgName Stdlsg, time T}, StdlVal, StdlSgSTR) | BSgSTR) .
  op insert : BSgTimeTuple BVal Stores -> Stores .
  eq insert({sgName Bsg, time T}, BVal, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = (BitSgSTR | ISgSTR | StdlSgSTR | insert({sgName Bsg, time T}, BVal, BSgSTR)) .
  
  ***eq lookup(STR, Str) = STR[Str] .

