  ***eq evalA(AExp1 - AExp2, T, SgSTR) = evalA(AExp1, T, SgSTR) - evalA(AExp2, T, SgSTR) .
  ***eq evalA(AExp1 * AExp2, T, SgSTR) = evalA(AExp1, T, SgSTR) * evalA(AExp2, T, SgSTR) .
