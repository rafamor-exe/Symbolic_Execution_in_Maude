  ***                          else
  ***                            if Val =/= fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)[{sgName Stdlsg, time T}] then
  ***                              < clk(Tnext) [prev: clk(T)] | nil >< schOnTime(SchListCp, Tnext) || ({scheduledEvent: time T', args SgState } EventSchSList) > << fill-blanks-next-ev(sw(Stdlsg), get-sgL(SgDescSTR), insert({sgName Stdlsg, time Tnext}, Val, fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)), Tnext, T) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(sw(Stdlsg), true, SgChangedMap) } {wholeExec: SchListCp} InputChangeSim
  ***                            else
  ***                              < clk(Tnext) [prev: clk(T)] | nil >< nil || ({scheduledEvent: time T', args SgState } EventSchSList) > << fill-blanks-next-ev(sw(Stdlsg), get-sgL(SgDescSTR), insert({sgName Stdlsg, time Tnext}, Val, fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)), Tnext, T) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
