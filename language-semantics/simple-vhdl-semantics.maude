*** Simplified and adapted version of VHDL semantics in Maude to the framework based on previous work:
***   https://github.com/rafamor-exe/Semantics_of_VHDL_in_Maude

*** LIMITATIONS
*** Process sensitivity lists have to wrap signal names with sw()

load ../semantics-basics/semantics-basics-gen.maude
load ../semantics-basics/semantics-std_logic-gen.maude

fmod VHDL-IODEF-MOD is

  *** Define value and IO types

  protecting STRING .

  sorts IODef IOType Type SgDesc IntType TimeType BoolType StdlType .
  *** TODO: Should we separate Type markers? Conflict with _'LOW and _'LEFT operators
  ***subsorts IntType TimeType BoolType StdlType < Type .

  ops in out inout : -> IOType [ctor] .
  op bool : -> BoolType [ctor] .
  ops 'std_logic bit : -> StdlType [ctor] .
  ops time : -> TimeType [ctor] .
  *** natural and positive are subtypes of integer
  ops integer natural positive : -> IntType [ctor] .

  *** SgDesc is a tuple containing the types of a signal
  op {_$_} : IOType IntType -> SgDesc [ctor] .
  op {_$_} : IOType TimeType -> SgDesc [ctor] .
  op {_$_} : IOType BoolType -> SgDesc [ctor] .
  op {_$_} : IOType StdlType -> SgDesc [ctor] .

  *** IODef is the declaration of a component taking into account value and IO types
  op _:__; : String IOType IntType -> IODef [ctor] .
  op _:__; : String IOType TimeType -> IODef [ctor] .
  op _:__; : String IOType BoolType -> IODef [ctor] .
  op _:__; : String IOType StdlType -> IODef [ctor] .

endfm

view IODef from TRIV to VHDL-IODEF-MOD is
  sort Elt to IODef .
endv

view SgDesc from TRIV to VHDL-IODEF-MOD is
  sort Elt to SgDesc .
endv

view IOType from TRIV to VHDL-IODEF-MOD is
  sort Elt to IOType .
endv

fmod VHDL-VALUE-MOD is

  protecting INT .
  ***protecting STRING .
  protecting VHDL-IODEF-MOD .

  protecting CONCRETE-STDLVAL .
  protecting CONCRETE-EXP .

  sorts TVal . *** StdLogic Value IVal StdlVal NatVal PosVal BVal BitVal NumVal .
  sorts PhysVal Time TimeUnit TimeDelta Delta NzTime . *** Bit StdLogicAux .
  ***sorts To1 To0 .
  ***subsorts BitVal BVal PosVal NatVal IVal StdlVal TVal < Value .
  ***subsorts Bit StdLogicAux < StdLogic .
  subsorts NzTime TimeDelta < Time .
  subsorts TVal < PhysVal .
  ***subsorts IVal PhysVal < NumVal .

  ***op val : Bit -> BitVal [ctor] .
  ***op val : Int -> IVal [ctor] .
  ***op val : StdLogic -> StdlVal [ctor] .
  op timeVal : Time -> TVal [ctor] .
  ***op natVal : Nat -> NatVal [ctor] .
  ***op posVal : NzNat -> PosVal [ctor] .
  ***op val : Bool -> BVal [ctor] .

  var BitVal : BitVal .
  var IVal : IVal .
  var StdlVal : StdlVal .
  var TVal : TVal .
  var BVal : BVal .
  ***var NatVal : NatVal .

  op get-typeVal : BitVal -> StdlType .
  op get-typeVal : IVal -> IntType .
  op get-typeVal : StdlVal -> StdlType .
  op get-typeVal : TVal -> TimeType .
  op get-typeVal : BVal -> BoolType .
  eq get-typeVal(BitVal) = bit .
  eq get-typeVal(IVal) = integer .
  eq get-typeVal(StdlVal) = 'std_logic .
  eq get-typeVal(TVal) = time .
  eq get-typeVal(BVal) = bool .
  ***eq get-typeVal(NatVal) = natural .

  ops TRUE FALSE : -> BVal [ctor] .
  eq TRUE = val(true) .
  eq FALSE = val(false) .

  *** Bit logic

  ***ops '0' '1' : -> Bit [ctor] .
  ***ops 'Z' 'W' 'L' 'H' : -> StdLogicAux [ctor] .
  ***ops 'U' 'X' '-' : -> StdLogic [ctor] .

  *** Time

  ops hr min sec ms us ns ps fs : -> TimeUnit [ctor] .
  op __ : Int TimeUnit -> Time [ctor] .

  vars T T1 T2 : Time .
  vars N1 N2 : Nat .
  var TUnit : TimeUnit .
  vars TDelta1 TDelta2 : Delta .

  *** operations will be done with fs
  op to-fs : Time -> Time [ctor] .

  var R R1 R2 : Int .
  eq to-fs((R TUnit) + TDelta1) = (R TUnit) + TDelta1 .
  eq to-fs(R fs) = R fs .
  eq to-fs(R ps) = to-fs((R * 1000) fs) .
  eq to-fs(R ns) = to-fs((R * 1000) ps) .
  eq to-fs(R us) = to-fs((R * 1000) ns) .
  eq to-fs(R ms) = to-fs((R * 1000 ) us) .
  eq to-fs(R sec) = to-fs((R * 1000) ms) .
  eq to-fs(R min) = to-fs((R * 60) sec) .
  eq to-fs(R hr) = to-fs((R * 60) min) .

  *** Delta delays
  op delta : Nat -> Delta [ctor] .
  op delta : -> Delta [ctor] .
  eq delta = delta(1) .
  op _ + _ : Time Delta -> TimeDelta [ctor] .

  op _+_ : Delta Delta -> Delta [assoc comm ctor] .

  op get-val-time : Time -> Int .
  eq get-val-time(R TUnit) = R .
  eq get-val-time((R TUnit) + TDelta1) = R .

  eq delta(N1) + delta(N2) = delta(N1 + N2) .
  eq (T + TDelta1) + TDelta2 = T + (TDelta1 + TDelta2) .

  op min : Time Time -> Time .
  ceq min(R1 TUnit, R2 TUnit) = R1 TUnit if R1 <= R2 .
  eq min(R1 TUnit, R2 TUnit) = R2 TUnit [owise] .

  var NzR : NzInt .
  mb NzR TUnit : NzTime .

  ***var StdLogic : StdLogic .
  ***mb 'H' : To1 .
  ***mb '1' : To1 . 
  ***mb 'L' : To0 .
  ***mb '0' : To0 . 

endfm

***view Value from TRIV to VHDL-VALUE-MOD is
***  sort Elt to Value .
***endv

view TVal from TRIV to VHDL-VALUE-MOD is
  sort Elt to TVal .
endv

fmod VHDL-GENERIC-MOD is

  ***protecting STRING .
  protecting QID .
  protecting VHDL-IODEF-MOD .
  protecting VHDL-VALUE-MOD .

  sorts GenDef .

  *** TODO: Eventually use Qid instead of String
  op _: _ := _; : String StdlType BitVal -> GenDef [ctor] .
  op _: _ := _; : String IntType IVal -> GenDef [ctor] .
  op _: _ := _; : String StdlType StdlVal -> GenDef [ctor] .
  op _: _ := _; : String TimeType TVal -> GenDef [ctor] .
  op _: _ := _; : String BoolType BVal -> GenDef [ctor] .

endfm

view GenDef from TRIV to VHDL-GENERIC-MOD is
  sort Elt to GenDef .
endv

fmod VHDL-INSTCOLON-MOD is

  protecting VHDL-IODEF-MOD .
  protecting VHDL-VALUE-MOD .
  protecting VHDL-GENERIC-MOD .
  protecting LIST{IODef} .
  protecting LIST{GenDef} .
  

  sorts Inst Inst; EntityInst EntityInstColon Port VarConstName SgDecl SgAssign TExp Term Op CompOp Generic DelayMechanism . *** AExp SignalName
  sorts PhysNumBinOp NumUnOp IBinOp NumBinOp .
  sorts ISignalName BitSignalName StdlSignalName BSignalName TSignalName .
  sorts SignalWrapper .
  subsorts Port Generic < EntityInst .
  subsorts EntityInst SgDecl SgAssign < Inst .
  *** The following order causes Advisory messages on loading the module
  ***subsorts EntityInstColon < InstColon .
  ***subsorts String < SignalName VarConstName .

  ***subsorts Value SignalName < AExp .

  subsorts NumBinOp < IBinOp .
  subsorts NumBinOp < PhysNumBinOp .
  subsorts CompOp < Op .

  subsorts ISignalName < IExp .
  *** TODO: Separate BitExp from StdlExp?? Currently only StdlExp
  subsorts BitSignalName < StdlSignalName < StdlExp .
  subsorts BSignalName < BExp .
  subsorts TSignalName < TExp .
  ***subsorts ISignalName BitSignalName StdlSignalName BSignalName TSignalName < SignalName .

  *** Added type marker to separate expressions
  op Isg : String -> ISignalName [ctor] .
  op Bitsg : String -> BitSignalName [ctor] .
  op Stdlsg : String -> StdlSignalName [ctor] .
  op Bsg : String -> BSignalName [ctor] .
  op Tsg : String -> TSignalName [ctor] .

  *** TODO: Manage this at syntax level
  op sw : ISignalName -> SignalWrapper [ctor] .
  op sw : BitSignalName -> SignalWrapper [ctor] .
  op sw : StdlSignalName -> SignalWrapper [ctor] .
  op sw : BSignalName -> SignalWrapper [ctor] .
  op sw : TSignalName -> SignalWrapper [ctor] .

  ***ops and or nand nor xnor xor : -> Op [ctor] . 
  ops = /= < > "<=" ">=" : -> CompOp [ctor] .
  ***ops -_ : IVal -> AExp [ctor prec 20] . ***+_
  ***ops -_ : PhysVal -> AExp [ctor prec 20] . ***+_
  op abs(_) : IVal -> IVal [ctor prec 14] .
  op abs(_) : PhysVal -> PhysVal [ctor prec 14] .
  ***ops + - : -> NumBinOp [ctor] .
  ***ops * / mod rem ** : -> IBinOp [ctor] .

  vars Op : Op .
  ***vars SignalW : SignalName .
  var EntityI : EntityInst .

  op _; : Inst -> Inst; [ctor prec 24].
  ***mb (EntityI ;) : EntityInstColon .
  ***op _; : EntityInst -> EntityInstColon [ctor] .

  *** Instruction ops declarations (no dependency on instruction lists)
  *** - Test nop
  op nop : -> Inst [ctor] .
  *** - Port
  op port (_) : NeList{IODef} -> Port [ctor] .
  *** - Generic
  op generic (_) : NeList{GenDef} -> Generic [ctor] .


  ops transport inertial : -> DelayMechanism [ctor] .

  *** NOTE: Used <=| instead of <= to avoid collision with comparison operator <=
  op _ <=| _ _ after _ : ISignalName DelayMechanism IExp Time -> SgAssign [ctor prec 23] .
  op _ <=| _ _ after _ : BitSignalName DelayMechanism StdlExp Time -> SgAssign [ctor prec 23] .
  op _ <=| _ _ after _ : StdlSignalName DelayMechanism StdlExp Time -> SgAssign [ctor prec 23] .
  op _ <=| _ _ after _ : BSignalName DelayMechanism BExp Time -> SgAssign [ctor prec 23] .
  op _ <=| _ _ after _ : TSignalName DelayMechanism TExp Time -> SgAssign [ctor prec 23] .
  op _ <=| _ after _ : ISignalName IExp Time -> SgAssign [ctor prec 23] .
  op _ <=| _ after _ : BitSignalName StdlExp Time -> SgAssign [ctor prec 23] .
  op _ <=| _ after _ : StdlSignalName StdlExp Time -> SgAssign [ctor prec 23] .
  op _ <=| _ after _ : BSignalName BExp Time -> SgAssign [ctor prec 23] .
  op _ <=| _ after _ : TSignalName TExp Time -> SgAssign [ctor prec 23] .
  op _ <=| _ : ISignalName IExp -> SgAssign [ctor prec 23] .
  op _ <=| _ : BitSignalName StdlExp -> SgAssign [ctor prec 23] .
  op _ <=| _ : StdlSignalName StdlExp -> SgAssign [ctor prec 23] .
  op _ <=| _ : BSignalName BExp -> SgAssign [ctor prec 23] .
  op _ <=| _ : TSignalName TExp -> SgAssign [ctor prec 23] .

  ***vars Value Value1 Value2 : Value .
  vars StdlVal StdLogicVal1 StdLogicVal2 : StdlVal .
  vars BVal BoolVal1 BoolVal2 : BVal .
  vars BitVal BitVal1 BitVal2 : BitVal .
  vars IVal IntVal1 IntVal2 : IVal .
  vars Int1 Int2 : Int .
  vars B1 B2 : Bool .
  vars Bit1 Bit2 : Bit .
  ***vars StdLogic StdLogic1 StdLogic2 : StdLogic .
  ***var ZWLH : StdLogicAux .
  ***var To0 : To0 .
  ***var To1 : To1 .
  ***vars AExp1 AExp2 : AExp .
  vars T T1 T2 : Time .
  vars R R1 R2 : Int .
  vars TUnit TUnit1 TUnit2 : TimeUnit . 
  vars TVal TVal2 : TVal .
  var CompOp : CompOp .

  ***op _=_ : TVal TVal -> BVal [gather (e E) prec 59] .
  ***op _/=_ : TVal TVal -> BVal [gather (e E) prec 59] .
  op _<_ : TVal TVal -> BVal [gather (e E) prec 59] .
  op _<=_ : TVal TVal -> BVal [gather (e E) prec 59] .
  op _>_ : TVal TVal -> BVal [gather (e E) prec 59] .
  op _>=_ : TVal TVal -> BVal [gather (e E) prec 59] .

  ***eq (timeVal(R1 TUnit) = timeVal(R2 TUnit)) = val(R1 == R2) .
  ***eq TVal /= TVal2 = not (TVal = TVal2) .
  eq (timeVal(R1 TUnit) < timeVal(R2 TUnit)) = val(R1 < R2) .
  eq (timeVal(R1 TUnit) <= timeVal(R2 TUnit)) = val(R1 <= R2) .
  eq (timeVal(R1 TUnit) > timeVal(R2 TUnit)) = val(R1 > R2) .
  eq (timeVal(R1 TUnit) >= timeVal(R2 TUnit)) = val(R1 >= R2) .
  ***eq (timeVal(T1) CompOp timeVal(T2)) = val(get-val-time(to-fs(T1))) CompOp val(get-val-time(to-fs(T2))) [owise] .
  ***eq (timeVal(R1 TUnit) = timeVal(R2 TUnit)) = val(get-val-time(to-fs(T1))) == val(get-val-time(to-fs(T2))) [owise] .
  eq (timeVal(T1) < timeVal(T2)) = val(get-val-time(to-fs(T1)) < get-val-time(to-fs(T2))) [owise] .
  eq (timeVal(T1) <= timeVal(T2)) = val(get-val-time(to-fs(T1)) <= get-val-time(to-fs(T2))) [owise] .
  eq (timeVal(T1) > timeVal(T2)) = val(get-val-time(to-fs(T1)) > get-val-time(to-fs(T2))) [owise] .
  eq (timeVal(T1) >= timeVal(T2)) = val(get-val-time(to-fs(T1)) >= get-val-time(to-fs(T2))) [owise] .

  ***op __ : NumUnOp IVal -> AExp [ctor] .
  op _+_ : TVal TVal -> TVal [ctor assoc comm prec 18] .
  op _-_ : TVal TVal -> TVal [ctor assoc prec 18] .
  op _*_ : TVal TVal -> TVal [ctor assoc comm prec 16] .
  op _/_ : TVal TVal -> TVal [ctor assoc prec 16] .
  op _rem_ : TVal TVal -> TVal [ctor assoc prec 16] .
  op _mod_ : TVal TVal -> TVal [ctor assoc prec 16] .
  op _**_ : TVal TVal -> TVal [ctor assoc prec 15] .
  op _+_ : TExp TExp -> TExp [ctor assoc comm prec 18] .
  op _-_ : TExp TExp -> TExp [ctor assoc prec 18] .
  op _*_ : TExp TExp -> TExp [ctor assoc comm prec 16] .
  op _/_ : TExp TExp -> TExp [ctor assoc prec 16] .
  op _rem_ : TExp TExp -> TExp [ctor assoc prec 16] .
  op _mod_ : TExp TExp -> TExp [ctor assoc prec 16] .
  op _**_ : TExp TExp -> TExp [ctor assoc prec 15] .

  ***eq + val(Int1) = val(+ Int1) .  
  ***eq - val(Int1) = val(- Int1) .
  ***eq abs(val(Int1)) = val(abs(Int1)) .

  ***eq val(Int1) + val(Int2) = val(Int1 + Int2) .
  ***eq val(Int1) - val(Int2) = val(Int1 - Int2) .
  ***eq val(Int1) * val(Int2) = val(Int1 * Int2) .
  ***eq val(Int1) / val(Int2) = val(Int1 quo Int2) .
  *** By definition of the Standard: A rem B is the remainder with the sign of A (which coincides with rem operator in Maude).
  ***eq val(Int1) rem val(Int2) = val(Int1 rem Int2) .
  *** By definition of the Standard: A mod B is the remainder with the sign of B.
  ***eq val(Int1) mod val(Int2) = val((Int2 / abs(Int2))*(Int1 / abs(Int1))*(Int1 rem Int2)) .
  ***eq val(Int1) ** val(Int2) = val(Int1 ^ Int2) .

  ***op __ : NumUnOp PhysVal -> AExp [ctor] .
  ***eq - timeVal(R TUnit1) = timeVal((- R) TUnit1) .
  eq abs(timeVal(R TUnit1)) = timeVal(abs(R) TUnit1) .

  ***op ___ : PhysVal PhysNumBinOp PhysVal -> PhysVal [ctor] .
  ***op _+_ : AExp AExp -> AExp [ctor assoc comm] .
  ***op _-_ : AExp AExp -> AExp [ctor assoc] .
  eq timeVal(T1) + timeVal(T2) = timeVal((get-val-time(to-fs(T1)) + get-val-time(to-fs(T2))) fs) .
  eq timeVal(T1) - timeVal(T2) = timeVal((get-val-time(to-fs(T1)) - get-val-time(to-fs(T2))) fs) .

  op get-time : TVal -> Time .
  eq get-time(timeVal(T1)) = T1 .

endfm

view Inst; from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to Inst; .
endv

view EntityInstColon from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to EntityInstColon .
endv

view SignalWrapper from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to SignalWrapper .
endv

view ISignalName from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to ISignalName .
endv
view BitSignalName from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to BitSignalName .
endv
view StdlSignalName from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to StdlSignalName .
endv
view BSignalName from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to BSignalName .
endv
view TSignalName from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to TSignalName .
endv

fmod VHDL-ATTRIBUTES-MOD is

  *** Define Attribute functions over types and components

  protecting VHDL-INSTCOLON-MOD .
  protecting VHDL-VALUE-MOD .

  sorts Attr TypeAttr ObjAttr TOAttr .
  subsorts TOAttr < TypeAttr ObjAttr .

  op _ ' ASCENDING : IntType -> BVal .
  op _ ' ASCENDING : StdlType -> BVal .
  op _ ' ASCENDING : BoolType -> BVal .
  op _ ' ASCENDING : TimeType -> BVal .
  op _ ' LOW : IntType -> IVal .
  op _ ' LOW : StdlType -> StdlVal .
  op _ ' LOW : BoolType -> BVal .
  op _ ' LOW : TimeType -> TVal .
  op _ ' HIGH : IntType -> IVal .
  op _ ' HIGH : StdlType -> StdlVal .
  op _ ' HIGH : BoolType -> BVal .
  op _ ' HIGH : TimeType -> TVal .
  op _ ' LEFT : IntType -> IVal .
  op _ ' LEFT : StdlType -> StdlVal .
  op _ ' LEFT : BoolType -> BVal .
  op _ ' LEFT : TimeType -> TVal .
  ***op _ ' _ : SignalName ObjAttr -> Value .
  
  ***op _ ' _ : VarName ObjAttr -> Value .

  ***ops ASCENDING LEFT RIGHT HIGH LOW : -> TypeAttr [ctor] .

  var T : Type .
  var IntT : IntType .
  var StdlT : StdlType .
  var BoolT : BoolType .
  var TimeT : TimeType .

  eq IntT ' ASCENDING = val(true) .
  eq 'std_logic ' ASCENDING = val(true) .
  eq bit ' ASCENDING = val(true) .
  eq time ' ASCENDING = val(true) .

  eq integer ' LOW = val(-2147483648) .
  ***eq natural ' LOW = natVal(0) .
  ***eq positive ' LOW = posVal(1) .
  eq bit ' LOW = val(0) .
  eq 'std_logic ' LOW = val(U) .
  eq time ' LOW = timeVal(-(2 ^ (63)) fs) .

  *** T'LEFT is equivalent to T'LOW if the type is ASCENDING 
  ceq IntT ' LEFT = IntT ' LOW if (IntT ' ASCENDING) == val(true) .
  ceq StdlT ' LEFT = StdlT ' LOW if (StdlT ' ASCENDING) == val(true) .
  ceq BoolT ' LEFT = BoolT ' LOW if (BoolT ' ASCENDING) == val(true) .
  ceq TimeT ' LEFT = TimeT ' LOW if (TimeT ' ASCENDING) == val(true) .
  eq IntT ' LEFT = IntT ' HIGH [owise] .
  eq StdlT ' LEFT = StdlT ' HIGH [owise] .
  eq BoolT ' LEFT = BoolT ' HIGH [owise] .
  eq TimeT ' LEFT = TimeT ' HIGH [owise] .
  
endfm

fmod VHDL-SCHEDULE-MOD is

  protecting VHDL-VALUE-MOD .
  protecting VHDL-INSTCOLON-MOD .

  sorts ScheduledInst Transaction SignalState . *** SgTimeTuple
  sorts ISgTimeTuple BSgTimeTuple StdlSgTimeTuple BitSgTimeTuple .

  *** An ScheduledInst contains the instruction to be executed and the delay
  *** TODO: check if it would be more accurate to just delay an assignment (delay,sg,value)
  op {scheduledInst: time _, inst _} : Time Inst; -> ScheduledInst [ctor] .

  *** Transactions (ScheduledEvents) relate time and value for a certain signal
  op {sgName _, value _} : ISignalName IVal -> SignalState [ctor] .
  op {sgName _, value _} : BitSignalName BitVal -> SignalState [ctor] .
  op {sgName _, value _} : StdlSignalName StdlVal -> SignalState [ctor] .
  op {sgName _, value _} : BSignalName BVal -> SignalState [ctor] .
  op {sgName _, value _} : TSignalName TVal -> SignalState [ctor] .
  op {scheduledEvent: time _, args _} : Time SignalState -> Transaction [ctor] .

  op {sgName _, time _} : ISignalName Time -> ISgTimeTuple [ctor] .
  ***op {sgName _, time _} : BitSignalName Time -> BitSgTimeTuple [ctor] .
  op {sgName _, time _} : StdlSignalName Time -> StdlSgTimeTuple [ctor] .
  op {sgName _, time _} : BSignalName Time -> BSgTimeTuple [ctor] .
  ***op {sgName _, time _} : TSignalName Time -> SgTimeTuple [ctor] .


  var T1 T2 : Time .
  var SgState1 SgState2 : SignalState .
  var Tr1 Tr2 : Transaction .

  op _<_ : Transaction Transaction -> Bool .
  eq {scheduledEvent: time T1, args SgState1} < {scheduledEvent: time T2, args SgState2} = ((timeVal(T1) < timeVal(T2)) == val(true)) .

  op _<=_ : Transaction Transaction -> Bool .
  eq {scheduledEvent: time T1, args SgState1} <= {scheduledEvent: time T2, args SgState2} = ((timeVal(T1) <= timeVal(T2)) == val(true)) .

endfm

view ScheduledInst from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to ScheduledInst .
endv

view ISgTimeTuple from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to ISgTimeTuple .
endv
view BitSgTimeTuple from TRIV to VHDL-SCHEDULE-MOD is
