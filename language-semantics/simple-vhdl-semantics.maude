  ---                                   fi
  ---                                 if anySgChange(SgChangedMap) == false and T =/= Tnext .
  crl [Stdlend-sim-cycle-nextEv-last] : [run] < clk(T) [prev: clk(Tprev)] | nil >< nil || {scheduledEvent: time Tnext, args {sgName Stdlsg, value StdlVal} } > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                                  => 
                                    [checkvalnextEv] < clk(T) [prev: clk(Tprev)] | nil >< nil || {scheduledEvent: time Tnext, args {sgName Stdlsg, value StdlVal} } > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                                  if anySgChange(SgChangedMap) == false and T =/= Tnext .
  crl [Stdlend-sim-cycle-nextEv-last1] : [checkvalnextEv] < clk(T) [prev: clk(Tprev)] | nil >< nil || {scheduledEvent: time Tnext, args {sgName Stdlsg, value StdlVal} } > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                                  => 
                                      [run] < clk(Tnext) [prev: clk(T)] | nil >< schOnTime(SchListCp, Tnext) || nil > << fill-blanks-next-ev(sw(Stdlsg), get-sgL(SgDescSTR), insert({sgName Stdlsg, time Tnext}, StdlVal, fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)), Tnext, T) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(sw(Stdlsg), true, sgChangeOnEv(T, Tnext, SgSTR, get-sgL(SgDescSTR), SgChangedMap)) } {wholeExec: SchListCp} InputChangeSim
                                    if cbeval(StdlVal /= getStdlSTR(fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev))[{sgName Stdlsg, time T}], < clk(T) [prev: clk(Tprev)] | nil >< nil || nil > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim) .
  crl [Stdlend-sim-cycle-nextEv-last2] : [checkvalnextEv] < clk(T) [prev: clk(Tprev)] | nil >< nil || {scheduledEvent: time Tnext, args {sgName Stdlsg, value StdlVal} } > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                                  => 
                                    [run] < clk(Tnext) [prev: clk(T)] | nil >< nil || nil > << fill-blanks-next-ev(sw(Stdlsg), get-sgL(SgDescSTR), insert({sgName Stdlsg, time Tnext}, StdlVal, fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)), Tnext, T) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: sgChangeOnEv(T, Tnext, SgSTR, get-sgL(SgDescSTR), SgChangedMap) } {wholeExec: SchListCp} InputChangeSim
                                  if not cbeval(StdlVal /= getStdlSTR(fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev))[{sgName Stdlsg, time T}], < clk(T) [prev: clk(Tprev)] | nil >< nil || nil > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim) .
  ***crl [end-sim-cycle-nextEv] : < clk(T) [prev: clk(Tprev)] | nil >< nil || {scheduledEvent: time Tnext, args {sgName Stdlsg, value Val} } {scheduledEvent: time T', args SgState } EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
  ***                          => 
