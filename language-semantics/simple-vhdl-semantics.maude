                              ***and Val := evalA(AExp1, T, SgSTR) and SgSTR' := fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev) .
  --- crl [Stdlend-sim-cycle-nextEv] : < clk(T) [prev: clk(Tprev)] | nil >< nil || {scheduledEvent: time Tnext, args {sgName Stdlsg, value StdlVal} } {scheduledEvent: time T', args SgState } EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
  ---                             => 
  ---                             if (Tnext == T') then
  ---                               < clk(T) [prev: clk(Tprev)] | nil >< nil || ({scheduledEvent: time T', args SgState } EventSchSList) > << insert({sgName Stdlsg, time Tnext}, StdlVal, fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
  ---                             else
  ---                               if StdlVal =/= getStdlSTR(fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev))[{sgName Stdlsg, time T}] then
  ---                                 < clk(Tnext) [prev: clk(T)] | nil >< schOnTime(SchListCp, Tnext) || ({scheduledEvent: time T', args SgState } EventSchSList) > << fill-blanks-next-ev(sw(Stdlsg), get-sgL(SgDescSTR), insert({sgName Stdlsg, time Tnext}, StdlVal, fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)), Tnext, T) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(sw(Stdlsg), true, SgChangedMap) } {wholeExec: SchListCp} InputChangeSim
  ---                               else
  ---                                 < clk(Tnext) [prev: clk(T)] | nil >< nil || ({scheduledEvent: time T', args SgState } EventSchSList) > << fill-blanks-next-ev(sw(Stdlsg), get-sgL(SgDescSTR), insert({sgName Stdlsg, time Tnext}, StdlVal, fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)), Tnext, T) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
  ---                               fi
  ---                             fi
  ---                             if anySgChange(SgChangedMap) == false and T =/= Tnext .

  crl [Stdlend-sim-cycle-nextEv] : [run] < clk(T) [prev: clk(Tprev)] | nil >< nil || {scheduledEvent: time Tnext, args {sgName Stdlsg, value StdlVal} } {scheduledEvent: time T', args SgState } EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                              => 
                              if (Tnext == T') then
                                [run] < clk(T) [prev: clk(Tprev)] | nil >< nil || ({scheduledEvent: time T', args SgState } EventSchSList) > << insert({sgName Stdlsg, time Tnext}, StdlVal, fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                              else
                                [checkvalnextEv] < clk(T) [prev: clk(Tprev)] | nil >< nil || {scheduledEvent: time Tnext, args {sgName Stdlsg, value StdlVal} } {scheduledEvent: time T', args SgState } EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                              fi
                              if (not anySgChange(SgChangedMap)) and T =/= Tnext .
  
  *** NOTE: 2-steps with control by term matching
  crl [Stdlend-sim-cycle-nextEv1] : [checkvalnextEv] < clk(T) [prev: clk(Tprev)] | nil >< nil || {scheduledEvent: time Tnext, args {sgName Stdlsg, value StdlVal} } {scheduledEvent: time T', args SgState } EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                              => 
                                [run] < clk(Tnext) [prev: clk(T)] | nil >< schOnTime(SchListCp, Tnext) || ({scheduledEvent: time T', args SgState } EventSchSList) > << fill-blanks-next-ev(sw(Stdlsg), get-sgL(SgDescSTR), insert({sgName Stdlsg, time Tnext}, StdlVal, fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)), Tnext, T) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(sw(Stdlsg), true, SgChangedMap) } {wholeExec: SchListCp} InputChangeSim
                              if cbeval(StdlVal /= getStdlSTR(fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev))[{sgName Stdlsg, time T}], < clk(T) [prev: clk(Tprev)] | nil >< nil || nil > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim) .
  crl [Stdlend-sim-cycle-nextEv2] : [checkvalnextEv] < clk(T) [prev: clk(Tprev)] | nil >< nil || {scheduledEvent: time Tnext, args {sgName Stdlsg, value StdlVal} } {scheduledEvent: time T', args SgState } EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                              => 
                                [run] < clk(Tnext) [prev: clk(T)] | nil >< nil || ({scheduledEvent: time T', args SgState } EventSchSList) > << fill-blanks-next-ev(sw(Stdlsg), get-sgL(SgDescSTR), insert({sgName Stdlsg, time Tnext}, StdlVal, fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)), Tnext, T) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                              if not cbeval(StdlVal /= getStdlSTR(fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev))[{sgName Stdlsg, time T}], < clk(T) [prev: clk(Tprev)] | nil >< nil || nil > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim) .

  *** nop: test instruction
  rl [nop] : nop ; IL => IL .


  *** exit-block: exit an inner block and continue where left before
  rl [exit-block] : < Clk | exit-block(IL) >< TControlSect > ValStores # DescStores 
                    => 
                    < Clk | IL >< TControlSect > ValStores # DescStores .
  
  ***rl [parse-exit-block] : [ exit-block(IL) -> SchList ]
  ***              => 
  ***              [ IL -> SchList ] .

  ***rl [error] : < Clk | Error ; IL >< TControlSect > ValStores # DescStores => Error ; .

  *** List{Inst} operations 
  op head : NeList{Inst;} -> Inst; .
  eq head(I1 IL) = I1 .

  op tail : NeList{Inst;} -> List{Inst;} .
  eq tail(I1 IL) = IL .

  op exit-block : List{Inst;} -> List{Inst;} .
  ***eq exit-block(IL) = IL .

  op get-port-sg : List{IODef} -> Inst [ctor] .
  eq get-port-sg(nil) = nop .

  op get-sgIOtype : SgDesc -> IOType .
  eq get-sgIOtype({IOType $ IntType}) = IOType .
  eq get-sgIOtype({IOType $ bit}) = IOType .
  eq get-sgIOtype({IOType $ 'std_logic}) = IOType .
  eq get-sgIOtype({IOType $ BoolType}) = IOType .
  ***op get-sgType : SgDesc -> IntType .
  ***op get-sgType : SgDesc -> StdlType .
  ***op get-sgType : SgDesc -> BoolType .
  ***eq get-sgType({IOType $ IntType}) = IntType .
  ***eq get-sgType({IOType $ bit}) = bit .
  ***eq get-sgType({IOType $ 'std_logic}) = 'std_logic .
  ***eq get-sgType({IOType $ BoolType}) = BoolType .

  op get-gen : List{GenDef} -> Inst [ctor] .
  eq get-gen(nil) = nop .

  op decl-sg : List{String} IntType IVal -> Inst [ctor] .
  op decl-sg : List{String} StdlType StdlVal -> Inst [ctor] .
  op decl-sg : List{String} BoolType BVal -> Inst [ctor] .
  op decl-sg : List{String} TimeType TVal -> Inst [ctor] .
  eq decl-sg(nil, IntType, IVal) = nop .
  eq decl-sg(nil, StdlType, StdlVal) = nop .
  eq decl-sg(nil, BoolType, BVal) = nop .
  eq decl-sg(nil, TimeType, TVal) = nop .

  op unfold : List{Inst;} Time -> List{ScheduledInst} [ctor] .
  eq unfold(nil, T) = nil .
  eq unfold(I1 IL, T) = {scheduledInst: time T, inst I1} unfold(IL, T) .

  *** TODO: T and Tprev may match with 0?
  op processSensitivityActivate : SimClock List{SignalWrapper} VHDLCompleteSim -> Bool [metadata "evalF"] .
  eq processSensitivityActivate(Clk, nil, VHDLCompleteSim) = true .
  eq processSensitivityActivate(clk(0 ns) [prev: clk(0 ns)], NeSgNameL, VHDLCompleteSim) = true .
  *** eq processSensitivityActivate(clk(T) [prev: clk(Tprev)], sw(Isg), VHDLCompleteSim) = cbeval(val(cieval(Isg, T, VHDLCompleteSim)) /= val(cieval(Isg, Tprev, VHDLCompleteSim)), VHDLCompleteSim) .
  eq processSensitivityActivate(clk(T) [prev: clk(Tprev)], sw(Stdlsg), VHDLCompleteSim) = cbeval(val(cstdleval(Stdlsg, T, VHDLCompleteSim)) /= val(cstdleval(Stdlsg, Tprev, VHDLCompleteSim)), VHDLCompleteSim) .
  eq processSensitivityActivate(clk(T) [prev: clk(Tprev)], sw(Bitsg), VHDLCompleteSim) = cbeval(val(cstdleval(Bitsg, T, VHDLCompleteSim)) /= val(cstdleval(Bitsg, Tprev, VHDLCompleteSim)), VHDLCompleteSim) .
  ***eq processSensitivityActivate(clk(T) [prev: clk(Tprev)], sw(Bsg), VHDLCompleteSim) = cbeval(val(cbeval(Bsg, T, VHDLCompleteSim)) /= val(cbeval(Bsg, Tprev, VHDLCompleteSim)), VHDLCompleteSim) .
  eq processSensitivityActivate(clk(T) [prev: clk(Tprev)], SignalW1 NeSgNameL, VHDLCompleteSim) = processSensitivityActivate(clk(T) [prev: clk(Tprev)], SignalW1, VHDLCompleteSim) or processSensitivityActivate(clk(T) [prev: clk(Tprev)], NeSgNameL, VHDLCompleteSim) .
  eq processSensitivityActivate(clk(T) [prev: clk(Tprev)], NeSgNameL, VHDLCompleteSim) = false [owise] .

  op sg-val-changed : IVal SignalWrapper Time Stores -> Bool .
  op sg-val-changed : BitVal SignalWrapper Time Stores -> Bool .
  op sg-val-changed : StdlVal SignalWrapper Time Stores -> Bool .
  op sg-val-changed : BVal SignalWrapper Time Stores -> Bool .
  eq sg-val-changed(IVal, sw(Isg), T, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = (IVal =/= lookup-sg(ISgSTR, {sgName Isg, time T})) .
  eq sg-val-changed(BitVal, sw(Bitsg), T, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = (BitVal =/= lookup-sg(BitSgSTR, {sgName Bitsg, time T})) .
  eq sg-val-changed(StdlVal, sw(Stdlsg), T, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = (StdlVal =/= lookup-sg(StdlSgSTR, {sgName Stdlsg, time T})) .
  eq sg-val-changed(BVal, sw(Bsg), T, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = (BVal =/= lookup-sg(BSgSTR, {sgName Bsg, time T})) .

  op schOnTime : List{ScheduledInst} Time -> List{ScheduledInst} [ctor] .
  eq schOnTime(nil, Tnow) = nil .
  eq schOnTime({scheduledInst: time T, inst I1 } SchList, Tnow) =  {scheduledInst: time Tnow, inst I1 } schOnTime(SchList, Tnow) .

  *** Resolve multiple assignments: first Value is newValue, second is already assigned value
  ***op correctVal : IVal SignalWrapper IVal -> IVal .
  op correctVal : BitVal BitVal -> BitVal .
  op correctVal : StdlVal StdlVal -> StdlVal .
  ***op correctVal : BVal SignalWrapper BVal -> BVal .
  ***eq correctVal(IVal, SignalW, undefined) = IVal .
  eq correctVal(BitVal, undefined) = BitVal .
  eq correctVal(StdlVal, undefined) = StdlVal .
  ***eq correctVal(BVal, SignalW, undefined) = BVal .
  ***eq correctVal(IVal, SignalW, IVal) = IVal .
  eq correctVal(BitVal, BitVal) = BitVal .
  eq correctVal(StdlVal, StdlVal) = StdlVal .
  ***eq correctVal(BVal, SignalW, BVal) = BVal .
  ***if lookup-sg(SgSTR, {sgName sg(SgStr), time T + delta}) == undefined or lookup-sg(SgSTR, {sgName sg(SgStr), time T}) == val('U') .
  ***eq correctVal(IVal, SignalW, IVal2) = resolve(IVal, IVal2) [owise] .
  eq correctVal(val(Stdl), val(Stdl2)) = val(resolveStdl(Stdl, Stdl2)) [owise] .
  ***eq correctVal(StdlVal, SignalW, StdlVal2) = resolveStdl(StdlVal, StdlVal2) [owise] .
  ***eq correctVal(BVal, SignalW, BVal2) = resolve(BVal, BVal2) [owise] .

  op anySgChange : SgChgStore -> Bool .
  eq anySgChange(empty) = false .
  eq anySgChange((SignalW |-> true, SgChangedMap)) = true .
  eq anySgChange((SignalW |-> false, SgChangedMap)) = anySgChange(SgChangedMap) .

  op fill-blanks : List{SignalWrapper} Stores Time Time -> Stores .
  eq fill-blanks(nil, SgSTR, T, Tprev) = SgSTR .
  ceq fill-blanks(sw(Isg) SignalIdL, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), T, Tprev) = fill-blanks(SignalIdL, (BitSgSTR | insert({sgName Isg, time T}, ISgSTR[{sgName Isg, time Tprev}], ISgSTR) | StdlSgSTR | BSgSTR), T, Tprev) if ISgSTR[{sgName Isg, time T}] == undefined . 
  ceq fill-blanks(sw(Bitsg) SignalIdL, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), T, Tprev) = fill-blanks(SignalIdL, insert({sgName Bitsg, time T}, BitSgSTR[{sgName Bitsg, time Tprev}], BitSgSTR) | ISgSTR | StdlSgSTR | BSgSTR, T, Tprev) if BitSgSTR[{sgName Bitsg, time T}] == undefined . 
  ceq fill-blanks(sw(Stdlsg) SignalIdL, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), T, Tprev) = fill-blanks(SignalIdL, BitSgSTR | ISgSTR | insert({sgName Stdlsg, time T}, StdlSgSTR[{sgName Stdlsg, time Tprev}], StdlSgSTR) | BSgSTR, T, Tprev) if StdlSgSTR[{sgName Stdlsg, time T}] == undefined . 
  ceq fill-blanks(sw(Bsg) SignalIdL, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), T, Tprev) = fill-blanks(SignalIdL, BitSgSTR | ISgSTR | StdlSgSTR | insert({sgName Bsg, time T}, BSgSTR[{sgName Bsg, time Tprev}], BSgSTR), T, Tprev) if BSgSTR[{sgName Bsg, time T}] == undefined . 
  ***eq fill-blanks(SignalW1 NeSgNameL, SgSTR, T, Tprev) = fill-blanks(SignalW1, SgSTR, T, Tprev), fill-blanks(NeSgNameL, SgSTR, T, Tprev) .
  eq fill-blanks(SignalW1 SignalIdL, SgSTR, T, Tprev) = fill-blanks(SignalIdL, SgSTR, T, Tprev) [owise] .


  *** TODO: It has to return Stores, not each one individually (rec case must be fill-blanks(...) with each store updated in each case??)
  *** Check...
  op fill-blanks-next-ev : SignalWrapper List{SignalWrapper} Stores Time Time -> Stores .
  eq fill-blanks-next-ev(SignalW, nil, SgSTR, Tnext, T) = SgSTR .
  eq fill-blanks-next-ev(SignalW, SignalW SignalIdL, SgSTR, Tnext, T) = fill-blanks-next-ev(SignalW, SignalIdL, SgSTR, Tnext, T) .
  ceq fill-blanks-next-ev(SignalW, sw(Isg) SignalIdL, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), Tnext, T) = insert({sgName Isg, time Tnext}, ISgSTR[{sgName Isg, time T}], fill-blanks(SignalIdL, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), Tnext, T)) if ISgSTR[{sgName Isg, time Tnext}] == undefined and SignalW =/= sw(Isg) .
  ceq fill-blanks-next-ev(SignalW, sw(Bitsg) SignalIdL, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), Tnext, T) = insert({sgName Bitsg, time Tnext}, BitSgSTR[{sgName Bitsg, time T}], fill-blanks(SignalIdL, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), Tnext, T)) if BitSgSTR[{sgName Bitsg, time Tnext}] == undefined and SignalW =/= sw(Bitsg) .
  ceq fill-blanks-next-ev(SignalW, sw(Stdlsg) SignalIdL, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), Tnext, T) = insert({sgName Stdlsg, time Tnext}, StdlSgSTR[{sgName Stdlsg, time T}], fill-blanks(SignalIdL, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), Tnext, T)) if StdlSgSTR[{sgName Stdlsg, time Tnext}] == undefined and SignalW =/= sw(Stdlsg) .
  ceq fill-blanks-next-ev(SignalW, sw(Bsg) SignalIdL, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), Tnext, T) = insert({sgName Bsg, time Tnext}, BSgSTR[{sgName Bsg, time T}], fill-blanks(SignalIdL, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), Tnext, T)) if BSgSTR[{sgName Bsg, time Tnext}] == undefined and SignalW =/= sw(Bsg) .
  eq fill-blanks-next-ev(SignalW, SignalW1 SignalIdL, SgSTR, Tnext, T) = fill-blanks-next-ev(SignalW, SignalIdL, SgSTR, Tnext, T) [owise] .

  op get-sgL : SgDescStore -> List{SignalWrapper} .
  eq get-sgL(empty) = nil .
  eq get-sgL((SignalW |-> SgDesc, SgDescSTR)) = SignalW get-sgL(SgDescSTR) .

  ***op schRestIf : ElsifStatement ElseStatement Time Stores -> List{Inst;} .
  op schRestIf : ElsifStatement ElseStatement Time -> List{Inst;} .
  ***eq schRestIf(null, null, T, SgSTR) = nil .
  ***eq schRestIf(null, else IL, T, SgSTR) = IL .
  ***eq schRestIf(elsif BExp then IL ElsifSt, ElseSt, T, SgSTR) = {scheduledInst: time T, inst (if BExp then IL ElsifSt ElseSt EndIf) ;} .
  eq schRestIf(null, null, T) = nil .
  eq schRestIf(null, else IL, T) = IL .
  eq schRestIf(elsif BExp then IL ElsifSt, ElseSt, T) = (if BExp then IL ElsifSt ElseSt end if) ; .
  ***eq schRestIf(elsif BExp then IL ElsifSt, ElseSt, T, SgSTR) =
