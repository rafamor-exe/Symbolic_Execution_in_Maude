  ***                   => 
  ***                   [ get-port-sg(IODefL) ; exit-block(IL) -> SchList ] ValStores # < insert(sg(Str), { IOType $ Type }, SgDescSTR) > .

  ***rl [parse-generic] : [ (generic(NeGenDefL)) ; IL -> SchList ]
  ***              => 
  ***              [ get-gen(NeGenDefL) ; exit-block(IL) -> SchList ] .
  ***crl [parse-get-gen] : [ (get-gen((Str : Type := Val ;) GenDefL)) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | ConstSTR >> # DescStores
  ***              =>
  ***              [ get-gen(GenDefL) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | insert(Str, Val, ConstSTR) >> # DescStores 
  ***              if verify-typeVal(Type, Val) .

  ***crl [parse-signal] : [ (signal NeSgStrL : Type := Value) ; IL -> SchList ]
  ***              => 
  ***              [ decl-sg(NeSgStrL, Type, Value) ; exit-block(IL) -> SchList ]
