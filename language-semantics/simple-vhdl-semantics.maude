  ***
  ***rl [parse-decl-sg] : [ decl-sg(SgStr SgStrL, Type, Value) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR >
  ***              =>
  ***              [ decl-sg(SgStrL, Type, Value) ; exit-block(IL) -> SchList ] << insert({sgName sg(SgStr), time 0 ns}, Value, SgSTR) | VarSTR | ConstSTR >> # < insert(sg(SgStr), { inout $ Type}, SgDescSTR) > .
  ***crl [parse-signal] : [ (signal NeSgStrL : Type := Value) ; IL -> SchList ]
  ***              => 
  ***              [ decl-sg(NeSgStrL, Type, Value) ; exit-block(IL) -> SchList ]
