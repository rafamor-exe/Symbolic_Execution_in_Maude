  ***                      else
***
  ***                        if DelayMech == transport or (isStable(T, Tdelay, Stdlsg, val(cstdleval(StdlExp, T, < clk(T) [prev: clk(Tprev)] | nil >< nil || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim)), EventSchSList)) then
  ***                        *** inertial delay without inestability is equivalent to transport delay
  ***                          < clk(T) [prev: clk(Tprev)] | nil >< SchList || sort({scheduledEvent: time get-time(timeVal(T) + timeVal(Tdelay)), args {sgName Stdlsg, value val(cstdleval(StdlExp, T, < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time T, inst (Stdlsg <=| DelayMech StdlExp after Tdelay) ;}  SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim))}} EventSchSList) > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
  ***                        else
  ***                          < clk(T) [prev: clk(Tprev)] | nil >< SchList || sort({scheduledEvent: time get-time(timeVal(T) + timeVal(Tdelay)), args {sgName Stdlsg, value val(cstdleval(StdlExp, T, < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time T, inst (Stdlsg <=| DelayMech StdlExp after Tdelay) ;}  SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim))}} purge(T, Tdelay, Stdlsg, val(cstdleval(StdlExp, T, < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time T, inst (Stdlsg <=| DelayMech StdlExp after Tdelay) ;}  SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim)), EventSchSList)) > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
  ***                        fi
