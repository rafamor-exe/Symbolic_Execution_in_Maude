endv
view BSgTimeTuple from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to BSgTimeTuple .
endv

view Transaction from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to Transaction .
endv

view Transaction<= from TOTAL-ORDER to VHDL-SCHEDULE-MOD is
  sort Elt to Transaction .
endv

view ISignalName from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to ISignalName .
endv
view BSignalName from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to BSignalName .
endv
view StdlSignalName from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to StdlSignalName .
endv
view BitSignalName from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to BitSignalName .
endv

fmod VHDL-STATEMENT is

  protecting VHDL-ATTRIBUTES-MOD .
  protecting VHDL-INSTCOLON-MOD .
  protecting VHDL-VALUE-MOD .
  protecting VHDL-GENERIC-MOD .
  protecting LIST{SignalWrapper} .
  protecting LIST{String} .
  protecting LIST{Inst;} .

  *** Declare sorts
  sorts VHDLSim VHDLBareSim VHDLCompleteSim Parser ParserTime ParserInsts InputChangeSim InputChangeSimCtrl Code Signal Var Const Clock SimClock ClockPrev Und Error Entity Architecture TimeControlSection ValueStores DescStores .
  sorts Process ProcessSensitivity ProcessNoSensitivity .
  sorts SeqStatement .
  sorts IfThen EndIf ElsifStatement ElseStatement NullStatement .
  sorts EmptyList InstBlock StructuredInstList . 
  sorts NeScheduleList ScheduleList NeListeningList ListeningList .
  sorts Assign SignalAssign VarConstAssign .
  sorts Stores NeStore SignalStore VarStore ConstStore .
  sorts EmptyStore NeSignalStore NeVarStore NeConstStore .
  sorts WaitInst SensitivityClause ConditionClause TimeoutClause .

  subsorts ProcessSensitivity ProcessNoSensitivity < Process .
  subsorts Entity Architecture Process Error SeqStatement < Inst .
  subsorts IfThen WaitInst < SeqStatement .
  subsorts NullStatement < ElsifStatement ElseStatement .
  subsorts NullStatement < SensitivityClause ConditionClause TimeoutClause .


  *** null is an internal representation for a lack of statement (placeholder)
  op null : -> NullStatement [ctor] .

  *** Instruction ops declarations (that include inner instruction lists)
  
  *** - Entity
  op entity _ is _ end _ : String List{Inst;} String -> Entity [ctor] .
  op entity _ is end _ : String String -> Entity [ctor] .
  
  *** - Architecture
  op architecture _ of _ is _ begin _ end _ : String String List{Inst;} List{Inst;} String -> Architecture [ctor] .
  op architecture _ of _ is begin _ end _ : String String List{Inst;} String -> Architecture [ctor] .
  
  *** - Process
  *** TODO: Variable assignment possibility before begin not included
  op process _ begin _ end process : List{SignalWrapper} List{Inst;} -> ProcessSensitivity [ctor] .
  op process begin _ end process : List{Inst;} -> ProcessNoSensitivity [ctor] .
  op end process : -> Inst [ctor] .

  *** - If statement
  *** TODO: defined precedence
  ***       - Example: red if true then nop ; (elsif true then nop ; elsif true then nop ;) else nop ; end if 
  op end if : -> EndIf [ctor] .
  op if _ then _ _ _ _ : BExp List{Inst;} ElsifStatement ElseStatement EndIf -> IfThen [ctor] .
  op if _ then _ _ _ : BExp List{Inst;} ElseStatement EndIf -> IfThen [ctor] .
  op if _ then _ _ _ : BExp List{Inst;} ElsifStatement EndIf -> IfThen [ctor] .
  op if _ then _ _ : BExp List{Inst;} EndIf -> IfThen [ctor] .
  op elsif _ then _ _ : BExp List{Inst;} ElsifStatement -> ElsifStatement [ctor] .
  op elsif _ then _ : BExp List{Inst;} -> ElsifStatement [ctor] .
  op else _ : List{Inst;} -> ElseStatement [ctor] .
  
  *** Wait statement
  *** Unite all clauses in sort ClauseArgs and make them optional 
  *** op wait _ _ _ : SensitivityClause ConditionClause TimeoutClause -> WaitInst [ctor] .
  *** op wait _ _ : SensitivityClause ConditionClause -> WaitInst [ctor] .
  *** op wait _ _ : SensitivityClause TimeoutClause -> WaitInst [ctor] .
  *** op wait _ _ : ConditionClause TimeoutClause -> WaitInst [ctor] .
  *** op wait _ : SensitivityClause -> WaitInst [ctor] .
  *** op wait _ : ConditionClause -> WaitInst [ctor] .
  *** op wait _ : TimeoutClause -> WaitInst [ctor] .

  ***op on _ : NeList{SignalName} -> SensitivityClause [ctor] .
  ***op until _ : BVal -> ConditionClause [ctor] .
  ***op for _ : TVal -> TimeoutClause [ctor] .

  *** - Signal (declaration)
  op signal _:_ : NeList{String} StdlType -> SgDecl [ctor prec 23] .
  op signal _:_ : NeList{String} IntType -> SgDecl [ctor prec 23] .
  op signal _:_ : NeList{String} StdlType -> SgDecl [ctor prec 23] .
  op signal _:_ : NeList{String} TimeType -> SgDecl [ctor prec 23] .
  op signal _:_ : NeList{String} BoolType -> SgDecl [ctor prec 23] .
  op signal _:_:=_ : NeList{String} StdlType BitVal  -> SgDecl [ctor prec 23] .
  op signal _:_:=_ : NeList{String} IntType IVal    -> SgDecl [ctor prec 23] .
  op signal _:_:=_ : NeList{String} StdlType StdlVal -> SgDecl [ctor prec 23] .
  op signal _:_:=_ : NeList{String} TimeType TVal    -> SgDecl [ctor prec 23] .
  op signal _:_:=_ : NeList{String} BoolType BVal    -> SgDecl [ctor prec 23] .

endfm

fmod VHDL-STATE is

  protecting VHDL-STATEMENT .

  protecting MAP{StdlSgTimeTuple, BitVal} * (sort Map{StdlSgTimeTuple, BitVal} to BitTStore) * (op _|->_ to _|->Bt_ ) .
  protecting MAP{ISgTimeTuple, IVal} * (sort Map{ISgTimeTuple, IVal} to ITStore) * (op _|->_ to _|->I_ ) .
  protecting MAP{StdlSgTimeTuple, StdlVal} * (sort Map{StdlSgTimeTuple, StdlVal} to StdlTStore) * (op _|->_ to _|->Stdl_ ) .
  protecting MAP{BSgTimeTuple, BVal} * (sort Map{BSgTimeTuple, BVal} to BTStore) * (op _|->_ to _|->B_ ) .

  ***protecting MAP{SgTimeTuple, Value} .
  protecting MAP{SignalWrapper, SgDesc} * (sort Map{SignalWrapper, SgDesc} to SgDescStore) .
  ***protecting MAP{ISignalName, SgDesc} * (sort Map{ISignalName, SgDesc} to BitDescStore) * (op _|->_ to _|->Bt_ ) .
  ***protecting MAP{BitSignalName, SgDesc} * (sort Map{BitSignalName, SgDesc} to IDescStore) * (op _|->_ to _|->I_ ) .
  ***protecting MAP{StdlSignalName, SgDesc} * (sort Map{StdlSignalName, SgDesc} to StdlDescStore) * (op _|->_ to _|->Stdl_ ) .
  ***protecting MAP{BSignalName, SgDesc} * (sort Map{BSignalName, SgDesc} to BDescStore) * (op _|->_ to _|->B_ ) .
  ***protecting MAP{TSignalName, SgDesc} * (sort Map{TSignalName, SgDesc} to TDescStore) * (op _|->_ to _|->T_ ) .

  ***protecting MAP{SignalName, Bool} .
  protecting MAP{SignalWrapper, Bool} * (sort Map{SignalWrapper, Bool} to SgChgStore) .

  protecting LIST{EntityInstColon} .
  protecting LIST{SignalWrapper} .
  protecting LIST{ScheduledInst} .
  ***protecting SET{Transaction} .
  protecting SORTABLE-LIST'{Transaction<=} .

  protecting MAP{String, BitVal} * (sort Map{String, BitVal} to BitStore) * (op _|->_ to _|->Bt_ ) .
  protecting MAP{String, IVal} * (sort Map{String, IVal} to IStore) * (op _|->_ to _|->I_ ) .
  protecting MAP{String, StdlVal} * (sort Map{String, StdlVal} to StdlStore) * (op _|->_ to _|->Stdl_ ) .
  protecting MAP{String, BVal} * (sort Map{String, BVal} to BStore) * (op _|->_ to _|->B_ ) .

  sorts ValStores .
  *** Simulator components
  subsorts Code < VHDLBareSim .

  op _|_|_|_ : BitTStore ITStore StdlTStore BTStore -> Stores [ctor] .
  op _,_ : Stores Stores -> Stores .
  vars BitTStore BitTStore' : BitTStore .
  vars ITStore ITStore' : ITStore .
  vars StdlTStore StdlTStore' : StdlTStore .
  vars BTStore BTStore' : BTStore .
  eq (BitTStore | ITStore | StdlTStore | BTStore) , (BitTStore' | ITStore' | StdlTStore' | BTStore') = ((BitTStore , BitTStore') | (ITStore, ITStore') | (StdlTStore, StdlTStore') | (BTStore, BTStore')) .
  op _|_|_|_ : BitStore IStore StdlStore BStore -> ValStores [ctor] .

  op empty : -> Stores [ctor] .
  eq (empty).Stores = empty | empty | empty | empty .
  op empty : -> ValStores [ctor] .
  eq (empty).ValStores = empty | empty | empty | empty .

  *** ValStores are VarStores and ConstStores
  op << _ | _ | _ >> : Stores ValStores ValStores -> ValueStores [ctor] .
  op < _ > : SgDescStore -> DescStores [ctor] .

  op _ # _ : ValueStores DescStores -> Stores [ctor] .

  op [_->_] : List{Inst;} List{ScheduledInst} -> ParserInsts .

  op _ _ : ParserInsts Stores -> Parser .
  op ! {inputChangeSim: _} : Bool -> InputChangeSim [ctor] . 
  op _ < events: _ > _ : Parser List{Transaction<=} InputChangeSim -> ParserTime [ctor] .

  *** Code represents a whole VHDL file. Rules will be needed for each code statement/block
  op _||_ : List{ScheduledInst} List{Transaction<=} -> TimeControlSection [ctor] .
  op <_|_><_>_ : SimClock List{Inst;} TimeControlSection Stores -> VHDLBareSim [ctor] .
  op ! {inputChangeSimCtrl: _, _} : Bool Time -> InputChangeSimCtrl [ctor] .
  op _ {repeat: _} {wholeExec: _} _ : VHDLBareSim SgChgStore List{ScheduledInst} InputChangeSimCtrl -> VHDLCompleteSim [ctor] .

  *** NOTE: Control rule application orderfor decomposed rules
  op [checkvalnextEv] _ : VHDLCompleteSim -> VHDLCompleteSim [ctor prec 50] .
  op [run] _ : VHDLCompleteSim -> VHDLCompleteSim [ctor prec 50] .

  op clk : Time -> Clock [ctor] .
  op [prev: _] : Clock -> ClockPrev [ctor] .
  op _ _ : Clock ClockPrev -> SimClock [ctor] .

endfm

view VHDLCompleteSim from TRIV to VHDL-STATE is
  sort Elt to VHDLCompleteSim .
endv

view BitTStore from TRIV to VHDL-STATE is
  sort Elt to BitTStore .
endv
view BitStore from TRIV to VHDL-STATE is
  sort Elt to BitStore .
endv

view ITStore from TRIV to VHDL-STATE is
  sort Elt to ITStore .
endv
view IStore from TRIV to VHDL-STATE is
  sort Elt to IStore .
endv

view StdlTStore from TRIV to VHDL-STATE is
  sort Elt to StdlTStore .
endv
view StdlStore from TRIV to VHDL-STATE is
  sort Elt to StdlStore .
endv

view BTStore from TRIV to VHDL-STATE is
  sort Elt to BTStore .
endv
view BStore from TRIV to VHDL-STATE is
  sort Elt to BStore .
endv

view Stores from TRIV to VHDL-STATE is
  sort Elt to Stores .
endv
view ValStores from TRIV to VHDL-STATE is
  sort Elt to ValStores .
endv

fmod VHDL-BASICS is
    protecting VHDL-STATE .
    protecting CONCRETE-FW-NORAT{VHDLCompleteSim} .
    protecting CONCRETE-FW-NORAT-STDL{VHDLCompleteSim} .
    protecting DATATYPE{Bool} .
    protecting DATATYPE{Int} .
    protecting DATATYPE{Stdl} .
    protecting STRUCT{BitTStore} .
    protecting STRUCT{BitStore} .
    protecting STRUCT{ITStore} .
    protecting STRUCT{IStore} .
    protecting STRUCT{StdlTStore} .
    protecting STRUCT{StdlStore} .
    protecting STRUCT{BTStore} .
    protecting STRUCT{BStore} .
    protecting STRUCT{Stores} .
    protecting STRUCT{ValStores} .
    ***protecting IREF{ISignalName, VHDLCompleteSim} .
    ***protecting BREF{BSignalName, VHDLCompleteSim} .
    ***protecting STDLREF{StdlSignalName, VHDLCompleteSim} .
    ***protecting STDLREF{BitSignalName, VHDLCompleteSim} .
    protecting IREF{ISgTimeTuple, VHDLCompleteSim} .
    protecting BREF{BSgTimeTuple, VHDLCompleteSim} .
    protecting STDLREF{StdlSgTimeTuple, VHDLCompleteSim} .
    protecting STDLREF{BitSgTimeTuple, VHDLCompleteSim} .
endfm

mod VHDLMOD is
  *** RAFAEL MORALES PALACIOS - SEMANTICS OF VHDL IN MAUDE
  
  *** IMPORT MODULES TO BE USED
  protecting NAT .
  ***protecting INT .
  ***protecting STRING .
  protecting LIST{IOType} .
  ***protecting LIST{SignalName} .
  protecting VHDL-BASICS .
  
  op und : -> Und [ctor] .
  op EmptyList : -> EmptyList [ctor] .
  op error : String -> Error [ctor] .

  *** Variable definition

  vars I1 S1 : Inst; .
  vars SignalW SignalW1 SignalW2 : SignalWrapper .
  vars IExp IExp1 IExp2 : IExp .
  vars BExp BExp1 BExp2 : BExp .
  vars StdlExp StdlExp1 StdlExp2 : StdlExp .
  var TExp : TExp .
  vars Isg Isg2 : ISignalName .
  vars Bitsg Bitsg2 : BitSignalName .
  vars Stdlsg Stdlsg2 : StdlSignalName .
  vars Bsg Bsg2 : BSignalName .
  vars Tsg Tsg2 : TSignalName .
  ***var Val Value Value1 Value2 : Value .
  vars IL IL1 IL2 IL' : List{Inst;} .
  vars NeIL1 NeIL2 : NeList{Inst;} .
  var SgSTR : Stores .
  var ISgSTR : ITStore .
  var BitSgSTR : BitTStore .
  var BSgSTR : BTStore .
  var StdlSgSTR : StdlTStore .
  ***var SgTimeTuple : SgTimeTuple .
  var ISgTimeTuple : ISgTimeTuple .
  var StdlSgTimeTuple : StdlSgTimeTuple .
  var BSgTimeTuple : BSgTimeTuple .
  ***var STR : Map{String, Value} .
  var VarSTR : ValStores .
  var ConstSTR : ValStores .
  var IVSTR : IStore .
  var BitVSTR : BitStore .
  var BVSTR : BStore .
  var StdlVSTR : StdlStore .
  var SgDescSTR : SgDescStore .
  var SgDesc : SgDesc .
  var Int1 Int2 : Int .
  var SgStr Str Str2 : String .
  var Clk : SimClock .
  var ClkP1 ClkP2 : Clock .
  var N : Nat .
  ***var NVal : NatVal .
  var Int : Int .
  var SchList SchListCp : List{ScheduledInst} .
  vars EventSchSList EvSchSL1 EvSchSL2 : List{Transaction<=} .
  var NeEventSchSList : NeList{Transaction<=} .
  var NeIODefL : NeList{IODef} .
  var IODef : IODef .
  var IOType : IOType .
  var IOTypeL : List{IOType} .
  var Type Type2 : Type .
  var PhysT : TimeType .
  vars IntT : IntType .
  var IODefL : List{IODef} .
  ***var AExp1 AExp2 : AExp .
  var Error : Error .
  vars Op : Op .
  ***var VarType : VarType .
  var NeGenDefL : NeList{GenDef} .
  var GenDefL : List{GenDef} .
  var EntityIL : List{EntityInstColon} .
  vars T Tprev Tnext Tnow Tdelay T' : Time .
  var ClockPrev : ClockPrev .
  var TVal : TVal .
  ***var PosVal : PosVal .
  var NeSgNameL : NeList{SignalWrapper} .
  vars SgNameL SignalIdL : List{SignalWrapper} .
  var TControlSect : TimeControlSection .
  var ValStores : ValueStores .
  var SignalState : SignalState .
  var StoresVar : Stores .
  var DescStores : DescStores .
  var B : Bool .
  var SgChangedMap : SgChgStore .
  var ElsifSt : ElsifStatement .
  var ElseSt : ElseStatement .
  var EndIf : EndIf .
  var CompOp : CompOp .
  vars IVal IVal2 : IVal .
  vars BVal BVal2 : BVal .
  vars StdlVal StdlVal2 StdLogicVal1 StdLogicVal2 StdlV1 StdlV2 : StdlVal .
  vars BitVal BitVal2 BitV1 BitV2 : BitVal .
  var SensitivityCl : SensitivityClause .
  var ConditionCl : ConditionClause .
  var TimeoutCl : TimeoutClause .
  var NumUnOp : NumUnOp .
  var IBinOp : IBinOp .
  var InputChangeSim : InputChangeSimCtrl .
  var SgState : SignalState .
  var R1 R2 : Int .
  var TUnit : TimeUnit .
  var TDelta1 : Delta .
  var SgStrL : List{String} .
  var NeSgStrL : NeList{String} .
  var DelayMech : DelayMechanism .
  var NzTDelay : NzTime .
  var StdlType : StdlType .
  var IntType : IntType .
  var TimeType : TimeType .
  var BoolType : BoolType .
  vars Stdl Stdl2 : Stdl . 
  var VHDLCompleteSim : VHDLCompleteSim .
  ***var StdlVal : StdlVal .
  ***var BitVal : BitVal . 

  *** Workflow: run(IL, EventSchSList) -> Parse -> insitSimArch -> Simulation Loop
  op run(_,_,_) : List{Inst;} List{Transaction<=} Bool -> VHDLCompleteSim [ctor] .
  eq run(IL, EventSchSList, B) = initSimArch(parse(IL) < events: sort(EventSchSList) > ! {inputChangeSim: B}) .
  op run(_,_) : List{Inst;} List{Transaction<=} -> VHDLCompleteSim [ctor] .
  eq run(IL, EventSchSList) = initSimArch(parse(IL) < events: sort(EventSchSList) > ! {inputChangeSim: false}) .
  op run(_) : List{Inst;} -> VHDLCompleteSim [ctor] .
  eq run(IL) = initSimArch(parse(IL) < events: nil > ! {inputChangeSim: false}) .

  *** Parse instruction list
  op parse : List{Inst;} -> Parser .
  eq parse(IL) = [ IL -> nil ] << empty | empty | empty >> # < empty > .

  eq [ (entity Str is IL1 end Str) ; IL -> SchList ] = [ IL1 exit-block(IL) -> SchList ] .
  
  eq [ (port(NeIODefL)) ; IL -> SchList ] = [ get-port-sg(NeIODefL) ; exit-block(IL) -> SchList ] .
  eq [ (get-port-sg((Str : IOType IntType ;) IODefL)) ; exit-block(IL) -> SchList ] ValStores # < SgDescSTR > = 
        [ get-port-sg(IODefL) ; exit-block(IL) -> SchList ] ValStores # < insert(sw(Isg(Str)), { IOType $ IntType }, SgDescSTR) > .
  eq [ (get-port-sg((Str : IOType bit ;) IODefL)) ; exit-block(IL) -> SchList ] ValStores # < SgDescSTR > = 
        [ get-port-sg(IODefL) ; exit-block(IL) -> SchList ] ValStores # < insert(sw(Bitsg(Str)), { IOType $ bit }, SgDescSTR) > .
  eq [ (get-port-sg((Str : IOType StdlType ;) IODefL)) ; exit-block(IL) -> SchList ] ValStores # < SgDescSTR > = 
        [ get-port-sg(IODefL) ; exit-block(IL) -> SchList ] ValStores # < insert(sw(Stdlsg(Str)), { IOType $ StdlType }, SgDescSTR) > .
  eq [ (get-port-sg((Str : IOType BoolType ;) IODefL)) ; exit-block(IL) -> SchList ] ValStores # < SgDescSTR > = 
        [ get-port-sg(IODefL) ; exit-block(IL) -> SchList ] ValStores # < insert(sw(Bsg(Str)), { IOType $ BoolType }, SgDescSTR) > .
  eq [ (get-port-sg((Str : IOType TimeType ;) IODefL)) ; exit-block(IL) -> SchList ] ValStores # < SgDescSTR > = 
        [ get-port-sg(IODefL) ; exit-block(IL) -> SchList ] ValStores # < insert(sw(Tsg(Str)), { IOType $ TimeType }, SgDescSTR) > .
  
  eq [ (generic(NeGenDefL)) ; IL -> SchList ] = [ get-gen(NeGenDefL) ; exit-block(IL) -> SchList ] .
  eq [ (get-gen((Str : 'std_logic := StdlVal ;) GenDefL)) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | (BitVSTR | IVSTR | StdlVSTR | BVSTR) >> # DescStores =
        [ get-gen(GenDefL) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | (BitVSTR | IVSTR | insert(Str, StdlVal, StdlVSTR) | BVSTR) >> # DescStores .
  eq [ (get-gen((Str : bit := BitVal ;) GenDefL)) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | (BitVSTR | IVSTR | StdlVSTR | BVSTR) >> # DescStores =
        [ get-gen(GenDefL) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | (insert(Str, BitVal, BitVSTR) | IVSTR | StdlVSTR | BVSTR) >> # DescStores .
  eq [ (get-gen((Str : IntType := IVal ;) GenDefL)) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | (BitVSTR | IVSTR | StdlVSTR | BVSTR) >> # DescStores =
        [ get-gen(GenDefL) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | (BitVSTR | insert(Str, IVal, IVSTR) | StdlVSTR | BVSTR) >> # DescStores .
  eq [ (get-gen((Str : BoolType := BVal ;) GenDefL)) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | (BitVSTR | IVSTR | StdlVSTR | BVSTR) >> # DescStores =
        [ get-gen(GenDefL) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | (BitVSTR | IVSTR | StdlVSTR | insert(Str, BVal, BVSTR)) >> # DescStores .
  
  eq [ (signal NeSgStrL : 'std_logic := StdlVal) ; IL -> SchList ] = [ decl-sg(NeSgStrL, 'std_logic, StdlVal) ; exit-block(IL) -> SchList ] .
  eq [ (signal NeSgStrL : bit := BitVal) ; IL -> SchList ] = [ decl-sg(NeSgStrL, bit, BitVal) ; exit-block(IL) -> SchList ] .
  eq [ (signal NeSgStrL : IntType := IVal) ; IL -> SchList ] = [ decl-sg(NeSgStrL, IntType, IVal) ; exit-block(IL) -> SchList ] .
  eq [ (signal NeSgStrL : BoolType := BVal) ; IL -> SchList ] = [ decl-sg(NeSgStrL, BoolType, BVal) ; exit-block(IL) -> SchList ] .         

  eq [ decl-sg(SgStr SgStrL, 'std_logic, StdlVal) ; exit-block(IL) -> SchList ] << (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > =
    [ decl-sg(SgStrL, 'std_logic, StdlVal) ; exit-block(IL) -> SchList ] << (BitSgSTR | ISgSTR | insert({sgName Stdlsg(SgStr), time 0 ns}, StdlVal, StdlSgSTR) | BSgSTR) | VarSTR | ConstSTR >> # < insert(sw(Stdlsg(SgStr)), { inout $ 'std_logic}, SgDescSTR) > .
  eq [ decl-sg(SgStr SgStrL, bit, BitVal) ; exit-block(IL) -> SchList ] << (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > =
    [ decl-sg(SgStrL, bit, BitVal) ; exit-block(IL) -> SchList ] << (insert({sgName Bitsg(SgStr), time 0 ns}, BitVal, BitSgSTR) | ISgSTR | StdlSgSTR | BSgSTR) | VarSTR | ConstSTR >> # < insert(sw(Bitsg(SgStr)), { inout $ bit}, SgDescSTR) > .
  eq [ decl-sg(SgStr SgStrL, IntType, IVal) ; exit-block(IL) -> SchList ] << (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > =
    [ decl-sg(SgStrL, IntType, IVal) ; exit-block(IL) -> SchList ] << (BitSgSTR | insert({sgName Isg(SgStr), time 0 ns}, IVal, ISgSTR) | StdlSgSTR | BSgSTR) | VarSTR | ConstSTR >> # < insert(sw(Isg(SgStr)), { inout $ IntType}, SgDescSTR) > .
  eq [ decl-sg(SgStr SgStrL, BoolType, BVal) ; exit-block(IL) -> SchList ] << (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > =
    [ decl-sg(SgStrL, BoolType, BVal) ; exit-block(IL) -> SchList ] << (BitSgSTR | ISgSTR | StdlSgSTR | insert({sgName Bsg(SgStr), time 0 ns}, BVal, BSgSTR))| VarSTR | ConstSTR >> # < insert(sw(Bsg(SgStr)), { inout $ BoolType}, SgDescSTR) > .
  eq [ (architecture Str of Str2 is IL1 begin IL2 end Str) ; IL -> SchList ] = [ IL1 exit-block(IL2 exit-block(IL)) -> SchList ] .
  ceq [ (process SgNameL begin IL2 end process) ; IL -> SchList ] =
    [ IL -> SchList {scheduledInst: time 0 ns, inst (process SgNameL begin IL2 end process) ;} ] 
    if verify-typeBlock(IL2) .

  eq [ (Isg <=| DelayMech IExp after Tdelay) ; IL -> SchList ] = [ IL -> SchList {scheduledInst: time 0 ns, inst (Isg <=| DelayMech IExp after Tdelay) ;} ] .
  eq [ (Bitsg <=| DelayMech StdlExp after Tdelay) ; IL -> SchList ] = [ IL -> SchList {scheduledInst: time 0 ns, inst (Bitsg <=| DelayMech StdlExp after Tdelay) ;} ] .
  eq [ (Stdlsg <=| DelayMech StdlExp after Tdelay) ; IL -> SchList ] = [ IL -> SchList {scheduledInst: time 0 ns, inst (Stdlsg <=| DelayMech StdlExp after Tdelay) ;} ] .
  eq [ (Bsg <=| DelayMech BExp after Tdelay) ; IL -> SchList ] = [ IL -> SchList {scheduledInst: time 0 ns, inst (Bsg <=| DelayMech BExp after Tdelay) ;} ] .
  eq [ (Tsg <=| DelayMech TExp after Tdelay) ; IL -> SchList ] = [ IL -> SchList {scheduledInst: time 0 ns, inst (Tsg <=| DelayMech TExp after Tdelay) ;} ] .

  ***ceq [(if BExp then IL ElsifSt ElseSt EndIf) ; IL' -> SchList ] = [IL' -> SchList ]
  ***  if verify-typeBlock(IL) and verify-typeElsifSt(ElsifSt) and verify-typeElseSt(ElseSt) .
  
  eq [(if BExp then IL ElsifSt ElseSt EndIf) ; IL' -> SchList ] = [IL' -> SchList {scheduledInst: time 0 ns, inst (if BExp then IL ElsifSt ElseSt EndIf) ;} ] .
  ***  if verify-typeBlock(IL) and verify-typeElsifSt(ElsifSt) and verify-typeElseSt(ElseSt) .

  eq [ exit-block(IL) -> SchList ] = [ IL -> SchList ] .

  eq [ nop ; IL -> SchList ] = [ IL -> SchList ] .


  op initSimArch(_) : ParserTime -> VHDLCompleteSim [ctor] .
  eq initSimArch([ nil -> SchList ] << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > < events: EventSchSList > ! {inputChangeSim: B}) = [run] < clk(0 ns) [prev: clk(0 ns)] | nil >< SchList || EventSchSList > << insertDefault(SgDescSTR, SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insertDefaultRep(SgDescSTR, empty) } {wholeExec: SchList} ! {inputChangeSimCtrl: B, 0 ns} .

  op insertDefault : SgDescStore Stores -> Stores .
  eq insertDefault(empty, SgSTR) = SgSTR .
  *** Remove this ceq, it is unnecessary!!!
  ***ceq insertDefault(sw(Isg) |-> { IOType $ IntType }, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = insert({sgName Isg, time 0 ns}, (IntType ' LEFT), (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) if ISgSTR[{sgName Isg, time 0 ns}] == undefined .
  ***ceq insertDefault(sw(Stdlsg) |-> { IOType $ 'std_logic }, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = insert({sgName Stdlsg, time 0 ns}, ('std_logic ' LEFT), (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) if StdlSgSTR[{sgName Stdlsg, time 0 ns}] == undefined .
  ***ceq insertDefault(sw(Bitsg) |-> { IOType $ bit }, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = insert({sgName Bitsg, time 0 ns}, (bit ' LEFT), (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) if BitSgSTR[{sgName Bitsg, time 0 ns}] == undefined .
  ***ceq insertDefault(sw(Bsg) |-> { IOType $ BoolType }, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = insert({sgName Bsg, time 0 ns}, (BoolType ' LEFT), (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) if BSgSTR[{sgName Bsg, time 0 ns}] == undefined .
  ceq insertDefault((sw(Isg) |-> { IOType $ IntType }, SgDescSTR), (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = insert({sgName Isg, time 0 ns}, (IntType ' LEFT), insertDefault(SgDescSTR, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR))) if ISgSTR[{sgName Isg, time 0 ns}] == undefined .
  ceq insertDefault((sw(Stdlsg) |-> { IOType $ 'std_logic }, SgDescSTR), (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = insert({sgName Stdlsg, time 0 ns}, ('std_logic ' LEFT), insertDefault(SgDescSTR, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR))) if StdlSgSTR[{sgName Stdlsg, time 0 ns}] == undefined .
  ceq insertDefault((sw(Bitsg) |-> { IOType $ bit }, SgDescSTR), (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = insert({sgName Bitsg, time 0 ns}, (bit ' LEFT), insertDefault(SgDescSTR, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR))) if BitSgSTR[{sgName Bitsg, time 0 ns}] == undefined .
  ceq insertDefault((sw(Bsg) |-> { IOType $ BoolType }, SgDescSTR), (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR)) = insert({sgName Bsg, time 0 ns}, (BoolType ' LEFT), insertDefault(SgDescSTR, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR))) if BSgSTR[{sgName Bsg, time 0 ns}] == undefined .
  eq insertDefault((sw(Isg) |-> { IOType $ IntType }, SgDescSTR), SgSTR) = insertDefault(SgDescSTR, SgSTR) [owise] .
  eq insertDefault((sw(Stdlsg) |-> { IOType $ 'std_logic }, SgDescSTR), SgSTR) = insertDefault(SgDescSTR, SgSTR) [owise] .
  eq insertDefault((sw(Bitsg) |-> { IOType $ bit }, SgDescSTR), SgSTR) = insertDefault(SgDescSTR, SgSTR) [owise] .
  eq insertDefault((sw(Bsg) |-> { IOType $ BoolType }, SgDescSTR), SgSTR) = insertDefault(SgDescSTR, SgSTR) [owise] .

  op insertDefaultRep : SgDescStore SgChgStore -> SgChgStore .
  eq insertDefaultRep(empty, SgChangedMap) = SgChangedMap .
  eq insertDefaultRep(SignalW |-> SgDesc, SgChangedMap) = insert(SignalW, false,  SgChangedMap) .
  eq insertDefaultRep((SignalW |-> SgDesc, SgDescSTR), SgChangedMap) = insert(SignalW, false,  insertDefaultRep(SgDescSTR, SgChangedMap)) .

  ***op initSim : List{Inst;} List{Transaction<=} -> VHDLSim [ctor] .
  ***eq initSim(IL, EventSchSList) = < clk(0 ns) [prev: clk(0 ns)] | IL >< nil | nil | EventSchSList > << empty | empty | empty >> # < empty > .

  *** An entity declared without instructions is equivalent to an entity with an empty list of instructions
  eq entity Str is end Str = entity Str is nil end Str .

  *** An architecture declared without declaration instructions is equivalent to an architecture with an empty list of declaration instructions
  eq architecture Str of Str2 is begin IL end Str = architecture Str of Str2 is nil begin IL end Str .

  *** A process declared without a sensitivity list is equal to the process with an empty sensitivity list 
  eq process begin IL end process = process nil begin IL end process .
  
  *** An if statement can have any number of elsif sub-statements and 0 or 1 else statements
  eq if BExp then IL EndIf = if BExp then IL null null EndIf .
  eq if BExp then IL ElseSt EndIf = if BExp then IL null ElseSt EndIf .
  eq if BExp then IL ElsifSt EndIf = if BExp then IL ElsifSt null EndIf .
  eq elsif BExp then IL = elsif BExp then IL null .

  ***eq wait ConditionCl TimeoutCl = wait null ConditionCl TimeoutCl .
  ***eq wait SensitivityCl TimeoutCl = wait SensitivityCl null TimeoutCl .
  ***eq wait SensitivityCl ConditionCl = wait SensitivityCl ConditionCl null .

  *** A signal declaration with no default expression takes the default value for its type (T'LEFT)
  eq signal NeSgStrL : IntType = signal NeSgStrL : IntType := (IntType ' LEFT) .
  eq signal NeSgStrL : 'std_logic = signal NeSgStrL : 'std_logic := ('std_logic ' LEFT) .
  eq signal NeSgStrL : bit = signal NeSgStrL : bit := (bit ' LEFT) .
  eq signal NeSgStrL : BoolType = signal NeSgStrL : BoolType := (BoolType ' LEFT) .

  *** A signal assignment assumes 0 ns delay if after clause is not present
  eq Isg <=| IExp after T = Isg <=| inertial IExp after T .
  eq Isg <=| IExp = Isg <=| inertial IExp after (0 ns) .

  eq Bitsg <=| StdlExp after T = Bitsg <=| inertial StdlExp after T .
  eq Bitsg <=| StdlExp = Bitsg <=| StdlExp after (0 ns) .

  eq Stdlsg <=| StdlExp after T = Stdlsg <=| inertial StdlExp after T .
  eq Stdlsg <=| StdlExp = Stdlsg <=| inertial StdlExp after (0 ns) .

  eq Bsg <=| BExp after T = Bsg <=| inertial BExp after T .
  eq Bsg <=| BExp = Bsg <=| inertial BExp after (0 ns) .

  *** TODO: Restrict values of SgSTR to StdLogic with cmb

  *** Rules

  *** Non-deterministic change of signal values
  *** TODO:
  *** - Optionality
  *** - Restrict where it could happen
  *** - Take into account that when activating
  ***crl [nd-sg-val-change] : < clk(R1 TUnit) [prev: clk(Tprev)] | nil >< SchList || EventSchSList > << ({sgName SignalW, time (R1 TUnit)} |-> StdlVal , SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} ! {inputChangeSimCtrl: true , (R2 TUnit) }
  ***                        => 
  ***                        < clk(R1 TUnit) [prev: clk(Tprev)] | nil >< SchList || EventSchSList > << insert({sgName SignalW, time (R1 TUnit) + delta}, correctVal(not StdlVal, SignalW, lookup-sg(SgSTR, {sgName SignalW, time (R1 TUnit) + delta})), SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(SignalW,  (sg-val-changed(correctVal(not StdlVal, SignalW, lookup-sg(SgSTR, {sgName SignalW, time (R1 TUnit) + delta})), SignalW, (R1 TUnit), SgSTR)), SgChangedMap) } {wholeExec: SchListCp} ! {inputChangeSimCtrl: true , (R1 TUnit) }
  ***                        if verify-sg(in inout, SignalW, SgDescSTR) and R1 =/= R2 . ***T =/= T' and T =/= T' + delta and T =/= T' + delta(2) .
  ***crl [nd-sg-val-change-bis] : < clk(R1 TUnit + TDelta1) [prev: clk(Tprev)] | nil >< SchList || EventSchSList > << ({sgName SignalW, time (R1 TUnit + TDelta1)} |-> StdlVal , SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} ! {inputChangeSimCtrl: true , (R2 TUnit) }
  ***                        => 
  ***                        < clk(R1 TUnit + TDelta1) [prev: clk(Tprev)] | nil >< SchList || EventSchSList > << insert({sgName SignalW, time (R1 TUnit + TDelta1) + delta}, correctVal(not StdlVal, SignalW, lookup-sg(SgSTR, {sgName SignalW, time (R1 TUnit + TDelta1) + delta})), SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(SignalW,  (sg-val-changed(correctVal(not StdlVal, SignalW, lookup-sg(SgSTR, {sgName SignalW, time (R1 TUnit + TDelta1) + delta})), SignalW, (R1 TUnit + TDelta1), SgSTR)), SgChangedMap) } {wholeExec: SchListCp} ! {inputChangeSimCtrl: true , (R1 TUnit) }
  ***                        if verify-sg(in inout, SignalW, SgDescSTR) and R1 =/= R2 .


  ***rl [parse-entity] : [ (entity Str is IL1 end Str) ; IL -> SchList ]
  ***                    => 
  ***                    [ IL1 exit-block(IL) -> SchList ] .

  ***rl [parse-port] : [ (port(NeIODefL)) ; IL -> SchList ]
  ***                  => 
  ***                  [ get-port-sg(NeIODefL) ; exit-block(IL) -> SchList ] .
