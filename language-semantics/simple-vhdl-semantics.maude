  ***  else
  ***     schRestIf(ElsifSt, ElseSt, T, SgSTR)
  ***  fi .
  ***eq schRestIf(elsif val(false) then IL ElsifSt, ElseSt) = schRestIf(ElsifSt, ElseSt) .

  op sgChangeOnEv : Time Time Stores List{SignalWrapper} SgChgStore -> SgChgStore .
  eq sgChangeOnEv(T, Tnext, SgSTR, nil, SgChangedMap) = SgChangedMap .
  ceq sgChangeOnEv(T, Tnext, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), sw(Isg) SignalIdL, SgChangedMap) = insert(sw(Isg), (sg-val-changed(ISgSTR[{sgName Isg, time Tnext}], sw(Isg), T, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR))), sgChangeOnEv(T, Tnext, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), SignalIdL, SgChangedMap)) if ISgSTR[{sgName Isg, time Tnext}] =/= undefined .
  ceq sgChangeOnEv(T, Tnext, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), sw(Bitsg) SignalIdL, SgChangedMap) = insert(sw(Bitsg), (sg-val-changed(BitSgSTR[{sgName Bitsg, time Tnext}], sw(Bitsg), T, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR))), sgChangeOnEv(T, Tnext, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), SignalIdL, SgChangedMap)) if BitSgSTR[{sgName Bitsg, time Tnext}] =/= undefined .
  ceq sgChangeOnEv(T, Tnext, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), sw(Stdlsg) SignalIdL, SgChangedMap) = insert(sw(Stdlsg), (sg-val-changed(StdlSgSTR[{sgName Stdlsg, time Tnext}], sw(Stdlsg), T, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR))), sgChangeOnEv(T, Tnext, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), SignalIdL, SgChangedMap)) if StdlSgSTR[{sgName Stdlsg, time Tnext}] =/= undefined .
  ceq sgChangeOnEv(T, Tnext, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), sw(Bsg) SignalIdL, SgChangedMap) = insert(sw(Bsg), (sg-val-changed(BSgSTR[{sgName Bsg, time Tnext}], sw(Bsg), T, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR))), sgChangeOnEv(T, Tnext, (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR), SignalIdL, SgChangedMap)) if BSgSTR[{sgName Bsg, time Tnext}] =/= undefined .
  eq sgChangeOnEv(T, Tnext, SgSTR, SignalW SignalIdL, SgChangedMap) = sgChangeOnEv(T, Tnext, SgSTR, SignalIdL, SgChangedMap) [owise] .

  op purge : Time Time ISignalName IVal List{Transaction<=} -> List{Transaction<=} .
  ***op purge : Time Time TSignalName Value List{Transaction<=} -> List{Transaction<=} .
  eq purge(T, 0 ns, Isg, IVal, NeEventSchSList) = NeEventSchSList .
  eq purge(T, NzTDelay, Isg, IVal, nil) = nil .
  eq purge(T, NzTDelay, Isg, IVal, ({scheduledEvent: time T', args {sgName Isg, value IVal}} EventSchSList)) = 
    ({scheduledEvent: time T', args {sgName Isg, value IVal}} purge(T, NzTDelay, Isg, IVal, EventSchSList)) .
  eq purge(T, NzTDelay, Isg, IVal, ({scheduledEvent: time T', args {sgName Isg2, value IVal2}} EventSchSList)) = 
    if (timeVal(T) < timeVal(T')) == val(true) and (timeVal(T') <= (timeVal(T) + timeVal(NzTDelay))) == val(true) then
      purge(T, NzTDelay, Isg, IVal, EventSchSList)
    else
      ({scheduledEvent: time T', args {sgName Isg2, value IVal2}} purge(T, NzTDelay, Isg, IVal, EventSchSList))
    fi .
  *** TODO: Check if this can be converted to unconditional eq
  ceq purge(T, NzTDelay, Isg, IVal, ({scheduledEvent: time T', args {sgName Isg2, value IVal2}} EventSchSList)) = 
    ({scheduledEvent: time T', args {sgName Isg2, value IVal2}} purge(T, NzTDelay, Isg, IVal, EventSchSList)) if Isg =/= Isg2 .
  eq purge(T, NzTDelay, Isg, IVal, ({scheduledEvent: time T', args {sgName Isg2, value IVal2}} EventSchSList)) = 
        ({scheduledEvent: time T', args {sgName Isg2, value IVal2}} purge(T, NzTDelay, Isg, IVal, EventSchSList)) [owise] .
  
  op purge : Time Time BitSignalName BitVal List{Transaction<=} -> List{Transaction<=} .
  eq purge(T, 0 ns, Bitsg, BitVal, NeEventSchSList) = NeEventSchSList .
  eq purge(T, NzTDelay, Bitsg, BitVal, nil) = nil .
  eq purge(T, NzTDelay, Bitsg, BitVal, ({scheduledEvent: time T', args {sgName Bitsg, value BitVal}} EventSchSList)) = 
    ({scheduledEvent: time T', args {sgName Bitsg, value BitVal}} purge(T, NzTDelay, Bitsg, BitVal, EventSchSList)) .
  eq purge(T, NzTDelay, Bitsg, BitVal, ({scheduledEvent: time T', args {sgName Bitsg2, value BitVal2}} EventSchSList)) = 
    if (timeVal(T) < timeVal(T')) == val(true) and (timeVal(T') <= (timeVal(T) + timeVal(NzTDelay))) == val(true) then
      purge(T, NzTDelay, Bitsg, BitVal, EventSchSList)
    else
      ({scheduledEvent: time T', args {sgName Bitsg2, value BitVal2}} purge(T, NzTDelay, Bitsg, BitVal, EventSchSList))
    fi .
  *** TODO: Check if this can be converted to unconditional eq
  ceq purge(T, NzTDelay, Bitsg, BitVal, ({scheduledEvent: time T', args {sgName Bitsg2, value BitVal2}} EventSchSList)) = 
    ({scheduledEvent: time T', args {sgName Bitsg2, value BitVal2}} purge(T, NzTDelay, Bitsg, BitVal, EventSchSList)) if Bitsg =/= Bitsg2 .
  eq purge(T, NzTDelay, Bitsg, BitVal, ({scheduledEvent: time T', args {sgName Bitsg2, value BitVal2}} EventSchSList)) = 
        ({scheduledEvent: time T', args {sgName Bitsg2, value BitVal2}} purge(T, NzTDelay, Bitsg, BitVal, EventSchSList)) [owise] .
  
*** TODO: Should this be an evalF??? -> If so, the val equality condition would have to be raised to rl level 
*** TODO: NOTE: (actually not a TODO) Changed NeEventSchSList to EventSchSList
  op purge : Time Time StdlSignalName StdlVal List{Transaction<=} -> List{Transaction<=} .
  eq purge(T, 0 ns, Stdlsg, StdlVal, EventSchSList) = EventSchSList .
  eq purge(T, NzTDelay, Stdlsg, StdlVal, nil) = nil .
  *** Same sg val
  eq purge(T, NzTDelay, Stdlsg, StdlVal, ({scheduledEvent: time T', args {sgName Stdlsg, value StdlVal}} EventSchSList)) = 
    ({scheduledEvent: time T', args {sgName Stdlsg, value StdlVal}} purge(T, NzTDelay, Stdlsg, StdlVal, EventSchSList)) .
  ***ceq purge(T, NzTDelay, Stdlsg, StdlVal, ({scheduledEvent: time T', args {sgName Stdlsg2, value StdlVal2}} EventSchSList)) = 
  ***  ({scheduledEvent: time T', args {sgName Stdlsg2, value StdlVal2}} purge(T, NzTDelay, Stdlsg, StdlVal, EventSchSList)) ---if Stdlsg =/= Stdlsg2 .
  eq purge(T, NzTDelay, Stdlsg, StdlVal, ({scheduledEvent: time T', args {sgName Stdlsg2, value StdlVal2}} EventSchSList)) = 
    if (timeVal(T) < timeVal(T')) == val(true) and (timeVal(T') <= (timeVal(T) + timeVal(NzTDelay))) == val(true) then
      purge(T, NzTDelay, Stdlsg, StdlVal, EventSchSList)
    else
      ({scheduledEvent: time T', args {sgName Stdlsg2, value StdlVal2}} purge(T, NzTDelay, Stdlsg, StdlVal, EventSchSList))
    fi .
  eq purge(T, NzTDelay, Stdlsg, StdlVal, ({scheduledEvent: time T', args {sgName Stdlsg2, value StdlVal2}} EventSchSList)) = 
        ({scheduledEvent: time T', args {sgName Stdlsg2, value StdlVal2}} purge(T, NzTDelay, Stdlsg, StdlVal, EventSchSList)) [owise] .

  op purge : Time Time BSignalName BVal List{Transaction<=} -> List{Transaction<=} .
  eq purge(T, 0 ns, Bsg, BVal, NeEventSchSList) = NeEventSchSList .
  eq purge(T, NzTDelay, Bsg, BVal, nil) = nil .
  eq purge(T, NzTDelay, Bsg, BVal, ({scheduledEvent: time T', args {sgName Bsg, value BVal}} EventSchSList)) = 
    ({scheduledEvent: time T', args {sgName Bsg, value BVal}} purge(T, NzTDelay, Bsg, BVal, EventSchSList)) .
  eq purge(T, NzTDelay, Bsg, BVal, ({scheduledEvent: time T', args {sgName Bsg2, value BVal2}} EventSchSList)) = 
    if (timeVal(T) < timeVal(T')) == val(true) and (timeVal(T') <= (timeVal(T) + timeVal(NzTDelay))) == val(true) then
      purge(T, NzTDelay, Bsg, BVal, EventSchSList)
    else
      ({scheduledEvent: time T', args {sgName Bsg2, value BVal2}} purge(T, NzTDelay, Bsg, BVal, EventSchSList))
    fi .
  *** TODO: Check if this can be converted to unconditional eq
  ceq purge(T, NzTDelay, Bsg, BVal, ({scheduledEvent: time T', args {sgName Bsg2, value BVal2}} EventSchSList)) = 
    ({scheduledEvent: time T', args {sgName Bsg2, value BVal2}} purge(T, NzTDelay, Bsg, BVal, EventSchSList)) if Bsg =/= Bsg2 .
  eq purge(T, NzTDelay, Bsg, BVal, ({scheduledEvent: time T', args {sgName Bsg2, value BVal2}} EventSchSList)) = 
        ({scheduledEvent: time T', args {sgName Bsg2, value BVal2}} purge(T, NzTDelay, Bsg, BVal, EventSchSList)) [owise] .
  
  *** Get ordered list of events affect a signal (discard values which are exactly the same)
  *** Only get the events in the interval (T, T + Tdelay)
  op getEventLForSg : Time Time StdlSignalName StdlVal List{Transaction<=} -> List{Transaction<=} .
  eq getEventLForSg(T, NzTDelay, Stdlsg, StdlVal, nil) = nil .
  eq getEventLForSg(T, NzTDelay, Stdlsg, StdlVal, ({scheduledEvent: time T', args {sgName Stdlsg, value StdlVal}} EventSchSList)) =
        getEventLForSg(T, NzTDelay, Stdlsg, StdlVal, EventSchSList) .
  ceq getEventLForSg(T, NzTDelay, Stdlsg, StdlVal, ({scheduledEvent: time T', args {sgName Stdlsg, value StdlVal2}} EventSchSList)) =
        {scheduledEvent: time T', args {sgName Stdlsg, value StdlVal2}} getEventLForSg(T, NzTDelay, Stdlsg, StdlVal, EventSchSList)
      if (timeVal(T) < timeVal(T')) == val(true) and (timeVal(T') <= (timeVal(T) + timeVal(NzTDelay))) == val(true) .
  eq getEventLForSg(T, NzTDelay, Stdlsg, StdlVal, ({scheduledEvent: time T', args {sgName Stdlsg2, value StdlVal2}}) EventSchSList) =
        getEventLForSg(T, NzTDelay, Stdlsg, StdlVal, EventSchSList) [owise] .

