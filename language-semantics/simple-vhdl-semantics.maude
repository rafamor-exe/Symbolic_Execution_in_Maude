  ***--------------------------
  *** VERIFICATION
  ***--------------------------
  *** verify-sg: auxilar op to verify signal types on instructions
  op verify-sg : List{IOType} SignalWrapper SgDescStore -> Bool [ctor] .
  eq verify-sg(IOType IOTypeL, SignalW, SgDescSTR) = (IOType == get-sgIOtype(SgDescSTR[SignalW]) or verify-sg(IOTypeL, SignalW, SgDescSTR)) .
  eq verify-sg(IOTypeL, SignalW, SgDescSTR) = false [owise] .
  
  *** verify-typeVal : auxiliary op to verify value types
  ***op verify-typeVal : Type Value -> Bool [ctor] .
  ***eq verify-typeVal(bool, BVal) = true .
  ***eq verify-typeVal(bit, BitVal) = true .
  ***eq verify-typeVal('std_logic, StdlVal) = true .
  ******eq verify-typeVal(natural, NVal) = true .
  ***eq verify-typeVal(integer, IVal) = true .
  ***eq verify-typeVal(time, TVal) = true .
  ******eq verify-typeVal(positive, PosVal) = true .
  ***eq verify-typeVal(Type, Val) = false [owise] .

  *** verify-typeAssignment : auxiliary op to verify has correct type in signal assignment
  ***op verify-typeAssignment : SignalName AExp SgDescStore -> Bool .
  ***ceq verify-typeAssignment(SignalW, AExp1, SgDescSTR) = 
  ***    verify-typeAExp(Type, AExp1, SgDescSTR) 
  ***  if {IOType $ Type} := SgDescSTR[SignalW] .
  ***eq verify-typeAssignment(SignalW, AExp1, SgDescSTR) = false [owise] .
