  ***eq verify-typeAExp(Type, abs(AExp1), SgDescSTR) = verify-typeAExp(Type, AExp1, SgDescSTR) .
  ***eq verify-typeAExp(Type, AExp1 and AExp2, SgDescSTR) = verify-typeAExp(Type, AExp1, SgDescSTR) and verify-typeAExp(Type, AExp2, SgDescSTR) .
  ***eq verify-typeAExp(Type, AExp1 or AExp2, SgDescSTR) = verify-typeAExp(Type, AExp1, SgDescSTR) and verify-typeAExp(Type, AExp2, SgDescSTR) .
  ***eq verify-typeAExp(Type, AExp1 xor AExp2, SgDescSTR) = verify-typeAExp(Type, AExp1, SgDescSTR) and verify-typeAExp(Type, AExp2, SgDescSTR) .
***
  ***eq verify-typeAExp(Type, AExp1 + AExp2, SgDescSTR) = verify-typeAExp(Type, AExp1, SgDescSTR) and verify-typeAExp(Type, AExp2, SgDescSTR) .
  ***eq verify-typeAExp(Type, AExp1 - AExp2, SgDescSTR) = verify-typeAExp(Type, AExp1, SgDescSTR) and verify-typeAExp(Type, AExp2, SgDescSTR) .
  ***eq verify-typeAExp(IntT, AExp1 * AExp2, SgDescSTR) = verify-typeAExp(IntT, AExp1, SgDescSTR) and verify-typeAExp(IntT, AExp2, SgDescSTR) .
  ***eq verify-typeAExp(PhysT, AExp1 * AExp2, SgDescSTR) = (verify-typeAExp(integer, AExp1, SgDescSTR) and verify-typeAExp(PhysT, AExp2, SgDescSTR))
  ***                                                   or (verify-typeAExp(PhysT, AExp1, SgDescSTR) and verify-typeAExp(integer, AExp2, SgDescSTR)) .
  ***eq verify-typeAExp(IntT, AExp1 / AExp2, SgDescSTR) = verify-typeAExp(IntT, AExp1, SgDescSTR) and verify-typeAExp(IntT, AExp2, SgDescSTR) .
  ***eq verify-typeAExp(PhysT, AExp1 / AExp2, SgDescSTR) = verify-typeAExp(PhysT, AExp1, SgDescSTR) and verify-typeAExp(integer, AExp2, SgDescSTR) .
  ***eq verify-typeAExp(PhysT, AExp1 / AExp2, SgDescSTR) = verify-typeAExp(PhysT, AExp1, SgDescSTR) and verify-typeAExp(PhysT, AExp2, SgDescSTR) .
  ***eq verify-typeAExp(IntT, AExp1 rem AExp2, SgDescSTR) = verify-typeAExp(IntT, AExp1, SgDescSTR) and verify-typeAExp(IntT, AExp2, SgDescSTR) .
  ***eq verify-typeAExp(IntT, AExp1 mod AExp2, SgDescSTR) = verify-typeAExp(IntT, AExp1, SgDescSTR) and verify-typeAExp(IntT, AExp2, SgDescSTR) .
  ***eq verify-typeAExp(PhysT, AExp1 rem AExp2, SgDescSTR) = verify-typeAExp(PhysT, AExp1, SgDescSTR) and verify-typeAExp(PhysT, AExp2, SgDescSTR) .
  ***eq verify-typeAExp(PhysT, AExp1 mod AExp2, SgDescSTR) = verify-typeAExp(PhysT, AExp1, SgDescSTR) and verify-typeAExp(PhysT, AExp2, SgDescSTR) .
  ***eq verify-typeAExp(IntT, AExp1 ** AExp2, SgDescSTR) = verify-typeAExp(IntT, AExp1, SgDescSTR) and verify-typeAExp(integer, AExp2, SgDescSTR) .
  ****** For the case of comparison operators, signals have and values at each side shall have the same value
  ***eq verify-typeAExp(bool, AExp1 CompOp AExp2, SgDescSTR) = verify-sameType(AExp1, AExp2, SgDescSTR) .
***
  ***op verify-sameType : AExp AExp SgDescStore -> Bool .
  ***eq verify-sameType(AExp1, AExp2, SgDescSTR) = (verify-typeAExp(bit, AExp1, SgDescSTR) and verify-typeAExp(bit, AExp2, SgDescSTR))
  ***                                           or (verify-typeAExp('std_logic, AExp1, SgDescSTR) and verify-typeAExp('std_logic, AExp2, SgDescSTR))
  ***                                           or (verify-typeAExp(integer, AExp1, SgDescSTR) and verify-typeAExp(integer, AExp2, SgDescSTR))
  ***                                           or (verify-typeAExp(bool, AExp1, SgDescSTR) and verify-typeAExp(bool, AExp2, SgDescSTR))
  ***                                           or (verify-typeAExp(time, AExp1, SgDescSTR) and verify-typeAExp(time, AExp2, SgDescSTR))
  ***                                           or (verify-typeAExp(natural, AExp1, SgDescSTR) and verify-typeAExp(natural, AExp2, SgDescSTR)) .
***
  *** verify-typeBlock : auxiliary op to type-check instructions in an internal instruction list
  op verify-typeBlock : List{Inst;} -> Bool .
  eq verify-typeBlock(IL) = true .
  ***eq verify-typeBlock(IL) = verify-parseValid(parse(IL)) .

  op verify-parseValid : Parser -> Bool .
  eq verify-parseValid([ nil -> SchList ] StoresVar) = true .
  eq verify-parseValid([ IL -> SchList ] StoresVar) = false [owise] .

  *** verify if-elsif-else statement
  op verify-typeElsifSt : ElsifStatement -> Bool .
  eq verify-typeElsifSt(null) = true .
  eq verify-typeElsifSt(elsif BVal then IL) = verify-typeBlock(IL) .
  eq verify-typeElsifSt(elsif BVal then IL ElsifSt) = verify-typeBlock(IL) and verify-typeElsifSt(ElsifSt) .

  op verify-typeElseSt : ElseStatement -> Bool .
  eq verify-typeElseSt(null) = true .
  eq verify-typeElsifSt(else IL) = verify-typeBlock(IL) .


  op getStdlSTR : Stores -> StdlTStore .
  eq getStdlSTR(BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR) = StdlSgSTR .


  *** FIXME: TODO: How to handle signal references depending on time. Should the pair (signalName,Time) be the whole reference?
  ***              If so, how do we mark it on each expression on the rules. Expression evaluation now depends on time too, but we should not mark it on the syntax a priori  
  *** evaluation functions for expressions at a certain time
  *** FIXME: This is not usable!!! 
  op cieval : IExp Time VHDLCompleteSim -> Int [metadata "evalF"] .
  eq cieval(Isg, T, VHDLCompleteSim) = cieval({sgName Isg, time T}, VHDLCompleteSim) .
  eq cieval(IVal, T, VHDLCompleteSim) = cieval(IVal, VHDLCompleteSim) .
  eq cieval(- IExp1, T, VHDLCompleteSim) = - cieval(IExp1, T, VHDLCompleteSim) .
  eq cieval(IExp1 + IExp2, T, VHDLCompleteSim) = cieval(IExp1, T, VHDLCompleteSim) + cieval(IExp2, T, VHDLCompleteSim) .
  eq cieval(IExp1 - IExp2, T, VHDLCompleteSim) = cieval(IExp1, T, VHDLCompleteSim) - cieval(IExp2, T, VHDLCompleteSim) .

  op cbeval : BExp Time VHDLCompleteSim -> Bool [metadata "evalF"] .
  eq cbeval(Bsg, T, VHDLCompleteSim) = cbeval({sgName Bsg, time T}, VHDLCompleteSim) .
  eq cbeval(val(B:Bool), T, VHDLCompleteSim) = cbeval(val(B:Bool), VHDLCompleteSim) .
  eq cbeval(BExp1 /\ BExp2, T, VHDLCompleteSim) = cbeval(BExp1, T, VHDLCompleteSim) and cbeval(BExp2, T, VHDLCompleteSim) .
  eq cbeval(not BExp, T, VHDLCompleteSim) = not cbeval(BExp, T, VHDLCompleteSim) .    
  eq cbeval(IExp1 > IExp2, T, VHDLCompleteSim) = cieval(IExp1, T, VHDLCompleteSim) > cieval(IExp2, T, VHDLCompleteSim) .
  eq cbeval(BitV1 < BitV2, T, VHDLCompleteSim) = cstdleval(BitV1, T, VHDLCompleteSim) < cstdleval(BitV2, T, VHDLCompleteSim) .
  eq cbeval(BitV1 <= BitV2, T, VHDLCompleteSim) = cstdleval(BitV1, T, VHDLCompleteSim) <= cstdleval(BitV2, T, VHDLCompleteSim) .
  eq cbeval(BitV1 > BitV2, T, VHDLCompleteSim) = cstdleval(BitV1, T, VHDLCompleteSim) > cstdleval(BitV2, T, VHDLCompleteSim) .
  eq cbeval(BitV1 >= BitV2, T, VHDLCompleteSim) = cstdleval(BitV1, T, VHDLCompleteSim) >= cstdleval(BitV2, T, VHDLCompleteSim) .
  eq cbeval(StdlExp1 = StdlExp2, T, VHDLCompleteSim) = cstdleval(StdlExp1, T, VHDLCompleteSim) = cstdleval(StdlExp2, T, VHDLCompleteSim) .
  eq cbeval(StdlExp1 /= StdlExp2, T, VHDLCompleteSim) = cstdleval(StdlExp1, T, VHDLCompleteSim) /= cstdleval(StdlExp2, T, VHDLCompleteSim) .

  op cstdleval : StdlExp Time VHDLCompleteSim -> Stdl [metadata "evalF"] .
  eq cstdleval(Bitsg, T, VHDLCompleteSim) = cstdleval({sgName Bitsg, time T}, VHDLCompleteSim) .
  eq cstdleval(Stdlsg, T, VHDLCompleteSim) = cstdleval({sgName Stdlsg, time T}, VHDLCompleteSim) .
  eq cstdleval(StdlVal, T, VHDLCompleteSim) = cstdleval(StdlVal, VHDLCompleteSim).
  eq cstdleval(StdlExp1 and StdlExp2, T, VHDLCompleteSim) = cstdleval(StdlExp1, T, VHDLCompleteSim) and cstdleval(StdlExp2, T, VHDLCompleteSim) .
  eq cstdleval(StdlExp1 or StdlExp2, T, VHDLCompleteSim) = cstdleval(StdlExp1, T, VHDLCompleteSim) or cstdleval(StdlExp2, T, VHDLCompleteSim) .
  eq cstdleval(StdlExp1 xor StdlExp2, T, VHDLCompleteSim) = cstdleval(StdlExp1, T, VHDLCompleteSim) xor cstdleval(StdlExp2, T, VHDLCompleteSim) .
  eq cstdleval(not StdlExp, T, VHDLCompleteSim) = not cstdleval(StdlExp, T, VHDLCompleteSim) .
  eq cstdleval(StdlExp1 nand StdlExp2, T, VHDLCompleteSim) = cstdleval(StdlExp1, T, VHDLCompleteSim) nand cstdleval(StdlExp2, T, VHDLCompleteSim) .
  eq cstdleval(StdlExp1 nor StdlExp2, T, VHDLCompleteSim) = cstdleval(StdlExp1, T, VHDLCompleteSim) nor cstdleval(StdlExp2, T, VHDLCompleteSim) .
  eq cstdleval(StdlExp1 xnor StdlExp2, T, VHDLCompleteSim) = cstdleval(StdlExp1, T, VHDLCompleteSim) xnor cstdleval(StdlExp2, T, VHDLCompleteSim) .


  eq iresolve({sgName Isg, time T}, < Clk | nil >< SchList || EventSchSList > << (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim) = 
    ISgSTR[{sgName Isg, time T}] .
  ***eq bitresolve({sgName Bitsg, time T}, < Clk | nil >< SchList || EventSchSList > << (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim) = 
  ***  BitSgSTR[{sgName Bitsg, time T}] .
  eq stdlresolve({sgName Stdlsg, time T}, < Clk | nil >< SchList || EventSchSList > << (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim) = 
    StdlSgSTR[{sgName Stdlsg, time T}] .
  eq bresolve({sgName Bsg, time T}, < Clk | nil >< SchList || EventSchSList > << (BitSgSTR | ISgSTR | StdlSgSTR | BSgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim) = 
    BSgSTR[{sgName Bsg, time T}] .

endm

