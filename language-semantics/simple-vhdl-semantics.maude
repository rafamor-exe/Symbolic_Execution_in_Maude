  ***crl [parse-assign-sg-val] : [ (SignalW <= DelayMech AExp1 after Tdelay) ; IL -> SchList ] << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > 
  ***                          => 
  ***                          [ IL -> SchList {scheduledInst: time 0 ns, inst (SignalW <= DelayMech AExp1 after Tdelay) ;} ] << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > 
  ***                          if verify-sg(out inout, SignalW, SgDescSTR) and verify-typeAssignment(SignalW, AExp1, SgDescSTR) .
  
  ***crl [parse-if-then] : [(if BVal then IL ElsifSt ElseSt EndIf) ; IL -> SchList ] 
  ***                      =>
  ***                      [IL -> SchList ]
  ***                      if verify-typeBlock(IL) and verify-typeElsifSt(ElsifSt) and verify-typeElseSt(ElseSt) .

  *** assign-sg-val : assign a value to a signal after solving all AExp and signal lookups
  ***rl [Iassign-sg-val-sch] : < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time T, inst (Isg <=| DelayMech IExp after Tdelay) ;}  SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
  ***                    => 
  ***                    if Tdelay == (0 ns) then
  ***                      *** assignment is not delayed
  ***                      < clk(T) [prev: clk(Tprev)] | nil >< SchList || EventSchSList > << insert({sgName Isg, time T + delta}, correctVal(cieval(IExp, T, SgSTR), SignalW, lookup-sg(SgSTR, {sgName Isg, time T + delta})), SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(SignalW,  (sg-val-changed(correctVal(cieval(IExp, T, SgSTR), SignalW, lookup-sg(SgSTR, {sgName Isg, time T + delta})), SignalW, T, SgSTR)), SgChangedMap) } {wholeExec: SchListCp} InputChangeSim
  ***                    else
  ***                      if DelayMech == transport or (DelayMech == inertial and isStable(T, Tdelay, SignalW, cieval(IExp, T, SgSTR), EventSchSList)) then
  ***                        *** inertial delay without inestability is equivalent to transport delay
  ***                        < clk(T) [prev: clk(Tprev)] | nil >< SchList || sort({scheduledEvent: time get-time(timeVal(T) + timeVal(Tdelay)), args {sgName Isg, value cieval(IExp, T, SgSTR)}} EventSchSList) > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
  ***                      else
  ***                        *** Inertial delay correcting inestability
  ***                        < clk(T) [prev: clk(Tprev)] | nil >< SchList || sort({scheduledEvent: time get-time(timeVal(T) + timeVal(Tdelay)), args {sgName Isg, value cieval(IExp, T, SgSTR)}} purge(T, Tdelay, SignalW, cieval(IExp, T, SgSTR), EventSchSList)) > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
  ***                      fi
  ***                    fi .
  
  ***rl [Bitassign-sg-val-sch] : < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time T, inst (SignalW <=| DelayMech AExp1 after Tdelay) ;}  SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
  ***                    => 
  ***                    if Tdelay == (0 ns) then
  ***                      *** assignment is not delayed
  ***                      < clk(T) [prev: clk(Tprev)] | nil >< SchList || EventSchSList > << insert({sgName SignalW, time T + delta}, correctVal(evalA(AExp1, T, SgSTR), SignalW, lookup-sg(SgSTR, {sgName SignalW, time T + delta})), SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(SignalW,  (sg-val-changed(correctVal(evalA(AExp1, T, SgSTR), SignalW, lookup-sg(SgSTR, {sgName SignalW, time T + delta})), SignalW, T, SgSTR)), SgChangedMap) } {wholeExec: SchListCp} InputChangeSim
  ***                    else
  ***                      if DelayMech == transport or (DelayMech == inertial and isStable(T, Tdelay, SignalW, evalA(AExp1, T, SgSTR), EventSchSList)) then
  ***                        *** inertial delay without inestability is equivalent to transport delay
  ***                        < clk(T) [prev: clk(Tprev)] | nil >< SchList || sort({scheduledEvent: time get-time(timeVal(T) + timeVal(Tdelay)), args {sgName SignalW, value evalA(AExp1, T, SgSTR)}} EventSchSList) > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
  ***                      else
  ***                        *** Inertial delay correcting inestability
  ***                        < clk(T) [prev: clk(Tprev)] | nil >< SchList || sort({scheduledEvent: time get-time(timeVal(T) + timeVal(Tdelay)), args {sgName SignalW, value evalA(AExp1, T, SgSTR)}} purge(T, Tdelay, SignalW, evalA(AExp1, T, SgSTR), EventSchSList)) > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
  ***                      fi
  ***                    fi .
  
  ***TODO: How to manage internal conditions like isStable symbolically?
  ***rl [Stdlassign-sg-val-sch] : < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time T, inst (Stdlsg <=| DelayMech StdlExp after Tdelay) ;}  SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
  ***                    => 
